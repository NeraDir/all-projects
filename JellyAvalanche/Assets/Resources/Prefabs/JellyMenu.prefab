  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "In this exciting game, you take on the role of a sorting master! Conveyor
    belts with colorful candies are in front of you, along with jars that have matching
    colored lids. Your task is to carefully plan the order of placing the jars to
    collect candies strictly from the front of each conveyor. If candies remain on
    the conveyor and you can't move your jars anymore, a 5-second countdown begins,
    and you lose.\r                                              \n\nLuckily, you
    have some helpful tools: the ability to return a jar to its place or completely
    restart the level. Use your logic, speed, and attention to detail to overcome
    all challenges!              "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e21d9fa883341484f8393b51730ca170, type: 2}
