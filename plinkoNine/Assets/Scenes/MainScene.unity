  m_text: "Welcome to the DIAMOND SPHERE app \u2014 your personal guide to the world
    of exquisite cuisine and unique service!\r\n\r\nWith our app you can:\r\n\r\n-
    Book a table or dome: Enjoy the atmosphere of coziness and luxury, choosing the
    perfect place for your dinner. The user-friendly interface will allow you to
    quickly and easily book a table for any time.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 47757b9b83dbeda4999e134612dca392, type: 2}
  m_sharedMaterial: {fileID: -1068728934947603107, guid: 47757b9b83dbeda4999e134612dca392, type: 2}
