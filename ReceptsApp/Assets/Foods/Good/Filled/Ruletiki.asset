  m_Script: {fileID: 11500000, guid: 562d1bc0912893a4d86469389a774a85, type: 3}
  m_Name: Ruletiki
  m_EditorClassIdentifier: 
  Foodlabel: "\u0421\u043B\u043E\u0451\u043D\u043D\u044B\u0435 \u0440\u0443\u043B\u0435\u0442\u0438\u043A\u0438
    \u0441 \u0432\u0435\u0442\u0447\u0438\u043D\u043E\u0439, \u0441\u044B\u0440\u043E\u043C
    \u0438 \u0447\u0435\u0441\u043D\u043E\u043A\u043E\u043C "
  FoodDescription: 
  FoodIngridients: "<br>\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
    <br>   \u2022\u0422\u0435\u0441\u0442\u043E \u0441\u043B\u043E\u0451\u043D\u043D\u043E\u0435
    \u0431\u0435\u0437 \u0434\u0440\u043E\u0436\u0436\u0435\u0432\u043E\u0435 \u2013
    280 \u0433 <br>   \u2022\u0412\u0435\u0442\u0447\u0438\u043D\u0430 \u2013 150
    \u0433 <br>   \u2022\u0421\u044B\u0440 \u0442\u0432\u0451\u0440\u0434\u044B\u0439
    \u2013 150 \u0433 <br>   \u2022\u041F\u0435\u0442\u0440\u0443\u0448\u043A\u0430
    \u0441\u0432\u0435\u0436\u0430\u044F \u2013 25 \u0433 <br>   \u2022\u041C\u0430\u0441\u043B\u043E
    \u0441\u043B\u0438\u0432\u043E\u0447\u043D\u043E\u0435 \u2013 30 \u0433 <br>  
    \u2022\u0427\u0435\u0441\u043D\u043E\u043A \u2013 3 \u0437\u0443\u0431\u0447\u0438\u043A\u0430
    <br>   \u2022\u0421\u043E\u043B\u044C \u2013 1 \u0449\u0435\u043F\u043E\u0442\u043A\u0443
    (\u043F\u043E \u0432\u043A\u0443\u0441\u0443) <br>   \u2022\u0416\u0435\u043B\u0442\u043E\u043A
    \u2013 1 \u0448\u0442"
  FoodHowToCoock: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
    <br>   \u2022\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435
    \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B. <br>\u0421\u043B\u043E\u0451\u043D\u043E\u0435
    \u0442\u0435\u0441\u0442\u043E \u0440\u0430\u0437\u043C\u043E\u0440\u043E\u0437\u044C\u0442\u0435
    \u0437\u0430\u0440\u0430\u043D\u0435\u0435 (\u044F \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E
    \u0435\u0433\u043E \u043D\u0430 \u043D\u043E\u0447\u044C \u0432 \u0432\u0435\u0440\u0445\u043D\u0435\u0439
    \u043A\u0430\u043C\u0435\u0440\u0435 \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A\u0430).
    <br>\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0434\u0443\u0445\u043E\u0432\u043A\u0443,
    \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u0430 \u0440\u0430\u0437\u043E\u0433\u0440\u0435\u0432\u0430\u043B\u0430\u0441\u044C
    \u0434\u043E 180 \u0433\u0440\u0430\u0434\u0443\u0441\u043E\u0432. <br>   \u2022\u0421\u044B\u0440
    \u043D\u0430\u0442\u0440\u0438\u0442\u0435 \u043D\u0430 \u043A\u0440\u0443\u043F\u043D\u043E\u0439
    \u0442\u0451\u0440\u043A\u0435. \u0412\u0435\u0442\u0447\u0438\u043D\u0443 \u043C\u0435\u043B\u043A\u043E
    \u043D\u0430\u0440\u0435\u0436\u044C\u0442\u0435. <br>   \u2022\u0420\u0430\u0441\u0442\u043E\u043F\u0438\u0442\u0435
    \u0441\u043B\u0438\u0432\u043E\u0447\u043D\u043E\u0435 \u043C\u0430\u0441\u043B\u043E.
    <br>\u041C\u0435\u043B\u043A\u043E \u043D\u0430\u0440\u0435\u0436\u044C\u0442\u0435
    \u0437\u0435\u043B\u0435\u043D\u044C \u043F\u0435\u0442\u0440\u0443\u0448\u043A\u0438.
    <br>\u041E\u0447\u0438\u0441\u0442\u0438\u0442\u0435 \u0438 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435
    \u0447\u0435\u0440\u0435\u0437 \u043F\u0440\u0435\u0441\u0441 \u0447\u0435\u0441\u043D\u043E\u043A.
    <br>   \u2022\u0412 \u0440\u0430\u0441\u0442\u043E\u043F\u043B\u0435\u043D\u043D\u043E\u0435
    \u043C\u0430\u0441\u043B\u043E \u0434\u043E\u0431\u0430\u0432\u044C\u0442\u0435
    \u043F\u0435\u0442\u0440\u0443\u0448\u043A\u0443, \u0447\u0435\u0441\u043D\u043E\u043A
    \u0438 \u0441\u043E\u043B\u044C. \u0422\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0432\u0441\u0451 \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0439\u0442\u0435.
    <br>   \u2022\u041E\u0442\u0440\u0435\u0436\u044C\u0442\u0435 \u043B\u0438\u0441\u0442
    \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0430 \u043F\u043E \u0440\u0430\u0437\u043C\u0435\u0440\u0443
    \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u044F - 35\u044530 \u0441\u043C. \u041D\u0430
    \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442 \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u0435
    \u0440\u0430\u0437\u043C\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u043E\u0435
    \u0442\u0435\u0441\u0442\u043E \u0438 \u0440\u0430\u0441\u043A\u0430\u0442\u0430\u0439\u0442\u0435
    \u0435\u0433\u043E \u0432 \u043F\u043B\u0430\u0441\u0442 \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C
    \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E 22\u044527 \u0441\u043C, \u0434\u043E
    \u0442\u043E\u043B\u0449\u0438\u043D\u044B \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
    3 \u043C\u043C. <br>   \u2022\u0421\u043C\u0430\u0436\u044C\u0442\u0435 \u0432\u0441\u0451
    \u0442\u0435\u0441\u0442\u043E \u0447\u0435\u0441\u043D\u043E\u0447\u043D\u044B\u043C
    \u043C\u0430\u0441\u043B\u043E\u043C \u0441 \u0437\u0435\u043B\u0435\u043D\u044C\u044E,
    \u043E\u0441\u0442\u0430\u0432\u0438\u0432 \u0441 \u043E\u0434\u043D\u043E\u0439
    \u0438\u0437 \u0434\u043B\u0438\u043D\u043D\u044B\u0445 \u0441\u0442\u043E\u0440\u043E\u043D
    \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0439 \u043A\u0440\u0430\u0439
    (1-2 \u0441\u043C). <br>   \u2022\u041F\u043E\u0432\u0435\u0440\u0445 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u0435
    \u043D\u0430\u0440\u0435\u0437\u0430\u043D\u043D\u0443\u044E \u0432\u0435\u0442\u0447\u0438\u043D\u0443.
    <br>   \u2022\u0420\u0430\u0432\u043D\u043E\u043C\u0435\u0440\u043D\u043E \u043F\u043E\u0441\u044B\u043F\u044C\u0442\u0435
    \u043D\u0430\u0442\u0451\u0440\u0442\u044B\u043C \u0441\u044B\u0440\u043E\u043C.
    <br>\u041B\u0430\u0434\u043E\u043D\u044F\u043C\u0438 \u043F\u0440\u0438\u0436\u043C\u0438\u0442\u0435
    \u043D\u0430\u0447\u0438\u043D\u043A\u0443 \u043A \u0442\u0435\u0441\u0442\u0443.
    <br>   \u2022\u0421\u0432\u0435\u0440\u043D\u0438\u0442\u0435 \u043F\u043B\u043E\u0442\u043D\u044B\u0439
    \u0440\u0443\u043B\u0435\u0442 \u0432 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438
    \u043A \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u043C\u0443 \u043A\u0440\u0430\u044E
    \u0442\u0435\u0441\u0442\u0430. <br>   \u2022\u0420\u0430\u0437\u0440\u0435\u0436\u044C\u0442\u0435
    \u0440\u0443\u043B\u0435\u0442 \u043D\u0430 \u0448\u0430\u0439\u0431\u043E\u0447\u043A\u0438
    \u0448\u0438\u0440\u0438\u043D\u043E\u0439 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
    2-3 \u0441\u043C. <br>   \u2022\u0420\u0443\u043B\u0435\u0442\u0438\u043A\u0438
    \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u043E\u043C
    \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0438\u0442\u0435 \u043D\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u0435\u043D\u044C
    \u0438 \u0440\u0430\u0437\u043B\u043E\u0436\u0438\u0442\u0435 \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438
    \u0434\u0440\u0443\u0433 \u043E\u0442 \u0434\u0440\u0443\u0433\u0430. <br>  
    \u2022\u0421\u043C\u0430\u0436\u044C\u0442\u0435 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C
    \u0442\u0435\u0441\u0442\u0430 \u0436\u0435\u043B\u0442\u043A\u043E\u043C, \u0441\u0442\u0430\u0440\u0430\u044F\u0441\u044C
    \u043D\u0435 \u0437\u0430\u0434\u0435\u0442\u044C \u043D\u0430\u0447\u0438\u043D\u043A\u0443.
    <br>   \u2022\u0415\u0441\u043B\u0438 \u0443 \u0432\u0430\u0441 \u0440\u0443\u043B\u0435\u0442\u0438\u043A\u0438
    \u0442\u043E\u043D\u043A\u0438\u0435 \u0438 \u043D\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E \u0441\u0442\u043E\u044F\u0442
    \u043D\u0430 \u0431\u043E\u043A\u0443, \u043B\u0443\u0447\u0448\u0435 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C
    \u0438\u0445 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F\u043C\u0438
    \u0432\u043D\u0438\u0437 (\u043A\u0430\u043A \u0441\u0434\u0435\u043B\u0430\u043B\u0430
    \u044F). <br>\u041F\u043E\u043C\u0435\u0441\u0442\u0438\u0442\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u0435\u043D\u044C
    \u0432 \u0440\u0430\u0437\u043E\u0433\u0440\u0435\u0442\u0443\u044E \u0434\u043E
    180 \u0433\u0440\u0430\u0434\u0443\u0441\u043E\u0432 \u0434\u0443\u0445\u043E\u0432\u043A\u0443
    \u0438 \u0432\u044B\u043F\u0435\u043A\u0430\u0439\u0442\u0435 \u0440\u0443\u043B\u0435\u0442\u0438\u043A\u0438
    25-30 \u043C\u0438\u043D\u0443\u0442, \u0434\u043E \u0437\u043E\u043B\u043E\u0442\u0438\u0441\u0442\u043E\u0433\u043E
    \u0446\u0432\u0435\u0442\u0430. <br>   \u2022\u0413\u043E\u0442\u043E\u0432\u044B\u0435
    \u0441\u043B\u043E\u0451\u043D\u044B\u0435 \u0440\u0443\u043B\u0435\u0442\u0438\u043A\u0438
    \u0441 \u0432\u0435\u0442\u0447\u0438\u043D\u043E\u0439, \u0441\u044B\u0440\u043E\u043C
    \u0438 \u0447\u0435\u0441\u043D\u043E\u043A\u043E\u043C \u043E\u0442\u0434\u0435\u043B\u0438\u0442\u0435
    \u043E\u0442 \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0430 \u0438
    \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u0435 \u043D\u0430 \u0442\u0430\u0440\u0435\u043B\u043A\u0443.
    <br>\u041F\u043E\u0434\u0430\u0432\u0430\u0442\u044C \u0438\u0445 \u043B\u0443\u0447\u0448\u0435
    \u0441 \u043A\u0435\u0442\u0447\u0443\u043F\u043E\u043C \u0438\u043B\u0438 \u0434\u0440\u0443\u0433\u0438\u043C
    \u0441\u043E\u0443\u0441\u043E\u043C. \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E
    \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430!!!"
