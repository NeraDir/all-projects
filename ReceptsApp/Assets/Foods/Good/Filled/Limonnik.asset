  m_Name: Limonnik
  m_EditorClassIdentifier: 
  Foodlabel: "\u041D\u0430\u043F\u0438\u0442\u043E\u043A \u043B\u0438\u043C\u043E\u043D\u043D\u0438\u043A "
  FoodDescription: 
  FoodIngridients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
    <br>   \u2022\u041B\u0438\u043C\u043E\u043D - 1 \u0448\u0442. <br>   \u2022\u0421\u0430\u0445\u0430\u0440
    - 2 \u0441\u0442.\u043B. <br>   \u2022\u0412\u043E\u0434\u0430 \u043A\u0438\u043F\u044F\u0447\u0435\u043D\u0430\u044F
    - 2 \u043B\u0438\u0442\u0440\u0430 "
  FoodHowToCoock: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
    <br>   \u2022\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0432\u0441\u043A\u0438\u043F\u044F\u0442\u0438\u043C
    \u0432\u043E\u0434\u0443 \u0438 \u0434\u0430\u0434\u0438\u043C \u0435\u0439 \u043E\u0441\u0442\u044B\u0442\u044C
    \u0434\u043E \u043A\u043E\u043C\u043D\u0430\u0442\u043D\u043E\u0439 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u044B.
    \u041D\u0430\u043C \u043D\u0430\u0434\u043E, \u0447\u0442\u043E\u0431\u044B \u0432\u043E\u0434\u0438\u0447\u043A\u0430
    \u0431\u044B\u043B\u0430 \u0442\u0435\u043F\u043B\u0435\u043D\u044C\u043A\u043E\u0439,
    \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0441\u044F
    \u0441\u0430\u0445\u0430\u0440. \u0415\u0441\u043B\u0438 \u043C\u044B \u043B\u0438\u043C\u043E\u043D
    \u0437\u0430\u043B\u044C\u0435\u043C \u0433\u043E\u0440\u044F\u0447\u0435\u0439
    \u0432\u043E\u0434\u043E\u0439, \u0442\u043E \u043E\u043D \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u0442
    \u0432\u0441\u0435 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0435 \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430.
    <br>   \u2022\u0417\u0430\u0442\u0435\u043C \u0431\u0435\u0440\u0435\u043C \u043B\u0438\u043C\u043E\u043D,
    \u043F\u043E\u043C\u043E\u0435\u043C \u0435\u0433\u043E \u0438 \u043D\u043E\u0436\u043E\u043C
    \u043D\u0430 \u0434\u043E\u0449\u0435\u0447\u043A\u0435 \u0440\u0430\u0437\u0440\u0435\u0436\u0435\u043C
    \u043D\u0430 \u0447\u0435\u0442\u044B\u0440\u0435 \u0447\u0430\u0441\u0442\u0438.
    <br>   \u2022\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u043C \u043B\u0438\u043C\u043E\u043D
    \u0432 \u0431\u043B\u0435\u043D\u0434\u0435\u0440 \u0438 \u0434\u043E\u0431\u0430\u0432\u0438\u043C
    \u0441\u0430\u0445\u0430\u0440. <br>   \u2022\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043C
    \u0431\u043B\u0435\u043D\u0434\u0435\u0440 \u043D\u0430 \u0431\u043B\u043E\u043A
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F \u0438 \u0438\u0437\u043C\u0435\u043B\u044C\u0447\u0438\u043C
    \u043B\u0438\u043C\u043E\u043D. \u0415\u0441\u043B\u0438 \u0443 \u0432\u0430\u0441
    \u043D\u0435\u0442 \u0441\u0442\u0430\u0446\u0438\u043E\u043D\u0430\u0440\u043D\u043E\u0433\u043E
    \u0431\u043B\u0435\u043D\u0434\u0435\u0440\u0430, \u0442\u043E \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435\u0441\u044C
    \u0440\u0443\u0447\u043D\u044B\u043C. <br>   \u2022\u041D\u0430\u043B\u0435\u0439\u0442\u0435
    \u0442\u0435\u043F\u043B\u0443\u044E \u043A\u0438\u043F\u044F\u0447\u0435\u043D\u0443\u044E
    \u0432\u043E\u0434\u0443 \u0432 \u0431\u043B\u0435\u043D\u0434\u0435\u0440, \u0432\u0441\u0435
    \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0439\u0442\u0435,
    \u0447\u0442\u043E\u0431\u044B \u0441\u0430\u0445\u0430\u0440 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
    \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0441\u044F, \u0437\u0430\u043A\u0440\u043E\u0439\u0442\u0435
    \u0447\u0430\u0448\u0443 \u043A\u0440\u044B\u0448\u043A\u043E\u0439 \u0438 \u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435
    \u043D\u0430\u043F\u0438\u0442\u043E\u043A \xAB\u041B\u0438\u043C\u043E\u043D\u043D\u0438\u043A\xBB
    \u043D\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u043D\u0430
    1-2 \u0447\u0430\u0441\u0430. <br>   \u2022\u0417\u0430\u0442\u0435\u043C \u0447\u0435\u0440\u0435\u0437
    \u0441\u0438\u0442\u043E \u043F\u0435\u0440\u0435\u043B\u0435\u0439\u0442\u0435
    \u043D\u0430\u043F\u0438\u0442\u043E\u043A \xAB\u041B\u0438\u043C\u043E\u043D\u043D\u0438\u043A\xBB
    \u0432 \u0433\u0440\u0430\u0444\u0438\u043D \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u044C\u0442\u0435
    \u043E\u0445\u043B\u0430\u0436\u0434\u0430\u0442\u044C\u0441\u044F \u0432 \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A.
    \u0421\u0438\u0442\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E,
    \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C
    \u043C\u044F\u043A\u043E\u0442\u044C \u0438 \u043A\u043E\u0440\u043A\u0438 \u043B\u0438\u043C\u043E\u043D\u0430.
    \u041D\u043E \u0435\u0441\u043B\u0438 \u0432\u044B \u043B\u044E\u0431\u0438\u0442\u0435
    \u043F\u043E\u0436\u0435\u0432\u0430\u0442\u044C \u043B\u0438\u043C\u043E\u043D,
    \u0442\u043E \u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u0438\u0442\u043E \u043D\u0435
    \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C. "
