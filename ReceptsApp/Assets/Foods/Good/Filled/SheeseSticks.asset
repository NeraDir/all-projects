  m_Name: SheeseSticks
  m_EditorClassIdentifier: 
  Foodlabel: "\u0417\u0430\u043A\u0443\u0441\u043E\u0447\u043D\u044B\u0435 \u0440\u0443\u043B\u0435\u0442\u0438\u043A\u0438
    \u0441 \u0441\u044B\u0440\u043E\u043C"
  FoodDescription: 
  FoodIngridients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
    <br>   \u2022\u0420\u0438\u043A\u043E\u0442\u0442\u0430  \u2014 150 \u0413\u0440\u0430\u043C\u043C 
    <br>   \u2022\u0411\u0440\u044B\u043D\u0437\u0430  \u2014 100 \u0413\u0440\u0430\u043C\u043C 
    <br>   \u2022\u041A\u043B\u044E\u043A\u0432\u0430 \u0432\u044F\u043B\u0435\u043D\u0430\u044F 
    \u2014 3 \u0421\u0442. \u043B\u043E\u0436\u043A\u0438  <br>   \u2022\u041F\u0435\u0442\u0440\u0443\u0448\u043A\u0430
    \u0441\u0432\u0435\u0436\u0430\u044F  \u2014 \u041F\u0443\u0447\u043E\u043A (\u043D\u0435\u043C\u043D\u043E\u0433\u043E) 
    <br>   \u2022\u041B\u0430\u0432\u0430\u0448 \u0442\u043E\u043D\u043A\u0438\u0439 
    \u2014 1 \u0428\u0442\u0443\u043A\u0430  "
  FoodHowToCoock: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
    <br>   \u2022\u041F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435
    \u0432\u0441\u0435 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B. 
    <br>   \u2022\u0420\u0438\u043A\u043E\u0442\u0442\u0443 \u0440\u0430\u0437\u043E\u043C\u043D\u0438\u0442\u0435
    \u0432\u0438\u043B\u043A\u043E\u0439 \u0441 \u0431\u0440\u044B\u043D\u0437\u043E\u0439. 
    <br>   \u2022\u0414\u043E\u0431\u0430\u0432\u044C\u0442\u0435 \u0440\u0443\u0431\u043B\u0435\u043D\u043D\u0443\u044E
    \u0437\u0435\u043B\u0435\u043D\u044C \u0438 \u043D\u0430\u0440\u0435\u0437\u0430\u043D\u043D\u0443\u044E
    \u043A\u0443\u0441\u043E\u0447\u043A\u0430\u043C\u0438 \u0432\u044F\u043B\u0435\u043D\u0443\u044E
    \u043A\u043B\u044E\u043A\u0432\u0443. \u041C\u0430\u0441\u0441\u0443 \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0439\u0442\u0435.  <br>   \u2022\u041D\u0430
    \u043B\u0430\u0432\u0430\u0448 \u0440\u043E\u0432\u043D\u044B\u043C \u0441\u043B\u043E\u0435\u043C
    \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u0435 \u0441\u044B\u0440\u043D\u0443\u044E
    \u043C\u0430\u0441\u0441\u0443.  <br>   \u2022\u0421\u0432\u0435\u0440\u043D\u0438\u0442\u0435
    \u0432 \u0440\u0443\u043B\u0435\u0442. \u041B\u0438\u0448\u043D\u0438\u0439 \u043B\u0430\u0432\u0430\u0448
    \u043E\u0442\u0440\u0435\u0436\u044C\u0442\u0435.  <br>   \u2022\u041D\u0430\u0440\u0435\u0436\u044C\u0442\u0435
    \u0440\u0443\u043B\u0435\u0442 \u043F\u043E\u0440\u0446\u0438\u043E\u043D\u043D\u044B\u043C\u0438
    \u043A\u0443\u0441\u043E\u0447\u043A\u0430\u043C\u0438 1-1,5 \u0441\u043C. \u0412\u044B\u043B\u043E\u0436\u0438\u0442\u0435
    \u0437\u0430\u043A\u0443\u0441\u043A\u0443 \u0432 \u0432\u0438\u0434\u0435 \u0435\u043B\u043E\u0447\u043A\u0438,
    \u0443\u043A\u0440\u0430\u0441\u044C\u0442\u0435 \u0437\u0435\u0440\u043D\u0430\u043C\u0438
    \u0433\u0440\u0430\u043D\u0430\u0442\u0430 \u0438 \u0432\u0435\u0442\u043E\u0447\u043A\u0430\u043C\u0438
    \u0443\u043A\u0440\u043E\u043F\u0430, \u0438 \u043F\u043E\u0434\u0430\u0432\u0430\u0439\u0442\u0435
    \u043A \u0441\u0442\u043E\u043B\u0443. \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E
    \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430!!! "
