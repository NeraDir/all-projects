  m_Script: {fileID: 11500000, guid: 562d1bc0912893a4d86469389a774a85, type: 3}
  m_Name: "\u0410\u0432\u0442\u043E\u0440\u0441\u043A\u0438\u0439 \u0431\u0443\u0440\u0433\u0435\u0440"
  m_EditorClassIdentifier: 
  Foodlabel: "\u0410\u0432\u0442\u043E\u0440\u0441\u043A\u0438\u0439 \u0431\u0443\u0440\u0433\u0435\u0440"
  FoodDescription: 
  FoodIngridients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>    
    <br>   \u2022\u0424\u0430\u0440\u0448 \u0433\u043E\u0432\u044F\u0436\u0438\u0439
    \u2013 250\u0433 <br>   \u2022\u0421\u044B\u0440 \u2013 22\u0433 <br>   \u2022\u0411\u0443\u043B\u043E\u0447\u043A\u0430
    \u2013 2\u0448\u0442 <br>   \u2022\u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434
    \u2013 30\u0433 <br>   \u2022\u041B\u0438\u0441\u0442\u044C\u044F \u0441\u0430\u043B\u0430\u0442\u0430,
    \u043F\u043E\u043C\u0438\u0434\u043E\u0440\u044B, \u043E\u0433\u0443\u0440\u0435\u0446
    \u2013 \u043F\u043E \u0432\u043A\u0443\u0441\u0443 <br>   \u2022\u041C\u0430\u0439\u043E\u043D\u0435\u0437
    \u2013 \u043F\u043E \u0432\u043A\u0443\u0441\u0443 <br>   \u2022\u0413\u043E\u0440\u0447\u0438\u0446\u0430
    \u2013 1 \u0447.\u043B <br>   \u2022\u041A\u043E\u043F\u0447\u0435\u043D\u0430\u044F
    \u043F\u0430\u043F\u0440\u0438\u043A\u0430 \u2013 1 \u0447.\u043B <br>   \u2022\u0421\u043E\u043B\u044C
    , \u043F\u0435\u0440\u0435\u0446, \u043B\u0438\u043C\u043E\u043D\u043D\u044B\u0439
    \u0441\u043E\u043A \u2013 \u043F\u043E \u0432\u043A\u0443\u0441\u0443 <br>  
    \u2022\u041A\u0435\u0442\u0447\u0443\u043F \u2013 2 \u0441\u0442.\u043B"
  FoodHowToCoock: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
    <br>   \u2022\u0413\u043E\u0442\u043E\u0432\u0438\u043C \u0441\u043E\u0443\u0441:\u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u043C
    3 \u0441\u0442. \u043B. \u043C\u0430\u0439\u043E\u043D\u0435\u0437\u0430, 1 \u0447.
    \u043B. \u0433\u043E\u0440\u0447\u0438\u0446\u044B \u0438 \u043A\u043E\u043F\u0447\u0435\u043D\u043E\u0439
    \u043F\u0430\u043F\u0440\u0438\u043A\u0438, \u043F\u0430\u0440\u0443 \u043A\u0430\u043F\u0435\u043B\u044C
    \u043B\u0438\u043C\u043E\u043D\u043D\u043E\u0433\u043E \u0441\u043E\u043A\u0430
    \u0438 \u0441\u043E\u043B\u044C \u043F\u0435\u0440\u0435\u0446 \u043F\u043E \u0432\u043A\u0443\u0441\u0443.
    <br>   \u2022\u0414\u043B\u044F \u043A\u043E\u0442\u043B\u0435\u0442\u044B: \u0431\u0435\u0440\u0451\u043C
    \u0433\u043E\u0432\u044F\u0436\u0438\u0439 \u0444\u0430\u0440\u0448, \u0441\u043E\u043B\u044C,
    \u043F\u0435\u0440\u0435\u0446, \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u0435\u043C
    \u0438\u0445. <br>   \u2022\u0420\u0430\u0437\u0440\u0435\u0437\u0430\u0435\u043C
    \u0431\u0443\u043B\u043E\u0447\u043A\u0438 \u0438 \u043F\u043E\u0434\u0436\u0430\u0440\u0438\u0432\u0430\u0435\u043C
    \u0438\u0445 \u043D\u0430 \u0441\u043B\u0438\u0432\u043E\u0447\u043D\u043E\u043C
    \u043C\u0430\u0441\u043B\u0435. <br>   \u2022\u0416\u0430\u0440\u0438\u043C \u043A\u043E\u0442\u043B\u0435\u0442\u0443,
    \u043A\u043B\u0430\u0434\u0451\u043C \u0441\u0432\u0435\u0440\u0445\u0443 \u0441\u044B\u0440
    \u0438 \u043D\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u043C \u043A\u0440\u044B\u0448\u043A\u043E\u0439
    \u043D\u0430 10 \u043C\u0438\u043D\u0443\u0442. <br>   \u2022\u0421\u043B\u0430\u0439\u0441\u0430\u043C\u0438
    \u043D\u0430\u0440\u0435\u0437\u0430\u0435\u043C \u0432\u0438\u043D\u043E\u0433\u0440\u0430\u0434,
    \u043F\u043E\u043C\u0438\u0434\u043E\u0440, \u043E\u0433\u0443\u0440\u0435\u0446.
    <br>   \u2022\u0421\u043E\u0431\u0438\u0440\u0430\u0435\u043C \u0431\u0443\u0440\u0433\u0435\u0440:\u0411\u0443\u043B\u043E\u0447\u043A\u0430,
    \u043B\u0438\u0441\u0442 \u0441\u0430\u043B\u0430\u0442\u0430, \u0441\u043E\u0443\u0441,
    \u043A\u043E\u0442\u043B\u0435\u0442\u0430, \u043F\u043E\u043C\u0438\u0434\u043E\u0440,
    \u043E\u0433\u0443\u0440\u0435\u0446, \u0432\u0438\u043D\u043E\u0433\u0440\u0430\u0434.
    \u041D\u0430 \u0432\u0435\u0440\u0445\u043D\u044E\u044E \u0431\u0443\u043B\u043E\u0447\u043A\u0443
    \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u043C \u043A\u0435\u0442\u0447\u0443\u043F,
    \u043D\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u043C. \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E
    \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430!!! "
  FoodImage: {fileID: 21300000, guid: 43c7e33be3354ac42bfa8c1ecf71e35d, type: 3}
