  m_Script: {fileID: 11500000, guid: 562d1bc0912893a4d86469389a774a85, type: 3}
  m_Name: "\u0421\u0430\u043B\u0430\u0442 \u043A\u0440\u0430\u0431\u043E\u0432\u044B\u0439.
    \u0410\u0432\u0442\u043E\u0440\u0441\u043A\u0438\u0439"
  m_EditorClassIdentifier: 
  Foodlabel: "\u0421\u0430\u043B\u0430\u0442 \u043A\u0440\u0430\u0431\u043E\u0432\u044B\u0439.
    \u0410\u0432\u0442\u043E\u0440\u0441\u043A\u0438\u0439"
  FoodDescription: 
  FoodIngridients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>    
    <br>   \u2022\u041A\u0440\u0430\u0431\u043E\u0432\u044B\u0435 \u043F\u0430\u043B\u043E\u0447\u043A\u0438
    \u2013 100\u0433 <br>   \u2022\u041A\u0443\u043A\u0443\u0440\u0443\u0437\u0430
    \u2013 1 \u0431\u0430\u043D\u043A\u0430 <br>   \u2022\u041E\u0433\u0443\u0440\u0435\u0446
    \u2013 1\u0448\u0442 <br>   \u2022\u042F\u0439\u0446\u043E \u2013 3\u0448\u0442
    <br>   \u2022\u0421\u0435\u043B\u044C\u0434\u0435\u0440\u0435\u0439 \u2013 3
    \u0441\u0442\u0435\u0431\u043B\u044F <br>   \u2022\u041C\u043E\u0440\u0441\u043A\u043E\u0439
    \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C \u2013 170\u0433 <br>   \u2022\u041B\u0443\u043A
    \u2013 \xBD  <br>   \u2022\u0417\u0435\u043B\u0435\u043D\u044C \u2013 \u043F\u043E
    \u0432\u043A\u0443\u0441\u0443 <br>   \u2022\u0421\u043E\u043B\u044C \u2013 \u043F\u043E
    \u0432\u043A\u0443\u0441\u0443  <br>   \u2022\u041C\u0430\u0439\u043E\u043D\u0435\u0437
    \u2013 \u043F\u043E \u0432\u043A\u0443\u0441\u0443 "
  FoodHowToCoock: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
    <br>   \u2022\u041F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432\u0430\u0440\u0438\u0442\u044C
    3 \u044F\u0439\u0446\u0430, \u043F\u043E\u043A\u0430 \u044F\u0439\u0446\u0430
    \u0432\u0430\u0440\u044F\u0442\u0441\u044F \u0434\u0435\u043B\u0430\u0435\u043C
    \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435: 1 \u043F\u0430\u0447\u043A\u0443
    \u043A\u0440\u0430\u0431\u043E\u0432\u044B\u0445 \u043F\u0430\u043B\u043E\u0447\u0435\u043A,
    1 \u043E\u0433\u0443\u0440\u0435\u0446, 3 \u0441\u0442\u0435\u0431\u043B\u044F
    \u0441\u0435\u043B\u044C\u0434\u0435\u0440\u0435\u044F \u043D\u0430\u0440\u0435\u0437\u0430\u0442\u044C
    \u043A\u0443\u0431\u0438\u043A\u0430\u043C\u0438, 1 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043A\u0443
    \u043B\u0443\u043A\u0430 \u043C\u0435\u043B\u043A\u043E \u043D\u0430\u0448\u0438\u043D\u043A\u043E\u0432\u0430\u0442\u044C
    <br>   \u2022170\u0433 \u043C\u043E\u0440\u0441\u043A\u043E\u0433\u043E \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044F
    (\u043B\u0443\u0447\u0448\u0435 \u0432 \u0440\u0430\u0441\u0441\u043E\u043B\u0435)
    \u043E\u0442\u043A\u0438\u0434\u044B\u0432\u0430\u0435\u043C \u043D\u0430 \u0434\u0443\u0440\u0448\u043B\u0430\u0433,
    \u043F\u043E\u043A\u0430 \u0440\u0430\u0441\u0441\u043E\u043B \u0441\u0442\u0435\u043A\u0430\u0435\u0442
    \u043D\u0430\u0434\u043E \u043D\u0430\u0440\u0443\u0431\u0438\u0442\u044C \u0437\u0435\u043B\u0435\u043D\u044C."
  FoodImage: {fileID: 21300000, guid: 8025413b092515343a3ab3a80845e32c, type: 3}
