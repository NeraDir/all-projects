  m_Script: {fileID: 11500000, guid: 562d1bc0912893a4d86469389a774a85, type: 3}
  m_Name: "\u0413\u043E\u0440\u044F\u0447\u0438\u0435 \u0431\u0443\u0442\u0435\u0440\u0431\u0440\u043E\u0434\u044B"
  m_EditorClassIdentifier: 
  Foodlabel: "\u0413\u043E\u0440\u044F\u0447\u0438\u0435 \u0431\u0443\u0442\u0435\u0440\u0431\u0440\u043E\u0434\u044B "
  FoodDescription: 
  FoodIngridients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>    
    <br>   \u20228 \u043B\u043E\u043C\u0442\u0438\u043A\u043E\u0432 \u0445\u043B\u0435\u0431\u0430;
    <br>   \u202280 \u0433 \u0441\u044B\u0440\u0430; <br>   \u202280 \u0433 \u043A\u043E\u043B\u0431\u0430\u0441\u044B;
    <br>   \u20224 \u044F\u0439\u0446\u0430; <br>   \u2022\u0441\u043E\u043B\u044C
    \u0438 \u043F\u0435\u0440\u0435\u0446 \u043F\u043E \u0432\u043A\u0443\u0441\u0443. "
  FoodHowToCoock: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
    <br>   \u2022\u0414\u043B\u044F \u043D\u0430\u0447\u0438\u043D\u043A\u0438 \u043D\u0430\u0440\u0435\u0437\u0430\u0435\u043C
    \u043A\u043E\u043B\u0431\u0430\u0441\u0443 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438
    \u043A\u0443\u0441\u043E\u0447\u043A\u0430\u043C\u0438, \u0441\u044B\u0440 \u043D\u0430\u0442\u0438\u0440\u0430\u0435\u043C
    \u043D\u0430 \u043A\u0440\u0443\u043F\u043D\u043E\u0439 \u0442\u0435\u0440\u043A\u0435.
    <br>   \u2022\u041D\u0430 \u043E\u0434\u0438\u043D \u0431\u0443\u0442\u0435\u0440\u0431\u0440\u043E\u0434
    \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F 2 \u043B\u043E\u043C\u0442\u0438\u043A\u0430
    \u0445\u043B\u0435\u0431\u0430, \u0432 \u043E\u0434\u043D\u043E\u043C \u0438\u0437
    \u043D\u0438\u0445 \u0432\u044B\u0440\u0435\u0437\u0430\u0435\u043C \u043A\u0440\u0443\u0436\u043E\u043A
    \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0441\u0442\u0430\u043A\u0430\u043D\u0430.
    <br>   \u2022\u041D\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u0435\u043D\u044C
    \u043A\u043B\u0430\u0434\u0435\u043C \u0446\u0435\u043B\u044B\u0435 \u043B\u043E\u043C\u0442\u0438\u043A\u0438
    \u0445\u043B\u0435\u0431\u0430, \u0430 \u0441\u0432\u0435\u0440\u0445\u0443 \u043B\u043E\u043C\u0442\u0438\u043A\u0438
    \u0441 \u0432\u044B\u0440\u0435\u0437\u0430\u043D\u043D\u044B\u043C\u0438 \u043A\u0440\u0443\u0436\u043E\u0447\u043A\u0430\u043C\u0438.
    <br>   \u2022\u0412 \u043A\u0440\u0443\u0436\u043E\u0447\u043A\u0438 \u043F\u043E\u043C\u0435\u0449\u0430\u0435\u043C
    \u043A\u0443\u0441\u043E\u0447\u043A\u0438 \u043A\u043E\u043B\u0431\u0430\u0441\u044B,
    \u043D\u0430 \u0445\u043B\u0435\u0431 \u2014 \u0442\u0435\u0440\u0442\u044B\u0439
    \u0441\u044B\u0440, \u0430 \u0432 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u043A\u0443
    \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u043C
    \u044F\u0439\u0446\u043E."
  FoodImage: {fileID: 21300000, guid: 03327070618f5a044a009a95fd8cf34a, type: 3}
