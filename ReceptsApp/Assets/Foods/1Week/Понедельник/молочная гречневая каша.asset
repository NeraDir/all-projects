  m_Script: {fileID: 11500000, guid: 562d1bc0912893a4d86469389a774a85, type: 3}
  m_Name: "\u043C\u043E\u043B\u043E\u0447\u043D\u0430\u044F \u0433\u0440\u0435\u0447\u043D\u0435\u0432\u0430\u044F
    \u043A\u0430\u0448\u0430"
  m_EditorClassIdentifier: 
  Foodlabel: "\u043C\u043E\u043B\u043E\u0447\u043D\u0430\u044F \u0433\u0440\u0435\u0447\u043D\u0435\u0432\u0430\u044F
    \u043A\u0430\u0448\u0430"
  FoodDescription: 
  FoodIngridients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>    
    <br>   \u2022\u0433\u0440\u0435\u0447\u043D\u0435\u0432\u0430\u044F \u043A\u0440\u0443\u043F\u0430
    \u2013 350\u0433 <br>   \u2022\u0432\u043E\u0434\u0430 \u2013 4 \u0441\u0442\u0430\u043A\u0430\u043D\u0430
    <br>   \u2022\u043C\u043E\u043B\u043E\u043A\u043E \u2013 2 \u0441\u0442\u0430\u043A\u0430\u043D\u0430
    <br>   \u2022\u0441\u043B\u0438\u0432\u043A\u0438 \u2013 1.5 \u0441\u0442\u0430\u043A\u0430\u043D\u0430
    <br>   \u2022\u0441\u0430\u0445\u0430\u0440 \u2013 2 \u0441\u0442.\u043B <br>  
    \u2022\u0441\u043E\u043B\u044C \u2013 1/3 \u0441\u0442.\u043B <br>   \u2022\u0441\u043B\u0438\u0432\u043E\u0447\u043D\u043E\u0435
    \u043C\u0430\u0441\u043B\u043E \u2013 \u043F\u043E \u0432\u043A\u0443\u0441\u0443"
  FoodHowToCoock: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
    <br>   \u2022\u0413\u0440\u0435\u0447\u043D\u0435\u0432\u0443\u044E \u043A\u0440\u0443\u043F\u0443
    \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u0440\u043E\u043C\u044B\u0432\u0430\u0435\u043C,
    \u0437\u0430\u0441\u044B\u043F\u0430\u0435\u043C \u0432 \u043A\u0430\u0441\u0442\u0440\u044E\u043B\u044E
    \u0441 \u043A\u0438\u043F\u044F\u0449\u0435\u0439 \u0432\u043E\u0434\u043E\u0439,
    \u0432\u0441\u044B\u043F\u0430\u0435\u043C \u0441\u043E\u043B\u044C \u0438 \u0432\u0430\u0440\u0438\u043C
    20 \u043C\u0438\u043D\u0443\u0442. <br>   \u2022\u041C\u043E\u043B\u043E\u043A\u043E
    \u043A\u0438\u043F\u044F\u0442\u0438\u043C, \u0430 \u0437\u0430\u0442\u0435\u043C
    \u0432\u043B\u0438\u0432\u0430\u0435\u043C \u0432\u043C\u0435\u0441\u0442\u0435
    \u0441\u043E \u0441\u043B\u0438\u0432\u043A\u0430\u043C\u0438 \u0441 \u043A\u0430\u0441\u0442\u0440\u044E\u043B\u044E
    \u0441 \u0433\u0440\u0435\u0447\u043A\u043E\u0439, \u0432\u0430\u0440\u0438\u043C
    \u0435\u0449\u0435 10 \u043C\u0438\u043D\u0443\u0442. <br>   \u2022\u0412 \u043A\u043E\u043D\u0446\u0435
    \u0432\u0430\u0440\u043A\u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u043C
    \u0441\u0430\u0445\u0430\u0440. \u041F\u0440\u0438 \u043F\u043E\u0434\u0430\u0447\u0435
    \u043A\u043B\u0430\u0434\u0435\u043C \u043F\u043E \u0432\u043A\u0443\u0441\u0443
    \u0441\u043B\u0438\u0432\u043E\u0447\u043D\u043E\u0435 \u043C\u0430\u0441\u043B\u043E."
  FoodImage: {fileID: 21300000, guid: ad950ff1a512d1a4da77c929f809def5, type: 3}
