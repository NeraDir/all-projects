  m_Script: {fileID: 11500000, guid: 562d1bc0912893a4d86469389a774a85, type: 3}
  m_Name: "\u041C\u044F\u0441\u043E \u043F\u043E \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u0438
    \u0441 \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u0435\u043C"
  m_EditorClassIdentifier: 
  Foodlabel: "\u041C\u044F\u0441\u043E \u043F\u043E \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u0438
    \u0441 \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u0435\u043C"
  FoodDescription: 
  FoodIngridients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>    
    <br>   \u2022\u0421\u0432\u0438\u043D\u0438\u043D\u0430 \u2013 500 \u0433  <br>  
    \u2022\u041A\u0440\u0443\u043F\u043D\u0430\u044F \u043B\u0443\u043A\u043E\u0432\u0438\u0446\u0430
    \u2013 3 \u0448\u0442  <br>   \u2022\u041A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044C
    \u2013 1\u043A\u0433 <br>   \u2022\u0421\u044B\u0440 \u2013 200-2500 \u0433 <br>  
    \u2022\u0420\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
    \u043C\u0430\u0441\u043B\u043E \u2013 \u043F\u043E \u0432\u043A\u0443\u0441\u0443 
    <br>   \u2022\u041C\u0430\u0439\u043E\u043D\u0435\u0437 \u2013 \u043F\u043E \u0432\u043A\u0443\u0441\u0443
    <br>   \u2022\u0421\u043E\u043B\u044C \u2013 \u043F\u043E \u0432\u043A\u0443\u0441\u0443 
    <br>   \u2022\u0421\u043E\u043B\u044C \u2013 \u043F\u043E \u0432\u043A\u0443\u0441\u0443"
  FoodHowToCoock: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
    <br>   \u2022\u041A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044C \u0447\u0438\u0441\u0442\u0438\u043C,
    \u0440\u0435\u0436\u0435\u043C \u043D\u0430 \u0442\u043E\u043D\u043A\u0438\u0435
    \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u044B \u0438 \u0443\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u043C
    \u043D\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u0435\u043D\u044C, \u0441\u043C\u0430\u0437\u0430\u043D\u043D\u044B\u0439
    \u043C\u0430\u0441\u043B\u043E\u043C.   <br>   \u2022\u041B\u0443\u043A \u0447\u0438\u0441\u0442\u0438\u043C,
    \u043D\u0430\u0440\u0435\u0437\u0430\u0435\u043C \u0442\u043E\u043D\u043A\u0438\u043C\u0438
    \u043A\u043E\u043B\u044C\u0446\u0430\u043C\u0438 \u0438 \u0440\u0430\u0432\u043D\u043E\u043C\u0435\u0440\u043D\u043E
    \u0443\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u043C \u043F\u043E\u0432\u0435\u0440\u0445
    \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044F. \u0421\u043E\u043B\u0438\u043C,
    \u043F\u0435\u0440\u0447\u0438\u043C.  <br>   \u2022\u041C\u044F\u0441\u043E
    \u043D\u0430\u0440\u0435\u0437\u0430\u0435\u043C \u043A\u0443\u0431\u0438\u043A\u0430\u043C\u0438
    \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
    2 \u043D\u0430 2 \u0441\u043C, \u043C\u043E\u0436\u043D\u043E \u0447\u0443\u0442\u044C
    \u043A\u0440\u0443\u043F\u043D\u0435\u0435. \u0412\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u043C
    \u043D\u0430 \u043E\u0432\u043E\u0449\u0438, \u0435\u0449\u0435 \u0440\u0430\u0437
    \u0441\u043E\u043B\u0438\u043C, \u043F\u0435\u0440\u0447\u0438\u043C.  <br>  
    \u2022\u0429\u0435\u0434\u0440\u043E \u043F\u043E\u043B\u0438\u0432\u0430\u0435\u043C
    \u043C\u044F\u0441\u043E \u043C\u0430\u0439\u043E\u043D\u0435\u0437\u043E\u043C.  
    <br>   \u2022\u0418, \u043D\u0430\u043A\u043E\u043D\u0435\u0446, \u043E\u0431\u0438\u043B\u044C\u043D\u043E
    \u043F\u043E\u0441\u044B\u043F\u0430\u0435\u043C \u0431\u043B\u044E\u0434\u043E
    \u0442\u0435\u0440\u0442\u044B\u043C \u0441\u044B\u0440\u043E\u043C.  <br>  
    \u2022\u0421\u0442\u0430\u0432\u0438\u043C \u043F\u0440\u043E\u0442\u0438\u0432\u0435\u043D\u044C
    \u0432 \u0434\u0443\u0445\u043E\u0432\u043A\u0443, \u0440\u0430\u0437\u043E\u0433\u0440\u0435\u0442\u0443\u044E
    \u0434\u043E 180 \u0433\u0440\u0430\u0434\u0443\u0441\u043E\u0432, \u0438 \u0437\u0430\u043F\u0435\u043A\u0430\u0435\u043C
    \u0434\u043E \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u0438 - \u0432
    \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442
    \u0434\u0443\u0445\u043E\u0432\u043A\u0438 \u0438 \u0432\u0435\u043B\u0438\u0447\u0438\u043D\u044B
    \u043D\u0430\u0440\u0435\u0437\u043A\u0438, \u044D\u0442\u043E \u043C\u043E\u0436\u0435\u0442
    \u0437\u0430\u043D\u044F\u0442\u044C \u043E\u0442 45 \u043C\u0438\u043D\u0443\u0442
    \u0434\u043E 1 \u0447\u0430\u0441\u0430. \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E
    \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430!!!  "
