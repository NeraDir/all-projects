  m_Script: {fileID: 11500000, guid: 562d1bc0912893a4d86469389a774a85, type: 3}
  m_Name: "\u0421\u0432\u0438\u043D\u0438\u043D\u0430 \u0432 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u0432\u044B\u043C
    \u0441\u043E\u0443\u0441\u0435"
  m_EditorClassIdentifier: 
  Foodlabel: "\u0421\u0432\u0438\u043D\u0438\u043D\u0430 \u0432 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u0432\u044B\u043C
    \u0441\u043E\u0443\u0441\u0435"
  FoodDescription: 
  FoodIngridients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>    
    <br>   \u2022\u0421\u0432\u0438\u043D\u0438\u043D\u0430 \u2013 300 \u0433 <br>  
    \u2022\u041B\u0443\u043A \u2013 \xBD \u0448\u0442 <br>   \u2022\u0413\u0440\u0430\u043D\u0430\u0442\u043E\u0432\u044B\u0439
    \u0441\u043E\u043A \u2013 2 \u0441\u0442. \u043B <br>   \u2022\u041F\u043E\u0434\u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0435
    \u043C\u0430\u0441\u043B\u043E \u2013 1 \u0441\u0442. \u043B"
  FoodHowToCoock: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
    <br>   \u2022\u041C\u0435\u043B\u043A\u043E \u043D\u0430\u0440\u0435\u0436\u044C\u0442\u0435
    \u0441\u0432\u0438\u043D\u0438\u043D\u0443 \u2014 \u0442\u0430\u043A \u043E\u043D\u0430
    \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u0441\u044F.
    \u041E\u0431\u0436\u0430\u0440\u044C\u0442\u0435 \u0435\u0451 \u043D\u0430 \u043C\u0430\u0441\u043B\u0435
    \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043B\u0443\u043A\u043E\u043C \u0434\u043E
    \u043F\u043E\u043B\u0443\u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u0438. 
    <br>   \u2022\u0414\u043E\u0431\u0430\u0432\u044C\u0442\u0435 \u0432 \u0441\u043A\u043E\u0432\u043E\u0440\u043E\u0434\u0443
    \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u0432\u044B\u0439 \u0441\u043E\u0443\u0441
    \u0438 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0432\u043E\u0434\u044B, \u0447\u0442\u043E\u0431\u044B
    \u043C\u044F\u0441\u043E \u0442\u0443\u0448\u0438\u043B\u043E\u0441\u044C. \u0415\u0441\u043B\u0438
    \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u0432\u044B\u0439 \u0441\u043E\u0443\u0441
    \u0431\u0435\u0437 \u043A\u0438\u0441\u043B\u0438\u043D\u043A\u0438, \u0432\u044B\u0434\u0430\u0432\u0438\u0442\u0435
    \u0432 \u0441\u0432\u0438\u043D\u0438\u043D\u0443 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
    \u043B\u0438\u043C\u043E\u043D\u043D\u043E\u0433\u043E \u0441\u043E\u043A\u0430,
    \u0432\u0430\u0448\u0430 \u0446\u0435\u043B\u044C \u2014 \u0447\u0442\u043E\u0431\u044B
    \u0431\u043B\u044E\u0434\u043E \u0431\u044B\u043B\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u0441\u043B\u0430\u0434\u043A\u0438\u043C, \u0430 \u043A\u0438\u0441\u043B\u043E-\u0441\u043B\u0430\u0434\u043A\u0438\u043C.
    \u0418 \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C\u0442\u0435 \u043F\u043E\u0441\u043E\u043B\u0438\u0442\u044C.
    \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430!!! "
  FoodImage: {fileID: 21300000, guid: aa80ba70b0bd4644eace835d215efa23, type: 3}
