  m_Script: {fileID: 11500000, guid: 562d1bc0912893a4d86469389a774a85, type: 3}
  m_Name: "\u041F\u043E\u043C\u0438\u0434\u043E\u0440\u044B, \u0444\u0430\u0440\u0448\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u0441\u044B\u0440\u043E\u043C \u0438 \u043A\u0440\u0430\u0431\u043E\u0432\u044B\u043C\u0438
    \u043F\u0430\u043B\u043E\u0447\u043A\u0430\u043C\u0438"
  m_EditorClassIdentifier: 
  Foodlabel: "\u041F\u043E\u043C\u0438\u0434\u043E\u0440\u044B, \u0444\u0430\u0440\u0448\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u0441\u044B\u0440\u043E\u043C \u0438 \u043A\u0440\u0430\u0431\u043E\u0432\u044B\u043C\u0438
    \u043F\u0430\u043B\u043E\u0447\u043A\u0430\u043C\u0438"
  FoodDescription: 
  FoodIngridients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>    
    <br>   \u2022\u041F\u043E\u043C\u0438\u0434\u043E\u0440 \u2013 460 \u0433 (3
    \u0448\u0442\u0443\u043A\u0438) <br>   \u2022\u041A\u0440\u0430\u0431\u043E\u0432\u044B\u0435
    \u043F\u0430\u043B\u043E\u0447\u043A\u0438 \u2013 80 \u0433 <br>   \u2022\u0421\u044B\u0440
    \u0442\u0432\u0435\u0440\u0434\u044B\u0439 \u2013 80 \u0433 <br>   \u2022\u042F\u0439\u0446\u043E
    \u043A\u0443\u0440\u0438\u043D\u043E\u0435 \u2013 1 \u0448\u0442. <br>   \u2022\u041C\u0430\u0439\u043E\u043D\u0435\u0437
    \u2013 60 \u0433 <br>   \u2022\u0421\u043F\u0435\u0446\u0438\u0438 \u2013 1 \u0449\u0435\u043F\u043E\u0442\u043A\u0430
    (-\u0438) \u0438\u0442\u0430\u043B\u044C\u044F\u043D\u0441\u043A\u0438\u0435
    \u0442\u0440\u0430\u0432\u044B <br>   \u2022\u0421\u043E\u043B\u044C \u2013 \u043F\u043E
    \u0432\u043A\u0443\u0441\u0443 <br>   \u2022\u041F\u0435\u0440\u0435\u0446 \u0447\u0435\u0440\u043D\u044B\u0439
    \u2013 \u043F\u043E \u0432\u043A\u0443\u0441\u0443 \u043C\u043E\u043B\u043E\u0442\u044B\u0439"
  FoodHowToCoock: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
    <br>   \u2022\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
    \u0432\u0441\u0435 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B.
    \u0427\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
    \u0432 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u043C \u0438\u0442\u043E\u0433\u0435
    \u0432\u043A\u0443\u0441\u043D\u0435\u0439\u0448\u0443\u044E \u0437\u0430\u043A\u0443\u0441\u043A\u0443,
    \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u044C \u043A\u0440\u0430\u0431\u043E\u0432\u044B\u0435
    \u043F\u0430\u043B\u043E\u0447\u043A\u0438 \u0442\u043E\u043B\u044C\u043A\u043E
    \u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F.
    \u041E\u043D\u0438 \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C
    \u0441\u0443\u0445\u0438\u043C\u0438 \u0438 \u043D\u0435 \u0432\u043A\u0443\u0441\u043D\u044B\u043C\u0438.
    \u0416\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u043E, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u043E\u0445\u043B\u0430\u0436\u0434\u0435\u043D\u043D\u044B\u0435 \u043F\u0430\u043B\u043E\u0447\u043A\u0438.
    \u041C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0437\u0430\u043C\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u044B\u0435 \u043F\u0430\u043B\u043E\u0447\u043A\u0438.
    \u0412 \u0442\u0430\u043A\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435 \u043D\u0443\u0436\u043D\u043E
    \u0437\u0430\u0440\u0430\u043D\u0435\u0435 \u0434\u043E\u0441\u0442\u0430\u0442\u044C
    \u0438\u0445 \u0438\u0437 \u043C\u043E\u0440\u043E\u0437\u0438\u043B\u043A\u0438,
    \u043F\u0435\u0440\u0435\u043B\u043E\u0436\u0438\u0442\u044C \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
    \u043E\u0442\u0434\u0435\u043B \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A\u0430
    \u0438 \u0434\u043E\u0436\u0434\u0430\u0442\u044C\u0441\u044F, \u043F\u043E\u043A\u0430
    \u043E\u043D\u0438 \u0440\u0430\u0437\u043C\u043E\u0440\u043E\u0437\u044F\u0442\u0441\u044F.
    <br>   \u2022\u041F\u043E\u043C\u0438\u0434\u043E\u0440\u044B \u043F\u043E\u0434\u043E\u0439\u0434\u0443\u0442
    \u043B\u044E\u0431\u043E\u0433\u043E \u0441\u043E\u0440\u0442\u0430 \u0438 \u0446\u0432\u0435\u0442\u0430.
    \u041E\u043D\u0438 \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C
    \u0441\u043F\u0435\u043B\u044B\u0435 \u0438 \u043F\u043B\u043E\u0442\u043D\u044B\u0435
    \u043D\u0430 \u043E\u0449\u0443\u043F\u044C, \u0441\u0432\u0435\u0436\u0438\u0435,
    \u0431\u0435\u0437 \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u043E\u0432 \u043F\u043E\u0440\u0447\u0438.
    <br>   \u2022\u0422\u0432\u0435\u0440\u0434\u044B\u0439 \u0441\u044B\u0440 \u0432\u044B\u0431\u0440\u0430\u0442\u044C,
    \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u0443\u044F\u0441\u044C \u043D\u0430
    \u0441\u0432\u043E\u0439 \u0432\u043A\u0443\u0441. \u041F\u0440\u0438 \u0436\u0435\u043B\u0430\u043D\u0438\u0438,
    \u043C\u0430\u0439\u043E\u043D\u0435\u0437 \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
    \u0432 \u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445.
    \u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0441\u043F\u0435\u0446\u0438\u0439
    \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043F\u043E
    \u0441\u0432\u043E\u0435\u043C\u0443 \u0432\u043A\u0443\u0441\u0443. <br>   \u2022\u041A\u0440\u0430\u0431\u043E\u0432\u044B\u0435
    \u043F\u0430\u043B\u043E\u0447\u043A\u0438 \u043D\u0430\u0440\u0435\u0437\u0430\u0442\u044C
    \u043C\u0435\u043B\u043A\u0438\u043C\u0438 \u043A\u0443\u0431\u0438\u043A\u0430\u043C\u0438.\u041F\u0435\u0440\u0435\u0441\u044B\u043F\u0430\u0442\u044C
    \u0432 \u0433\u043B\u0443\u0431\u043E\u043A\u0443\u044E \u043C\u0438\u0441\u043A\u0443.
    <br>   \u2022\u0421\u044B\u0440 \u0442\u0432\u0435\u0440\u0434\u044B\u0445 \u0441\u043E\u0440\u0442\u043E\u0432
    \u043D\u0430\u0440\u0435\u0437\u0430\u0442\u044C \u043C\u0435\u043B\u043A\u0438\u043C\u0438
    \u043A\u0443\u0431\u0438\u043A\u0430\u043C\u0438. \u0421\u044B\u0440\u043D\u0443\u044E
    \u043D\u0430\u0440\u0435\u0437\u043A\u0443 \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C
    \u043A \u043A\u0440\u0430\u0431\u043E\u0432\u044B\u043C \u043F\u0430\u043B\u043E\u0447\u043A\u0430\u043C.
    <br>   \u2022\u042F\u0439\u0446\u043E \u043F\u0435\u0440\u0435\u0434 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C,
    \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E, \u043F\u0440\u043E\u043C\u044B\u0442\u044C
    \u043F\u0440\u043E\u0442\u043E\u0447\u043D\u043E\u0439 \u0432\u043E\u0434\u043E\u0439
    \u0441 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C \u043C\u043E\u044E\u0449\u0435\u0433\u043E
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430. \u0421\u043F\u043E\u043B\u043E\u0441\u043D\u0443\u0442\u044C.
    <br>   \u2022\u041E\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0432 \u0445\u043E\u043B\u043E\u0434\u043D\u0443\u044E
    \u043F\u043E\u0434\u0441\u043E\u043B\u0435\u043D\u043D\u0443\u044E \u0432\u043E\u0434\u0443.
    \u0414\u043E\u0432\u0435\u0441\u0442\u0438 \u0434\u043E \u043A\u0438\u043F\u0435\u043D\u0438\u044F
    \u0438 \u0432\u0430\u0440\u0438\u0442\u044C 10 \u043C\u0438\u043D\u0443\u0442
    \u043D\u0430 \u0443\u043C\u0435\u0440\u0435\u043D\u043D\u043E\u043C \u043E\u0433\u043D\u0435.\u041E\u0441\u0442\u0443\u0434\u0438\u0442\u044C
    \u0432 \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u043E\u0439 \u0432\u043E\u0434\u0435.
    \u041E\u0431\u0441\u0443\u0448\u0438\u0442\u044C \u0441\u0430\u043B\u0444\u0435\u0442\u043A\u043E\u0439.
    \u041E\u0447\u0438\u0441\u0442\u0438\u0442\u044C. <br>   \u2022\u041D\u0430\u0440\u0435\u0437\u0430\u0442\u044C
    \u0442\u0430\u043A\u0438\u043C\u0438 \u0436\u0435 \u043A\u0443\u0431\u0438\u043A\u0430\u043C\u0438,
    \u043A\u0430\u043A \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B.
    \u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u043A \u043A\u0440\u0430\u0431\u043E\u0432\u044B\u043C
    \u043F\u0430\u043B\u043E\u0447\u043A\u0430\u043C \u0438 \u0441\u044B\u0440\u043D\u044B\u043C
    \u043A\u0443\u0431\u0438\u043A\u0430\u043C. <br>   \u2022\u0422\u0435\u043F\u0435\u0440\u044C
    \u043E\u0441\u0442\u0430\u0435\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
    \u0437\u0430\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0432\u0441\u044E \u043D\u0430\u0447\u0438\u043D\u043A\u0443
    \u0438 \u0434\u043E\u0432\u0435\u0441\u0442\u0438 \u0434\u043E \u0436\u0435\u043B\u0430\u0435\u043C\u043E\u0433\u043E
    \u0432\u043A\u0443\u0441\u0430.\u041F\u043E\u0434\u0441\u043E\u043B\u0438\u0442\u044C,
    \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u043F\u0435\u0440\u0447\u0438\u0442\u044C
    <br>   \u2022\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u043C\u0430\u0439\u043E\u043D\u0435\u0437
    \u043F\u043E \u0432\u043A\u0443\u0441\u0443. \u041F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0442\u044C.
    <br>   \u2022\u041B\u044E\u0431\u0438\u0442\u0435\u043B\u044F\u043C \u043E\u0441\u0442\u0440\u0435\u043D\u044C\u043A\u043E\u0433\u043E,
    \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C
    \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0438\u0437\u043C\u0435\u043B\u044C\u0447\u0435\u043D\u043D\u043E\u0433\u043E
    \u0447\u0435\u0441\u043D\u043E\u043A\u0430. \u041D\u0430\u0447\u0438\u043D\u043A\u0430
    \u0433\u043E\u0442\u043E\u0432\u0430. <br>   \u2022\u0412\u0437\u044F\u0442\u044C
    \u043F\u043E\u043C\u0438\u0434\u043E\u0440\u044B \u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E
    \u0440\u0430\u0437\u043C\u0435\u0440\u0430. \u0425\u043E\u0440\u043E\u0448\u043E
    \u043F\u0440\u043E\u043C\u044B\u0442\u044C \u0438 \u043E\u0431\u0441\u0443\u0448\u0438\u0442\u044C
    \u0441\u0430\u043B\u0444\u0435\u0442\u043A\u043E\u0439. \u0421\u0440\u0435\u0437\u0430\u0442\u044C
    \xAB\u0448\u043B\u044F\u043F\u043A\u0443\xBB. \u042D\u0442\u043E \u043C\u043E\u0436\u043D\u043E
    \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043B\u0438\u0431\u043E \u0441 \u043E\u0434\u043D\u043E\u0439,
    \u043B\u0438\u0431\u043E \u0441\u043E \u0432\u0442\u043E\u0440\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B.
    \u0412\u044B\u0431\u043E\u0440 \u0437\u0430 \u0432\u0430\u043C\u0438 \u0438 \u0437\u0430\u0432\u0438\u0441\u0438\u0442
    \u043E\u0442 \u0444\u043E\u0440\u043C\u044B \u043F\u043E\u043C\u0438\u0434\u043E\u0440\u043E\u0432.
    <br>   \u2022\u0427\u0430\u0439\u043D\u043E\u0439 \u043B\u043E\u0436\u0435\u0447\u043A\u043E\u0439
    \u0432\u044B\u0441\u043A\u043E\u0431\u043B\u0438\u0442\u044C \u0436\u0438\u0434\u043A\u0443\u044E
    \u0447\u0430\u0441\u0442\u044C. \u0414\u0435\u043B\u0430\u0442\u044C \u0432\u0441\u0435
    \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E, \u0447\u0442\u043E\u0431\u044B
    \u043D\u0435 \u043F\u0440\u043E\u0434\u044B\u0440\u044F\u0432\u0438\u0442\u044C
    \u0434\u043D\u043E. \u0416\u0438\u0434\u043A\u0443\u044E \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0443\u044E
    \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0434\u043B\u044F \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F
    \u0437\u0430\u0436\u0430\u0440\u043A\u0438, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0434\u043B\u044F \u0431\u043E\u0440\u0449\u0430. <br>   \u2022\u041D\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u044C
    \u0432\u0441\u0435 \u0442\u043E\u043C\u0430\u0442\u044B \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u043E\u0439
    \u043D\u0430\u0447\u0438\u043D\u043A\u043E\u0439. \u041F\u043B\u043E\u0442\u043D\u043E
    \u0443\u0442\u0440\u0430\u043C\u0431\u043E\u0432\u0430\u0442\u044C \u043B\u043E\u0436\u0435\u0447\u043A\u043E\u0439,
    \u0434\u0435\u043B\u0430\u044F \u0433\u043E\u0440\u043A\u0443.\u041F\u0440\u0438\u043A\u0440\u044B\u0442\u044C
