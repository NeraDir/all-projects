  m_Script: {fileID: 11500000, guid: 562d1bc0912893a4d86469389a774a85, type: 3}
  m_Name: "\u041A\u0443\u0440\u0438\u043D\u044B\u0435 \u0440\u0443\u043B\u0435\u0442\u0438\u043A\u0438
    \u0441 \u0441\u044B\u0440\u043E\u043C"
  m_EditorClassIdentifier: 
  Foodlabel: "\u041A\u0443\u0440\u0438\u043D\u044B\u0435 \u0440\u0443\u043B\u0435\u0442\u0438\u043A\u0438
    \u0441 \u0441\u044B\u0440\u043E\u043C"
  FoodDescription: 
  FoodIngridients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>    
    <br>   \u2022\u041A\u0443\u0440\u0438\u043D\u043E\u0435 \u0444\u0438\u043B\u0435
    \u2013 2\u0448\u0442 <br>   \u2022\u0421\u044B\u0440 \u2013 100 \u0433 <br>  
    \u2022\u0417\u0435\u043B\u0435\u043D\u044C \u2013 1 \u043F\u0443\u0447\u043E\u043A
    <br>   \u2022\u0427\u0435\u0441\u043D\u043E\u043A \u2013 2-3 \u0437\u0443\u0431\u0447\u0438\u043A\u0430
    <br>   \u2022\u0421\u043E\u043B\u044C \u2013 \u043F\u043E \u0432\u043A\u0443\u0441\u0443
    <br>   \u2022\u041F\u0435\u0440\u0435\u0446 \u0447\u0435\u0440\u043D\u044B\u0439
    \u043C\u043E\u043B\u043E\u0442\u044B\u0439 \u2013 \u043F\u043E \u0432\u043A\u0443\u0441\u0443
    <br>   \u2022\u041C\u0443\u043A\u0430 \u2013 100 \u0433 <br>   \u2022\u041C\u0430\u0441\u043B\u043E
    \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u2013
    100 \u0433"
  FoodHowToCoock: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
    <br>   \u2022\u041A\u0430\u043A \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
    \u043A\u0443\u0440\u0438\u043D\u044B\u0435 \u0440\u0443\u043B\u0435\u0442\u0438\u043A\u0438
    \u0441 \u0441\u044B\u0440\u043E\u043C:\u0420\u0435\u0436\u0435\u043C \u043A\u0443\u0440\u0438\u043D\u0443\u044E
    \u0433\u0440\u0443\u0434\u043A\u0443 \u0442\u043E\u043D\u043A\u0438\u043C\u0438
    \u043B\u043E\u043C\u0442\u0438\u043A\u0430\u043C\u0438. <br>   \u2022\u041E\u0442\u0431\u0438\u0432\u0430\u0435\u043C
    \u043D\u0430\u0440\u0435\u0437\u0430\u043D\u043D\u043E\u0435 \u043A\u0443\u0440\u0438\u043D\u043E\u0435
    \u0444\u0438\u043B\u0435. <br>   \u2022\u0421\u043E\u043B\u0438\u043C, \u043F\u0435\u0440\u0447\u0438\u043C
    \u0438 \u0441\u043C\u0430\u0437\u044B\u0432\u0430\u0435\u043C \u0438\u0437\u043C\u0435\u043B\u044C\u0447\u0435\u043D\u043D\u044B\u043C
    \u0447\u0435\u0441\u043D\u043E\u043A\u043E\u043C. <br>   \u2022\u041D\u0430 \u043A\u0440\u0430\u0439
    \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043A\u0443\u0441\u043E\u0447\u043A\u0430
    \u0444\u0438\u043B\u0435 \u043A\u043B\u0430\u0434\u0435\u043C 1 \u0441\u0442.
    \u043B. \u0442\u0435\u0440\u0442\u043E\u0433\u043E \u0441\u044B\u0440\u0430 \u0438
    \u043F\u043E\u0440\u0435\u0437\u0430\u043D\u043D\u0443\u044E \u0437\u0435\u043B\u0435\u043D\u044C.\u0424\u043E\u0440\u043C\u0438\u0440\u0443\u0435\u043C
    \u0440\u0443\u043B\u0435\u0442\u0438\u043A \u0438\u0437 \u043A\u0443\u0440\u0438\u043D\u043E\u0433\u043E
    \u0444\u0438\u043B\u0435 \u0441 \u0441\u044B\u0440\u043E\u043C \u0438 \u0437\u0435\u043B\u0435\u043D\u044C\u044E,
    \u043F\u043E\u0434\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044F \u0441
    \u0431\u043E\u043A\u043E\u0432, \u0447\u0442\u043E\u0431\u044B \u0441\u044B\u0440
    \u043F\u0440\u0438 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u0438
    \u043D\u0435 \u0432\u044B\u0442\u0435\u043A. \u0421\u043A\u0440\u0435\u043F\u043B\u044F\u0435\u043C
    \u043A\u0440\u0430\u044F \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043A\u0430\u043C\u0438
    \u0437\u0443\u0431\u043E\u0447\u0438\u0441\u0442\u043E\u043A. <br>   \u2022\u041E\u0431\u0432\u0430\u043B\u0438\u0432\u0430\u0435\u043C
    \u043A\u0443\u0440\u0438\u043D\u044B\u0435 \u0440\u0443\u043B\u0435\u0442\u0438\u043A\u0438
    \u0432 \u043C\u0443\u043A\u0435. <br>   \u2022\u041E\u0431\u0436\u0430\u0440\u0438\u0432\u0430\u0435\u043C
    \u0440\u0443\u043B\u0435\u0442\u0438\u043A\u0438 \u0438\u0437 \u043A\u0443\u0440\u0438\u043D\u043E\u0433\u043E
    \u0444\u0438\u043B\u0435 \u0441 \u0441\u044B\u0440\u043E\u043C \u0438 \u0437\u0435\u043B\u0435\u043D\u044C\u044E
    \u0432 \u0440\u0430\u0437\u043E\u0433\u0440\u0435\u0442\u043E\u043C \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C
    \u043C\u0430\u0441\u043B\u0435 \u0434\u043E \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u0438
    (\u0434\u043E \u0440\u0443\u043C\u044F\u043D\u043E\u0439 \u043A\u043E\u0440\u043E\u0447\u043A\u0438).
    <br>   \u2022\u0423\u0434\u0430\u043B\u044F\u0435\u043C \u0437\u0443\u0431\u043E\u0447\u0438\u0441\u0442\u043A\u0438
    \u0438 \u043F\u043E\u0434\u0430\u0435\u043C \u043A\u0443\u0440\u0438\u043D\u044B\u0435
    \u0440\u0443\u043B\u0435\u0442\u0438\u043A\u0438 \u043A \u0441\u0442\u043E\u043B\u0443.
    \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430!!!"
