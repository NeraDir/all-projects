        \u0438 \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u0435 \u043D\u0430 \u0442\u0430\u0440\u0435\u043B\u043A\u0443.
        <br>\u041F\u043E\u0434\u0430\u0432\u0430\u0442\u044C \u0438\u0445 \u043B\u0443\u0447\u0448\u0435
        \u0441 \u043A\u0435\u0442\u0447\u0443\u043F\u043E\u043C \u0438\u043B\u0438
        \u0434\u0440\u0443\u0433\u0438\u043C \u0441\u043E\u0443\u0441\u043E\u043C.
        \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430!!!"
      FoodIngredients: "<br>\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
