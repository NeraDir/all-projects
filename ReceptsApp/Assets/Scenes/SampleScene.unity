        \u0438\u0437 \u043A\u0443\u0440\u0438\u0446\u044B, \u043F\u043E\u043C\u0438\u0434\u043E\u0440\u0430
        , \u0441\u044B\u0440\u0430 \u0438 \u0437\u0435\u043B\u0435\u043D\u0438."
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
        <br>   \u2022\u0427\u0435\u0441\u043D\u043E\u043A \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C
        \u0438 \u043D\u0430\u0442\u0435\u0440\u0435\u0442\u044C \u043D\u0430 \u043C\u0435\u043B\u043A\u043E\u0439
        \u0442\u0451\u0440\u043A\u0435 \u0438\u043B\u0438 \u0432\u044B\u0434\u0430\u0432\u0438\u0442\u044C
        \u0447\u0435\u0440\u0435\u0437 \u043F\u0440\u0435\u0441\u0441. <br>\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C
        \u0432 \u0441\u043C\u0435\u0442\u0430\u043D\u0443 (\u0438\u043B\u0438 \u0439\u043E\u0433\u0443\u0440\u0442)
        \u0438\u0437\u043C\u0435\u043B\u044C\u0447\u0451\u043D\u043D\u044B\u0439
        \u0447\u0435\u0441\u043D\u043E\u043A \u0438 1 \u0449\u0435\u043F\u043E\u0442\u043A\u0443
        \u0441\u043E\u043B\u0438. \u041F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0442\u044C
        \u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u043E\u0443\u0441
        \u043D\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u0442\u044C\u0441\u044F.
        <br>   \u2022\u041F\u043E\u043C\u0438\u0434\u043E\u0440 \u043D\u0430\u0440\u0435\u0437\u0430\u0442\u044C
        \u043F\u043E\u043B\u0443\u043A\u0440\u0443\u0436\u043A\u0430\u043C\u0438.
        <br>\u0412\u0430\u0440\u0451\u043D\u043E\u0435 \u043A\u0443\u0440\u0438\u043D\u043E\u0435
        \u0444\u0438\u043B\u0435 \u0438 \u0441\u044B\u0440 \u043D\u0430\u0440\u0435\u0437\u0430\u0442\u044C
        \u0442\u043E\u043D\u043A\u0438\u043C\u0438 \u0441\u043B\u0430\u0439\u0441\u0430\u043C\u0438.
        <br>\u041B\u0443\u043A \u0438 \u0431\u0430\u0437\u0438\u043B\u0438\u043A
        \u043D\u0430\u0440\u0435\u0437\u0430\u0442\u044C \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
        \u043C\u0435\u043B\u043A\u043E. <br>   \u2022\u041B\u0430\u0432\u0430\u0448
        \u0440\u0430\u0437\u0440\u0435\u0437\u0430\u0442\u044C \u043D\u0430 \u043F\u043E\u043B\u043E\u0441\u043A\u0438
        \u0448\u0438\u0440\u0438\u043D\u043E\u0439 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
        15 \u0441\u043C (\u0434\u043B\u0438\u043D\u0430 - \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
        45 \u0441\u043C, \u043D\u043E \u043E\u043D\u0430 \u043D\u0435 \u0438\u043C\u0435\u0435\u0442
        \u043E\u0441\u043E\u0431\u043E\u0433\u043E \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F).
        <br>   \u2022\u0421 \u043E\u0434\u043D\u043E\u0433\u043E \u043A\u0440\u0430\u044F
        \u043F\u043E\u043B\u043E\u0441\u043A\u0438 \u043B\u0430\u0432\u0430\u0448\u0430
        \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u043E \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u044C
        \u043A\u0432\u0430\u0434\u0440\u0430\u0442 \u0438 \u0441\u043C\u0430\u0437\u0430\u0442\u044C
        \u0435\u0433\u043E \u0441\u043C\u0435\u0442\u0430\u043D\u043D\u044B\u043C
        \u0441\u043E\u0443\u0441\u043E\u043C. \u0421\u0432\u0435\u0440\u0445\u0443
        \u043D\u0430 \u0441\u043E\u0443\u0441 \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u044C
