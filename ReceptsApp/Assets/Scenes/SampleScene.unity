        \u043A\u0438\u043F\u044F\u0447\u0435\u043D\u0430\u044F \u043E\u0445\u043B\u0430\u0436\u0434\u0435\u043D\u043D\u0430\u044F
        \u2013 250 \u043C\u043B <br>   \u2022\u041C\u0451\u0434 \u2013 2 \u0447.
        \u041B\u043E\u0436\u043A\u0438 <br>   \u2022\u041A\u043E\u0440\u0438\u0446\u0430
        \u043C\u043E\u043B\u043E\u0442\u0430\u044F \u2013 \u0449\u0435\u043F\u043E\u0442\u043A\u0430"
  TrashFood:
    Name: "\u0412\u0420\u0415\u0414\u041D\u041E\u0415"
    mainFoods:
    - FoodImage: {fileID: 21300000, guid: 06dba15fc6d7bcd4bbeff19af65b588e, type: 3}
      FoodLabel: "\u0421\u0432\u0438\u043D\u044B\u0435 \u0443\u0448\u043A\u0438 \u043F\u043E-\u043A\u043E\u0440\u0435\u0439\u0441\u043A\u0438"
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>   
        <br>   \u2022\u0421\u044B\u0440\u044B\u0435 \u0443\u0448\u043A\u0438 \u0437\u0430\u043B\u0438\u0432\u0430\u0435\u043C
        \u043A\u0438\u043F\u044F\u0442\u043A\u043E\u043C \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
        \u043D\u0430 30 \u043C\u0438\u043D\u0443\u0442, \u0437\u0430\u0442\u0435\u043C
        \u0438\u0445 \u0445\u043E\u0440\u043E\u0448\u043E \u0432\u044B\u0447\u0438\u0449\u0430\u0435\u043C
        \u043D\u043E\u0436\u043E\u043C. <br>   \u2022\u0417\u0430\u043B\u0438\u0432\u0430\u0435\u043C
        \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0439 \u0432\u043E\u0434\u043E\u0439
        \u0438 \u0432\u0430\u0440\u0438\u043C \u0438\u0445 \u0434\u043E \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u0438
        \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E 2 \u0447\u0430\u0441\u0430,
        \u0432 \u043A\u043E\u043D\u0446\u0435 \u0432\u0430\u0440\u043A\u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u043C
        \u0433\u0432\u043E\u0437\u0434\u0438\u043A\u0443, \u0434\u0443\u0448\u0438\u0441\u0442\u044B\u0439
        \u043F\u0435\u0440\u0435\u0446, \u043B\u0430\u0432\u0440\u043E\u0432\u044B\u0439
        \u043B\u0438\u0441\u0442 \u0438 \u0441\u043E\u043B\u044C. \u0413\u043E\u0442\u043E\u0432\u044B\u0435
        \u0443\u0448\u043A\u0438 \u043E\u0445\u043B\u0430\u0436\u0434\u0430\u0435\u043C
        \u0438 \u043D\u0430\u0440\u0435\u0437\u0430\u0435\u043C \u0442\u043E\u043D\u0435\u043D\u044C\u043A\u043E\u0439
        \u0441\u043E\u043B\u043E\u043C\u043A\u043E\u0439. <br>   \u2022\u041C\u043E\u0440\u043A\u043E\u0432\u044C
        \u043D\u0430\u0442\u0438\u0440\u0430\u0435\u043C \u043D\u0430 \u0442\u0451\u0440\u043A\u0435
        \u0434\u043B\u044F \u043C\u043E\u0440\u043A\u043E\u0432\u0438. <br>   \u2022\u041D\u0430\u043B\u0438\u0432\u0430\u0435\u043C
        \u0432 \u0441\u043A\u043E\u0432\u043E\u0440\u043E\u0434\u043A\u0443 \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
        \u043C\u0430\u0441\u043B\u043E \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B
        \u043F\u043E\u043A\u0440\u044B\u043B\u043E \u043D\u0435\u043C\u043D\u043E\u0436\u043A\u043E
        \u0434\u043E\u043D\u044B\u0448\u043A\u043E, \u043C\u043D\u043E\u0433\u043E
        \u043C\u0430\u0441\u043B\u0430 \u043B\u0438\u0442\u044C \u043D\u0435 \u043D\u0430\u0434\u043E
        \u043F\u043E\u0442\u043E\u043C\u0443-\u0447\u0442\u043E \u0431\u043B\u044E\u0434\u043E
        \u0431\u0443\u0434\u0435\u0442 \u0438\u043C\u0435\u0442\u044C \u0436\u0438\u0440\u043D\u044B\u0439
        \u043F\u0440\u0438\u0432\u043A\u0443\u0441. <br>   \u2022\u0412 \u0445\u043E\u0440\u043E\u0448\u043E
        \u0440\u0430\u0441\u043A\u0430\u043B\u0451\u043D\u043D\u043E\u0435 \u043C\u0430\u0441\u043B\u043E
        \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u0443\u044E
        \u043C\u043E\u0440\u043A\u043E\u0432\u044C \u0438 \u0443\u0448\u043A\u0438,
        \u0431\u044B\u0441\u0442\u0440\u043E \u0432\u0441\u0451 \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0442\u044C,
        \u043F\u0440\u043E\u0436\u0430\u0440\u0438\u0432\u0430\u0442\u044C \u0432\u0441\u0451
        \u0432\u0440\u0435\u043C\u044F \u043F\u043E\u043C\u0435\u0448\u0438\u0432\u0430\u044F
        \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E 1 \u043C\u0438\u043D\u0443\u0442\u0443.
        <br>   \u2022\u0412\u044B\u0441\u044B\u043F\u0430\u0435\u043C \u0432\u0441\u0451
        \u0432 \u043C\u0438\u0441\u043A\u0443 \u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u043C
        : \u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u043F\u0435\u0440\u0435\u0446
        \u0433\u043E\u0440\u044C\u043A\u0438\u0439, \u0441\u043E\u043B\u044C, \u043A\u043E\u0440\u0438\u0430\u043D\u0434\u0440,
        \u0443\u043A\u0441\u0443\u0441+\u0432\u043E\u0434\u0430, \u0441\u043E\u0435\u0432\u044B\u0439
        \u0441\u043E\u0443\u0441, \u0437\u0435\u043B\u0435\u043D\u044C \u0438 \u0432\u044B\u0434\u0430\u0432\u0438\u0442\u044C
        \u0447\u0435\u0441\u043D\u043E\u043A \u0432\u0441\u0451 \u043E\u0447\u0435\u043D\u044C
        \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0442\u044C
        \u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432 \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A
        \u043D\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u0442\u044C\u0441\u044F
        \u043C\u0438\u043D\u0438\u043C\u0443\u043C 3-4 \u0447\u0430\u0441\u0430.
        \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430!!! "
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>   
        <br>   \u2022\u0421\u0432\u0438\u043D\u044B\u0435 \u0443\u0448\u043A\u0438
        \u2013 2\u0448\u0442 <br>   \u2022\u0413\u0432\u043E\u0437\u0434\u0438\u043A\u0430
        \u2013 3\u0448\u0442 <br>   \u2022\u0414\u0443\u0448\u0438\u0441\u0442\u044B\u0439
        \u043F\u0435\u0440\u0435\u0446 \u0433\u043E\u0440\u043E\u0448\u043A\u043E\u043C
        \u2013 5\u0448\u0442 <br>   \u2022\u041B\u0430\u0432\u0440\u043E\u0432\u044B\u0439
        \u043B\u0438\u0441\u0442 \u2013 1\u0448\u0442 <br>   \u2022\u041C\u043E\u0440\u043A\u043E\u0432\u044C
        \u2013 1\u0448\u0442 <br>   \u2022\u0427\u0435\u0441\u043D\u043E\u043A \u2013
        5 \u0437\u0443\u0431\u0447\u0438\u043A\u043E\u0432 <br>   \u2022\u0421\u043E\u0435\u0432\u044B\u0439
        \u0441\u043E\u0443\u0441 \u2013 50\u043C\u043B <br>   \u2022\u0423\u043A\u0441\u0443\u0441
        \u2013 1 \u0447.\u043B.+4 \u0447.\u043B. \u043A\u0438\u043F\u044F\u0442\u043A\u0430
        <br>   \u2022\u0421\u043E\u043B\u044C \u2013 \u043F\u043E \u0432\u043A\u0443\u0441\u0443
        <br>   \u2022\u041F\u0435\u0440\u0435\u0446 \u043A\u0440\u0430\u0441\u043D\u044B\u0439
        \u2013 \u043F\u043E \u0432\u043A\u0443\u0441\u0443 <br>   \u2022\u041A\u043E\u0440\u0438\u0430\u043D\u0434\u0440
        \u2013 \xBD \u0447.\u043B. <br>   \u2022\u041C\u0430\u0441\u043B\u043E \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
        \u2013 30\u043C\u043B <br>   \u2022\u0417\u0435\u043B\u0435\u043D\u044C \u2013
        \u043F\u043E \u0432\u043A\u0443\u0441\u0443"
    - FoodImage: {fileID: 21300000, guid: a7d2f5830afdbc7458aa0f4f6e3b80cf, type: 3}
      FoodLabel: "\u0411\u0435\u0444\u0441\u0442\u0440\u043E\u0433\u0430\u043D\u043E\u0432
        \u0438\u0437 \u0441\u0432\u0438\u043D\u0438\u043D\u044B \u0441\u043E \u0441\u043C\u0435\u0442\u0430\u043D\u043E\u0439"
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>   
        <br>   \u2022\u041C\u044F\u0441\u043E \u043D\u0430\u0440\u0435\u0437\u0430\u0435\u043C
        \u0434\u043B\u0438\u043D\u043D\u044B\u043C\u0438 \u0431\u0440\u0443\u0441\u043A\u0430\u043C\u0438
        \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E\u0439
        \u0442\u043E\u043B\u0449\u0438\u043D\u044B. <br>   \u2022\u0422\u043E\u043D\u043A\u0438\u043C\u0438
        \u043F\u043E\u043B\u0443\u043A\u043E\u043B\u044C\u0446\u0430\u043C\u0438
        \u0438\u043B\u0438 \u043A\u043E\u043B\u044C\u0446\u0430\u043C\u0438 \u0448\u0438\u043D\u043A\u0443\u0435\u043C
        \u043B\u0443\u043A\u043E\u0432\u0438\u0446\u0443. <br>   \u2022\u041F\u0435\u0440\u0432\u044B\u043C
        \u043D\u0430 \u0440\u0430\u0441\u043A\u0430\u043B\u0435\u043D\u043D\u043E\u0439
        \u0441\u043A\u043E\u0432\u043E\u0440\u043E\u0434\u0435 \u0441 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C
        \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
        \u043C\u0430\u0441\u043B\u0430 \u043E\u0431\u0436\u0430\u0440\u0438\u0432\u0430\u0435\u043C
        \u043B\u0443\u043A. <br>   \u2022\u041A \u0441\u043B\u0435\u0433\u043A\u0430
        \u043F\u043E\u0434\u0440\u0443\u043C\u044F\u043D\u0435\u043D\u043D\u043E\u043C\u0443
        \u043C\u044F\u0441\u0443 \u0441 \u043B\u0443\u043A\u043E\u043C \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u043C
        \u0441\u043C\u0435\u0442\u0430\u043D\u0443 \u0438 \u0432\u043B\u0438\u0432\u0430\u0435\u043C
        \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E 100 \u043C\u043B \u043A\u0438\u043F\u044F\u0442\u043A\u0430.
        <br>   \u2022\u0421\u043E\u043B\u0438\u043C, \u043C\u0435\u0448\u0430\u0435\u043C,
        \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u043C \u0447\u0435\u0440\u043D\u044B\u0439
        \u043F\u0435\u0440\u0435\u0446 \u0438 \u043B\u0430\u0432\u0440\u043E\u0432\u044B\u0439
        \u043B\u0438\u0441\u0442. <br>   \u2022\u0422\u0443\u0448\u0438\u043C \u0434\u043E
        \u0437\u0430\u0433\u0443\u0441\u0442\u0435\u043D\u0438\u044F \u043F\u043E\u0434\u043B\u0438\u0432\u044B
        \u0438 \u043C\u044F\u0433\u043A\u043E\u0441\u0442\u0438 \u0441\u0432\u0438\u043D\u044B\u0445
        \u043A\u0443\u0441\u043A\u043E\u0432 (\u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
        25-30 \u043C\u0438\u043D\u0443\u0442). <br>   \u2022\u041F\u043E\u0434\u0430\u0435\u043C
        \u043D\u0435\u0436\u043D\u0443\u044E \u043F\u043E\u0434\u043B\u0438\u0432\u0443
        \u2014 \u0431\u0435\u0444\u0441\u0442\u0440\u043E\u0433\u0430\u043D\u043E\u0432
        \u0438\u0437 \u0441\u0432\u0438\u043D\u0438\u043D\u044B \u0441\u043E \u0441\u043C\u0435\u0442\u0430\u043D\u043E\u0439
        \u2014 \u0441 \u043B\u044E\u0431\u044B\u043C \u0433\u0430\u0440\u043D\u0438\u0440\u043E\u043C
        (\u0443 \u043C\u0435\u043D\u044F \u0440\u0438\u0441) \u0441\u0432\u0435\u0436\u0438\u043C\u0438
        \u043E\u0432\u043E\u0449\u0430\u043C\u0438 \u0438\u043B\u0438 \u0441\u043E\u043B\u0435\u043D\u044C\u044F\u043C\u0438.
        \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430!!!"
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>   
        <br>   \u2022\u0421\u0432\u0438\u043D\u0438\u043D\u0430  <br>   \u2022\u0420\u0435\u043F\u0447\u0430\u0442\u044B\u0439
        \u043B\u0443\u043A <br>   \u2022\u0421\u043C\u0435\u0442\u0430\u043D\u0430
        <br>   \u2022\u0421\u043E\u043B\u044C <br>   \u2022\u0427\u0435\u0440\u043D\u044B\u0439
        \u043F\u0435\u0440\u0435\u0446 <br>   \u2022\u041B\u0430\u0432\u0440\u043E\u0432\u044B\u0439
        \u043B\u0438\u0441\u0442"
    - FoodImage: {fileID: 21300000, guid: bbc9d91f8ad6a3144bbbbb7aba8a85e5, type: 3}
      FoodLabel: "\u0413\u0443\u043B\u044F\u0448 \u0438\u0437 \u0441\u0432\u0438\u043D\u0438\u043D\u044B
        \u0441 \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044C\u043D\u044B\u043C
        \u043F\u044E\u0440\u0435"
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>   
        <br>   \u2022\u0412 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u0441\u043A\u043E\u0432\u043E\u0440\u043E\u0434\u0435
        \u043E\u0431\u0436\u0430\u0440\u0438\u0432\u0430\u044E\u0442 \u043C\u044F\u0441\u043E,
        \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u043C \u043B\u0443\u043A,
        \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u043C \u0441\u043F\u0435\u0446\u0438\u0438.
        <br>   \u2022\u0414\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u043C \u043C\u043E\u0440\u043A\u043E\u0432\u044C,
        \u043E\u0431\u0436\u0430\u0440\u0438\u0432\u0430\u044E\u0442, \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u043C
        \u0432\u043E\u0434\u0443, \u0432\u0430\u0440\u0438\u043C 20 \u043C\u0438\u043D,
        \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0442\u043E\u043C\u0430\u0442
        \u0438 \u0432\u0430\u0440\u0438\u043C \u0435\u0449\u0451 10 \u043C\u0438\u043D.
        <br>   \u2022\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0440\u0430\u0437\u0432\u0435\u0434\u0435\u043D\u043D\u0443\u044E
        \u043C\u0443\u043A\u0443 \u0432 \u0432\u043E\u0434\u0435 \u043A\u0438\u043F\u044F\u0442\u0438\u043C
        5 \u043C\u0438\u043D, \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u043C
        \u0437\u0435\u043B\u0435\u043D\u044C. <br>   \u2022\u0413\u043E\u0442\u043E\u0432\u0438\u043C
        \u043F\u044E\u0440\u0435.  <br>   \u2022\u0412\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u043C
        \u0432\u0441\u0451 \u043D\u0430 \u043E\u0434\u043D\u0443 \u0442\u0430\u0440\u0435\u043B\u043A\u0443
        \u0438 \u0431\u043B\u044E\u0434\u043E \u0433\u043E\u0442\u043E\u0432\u043E,
        \u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430!!!"
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>   
        <br>   \u2022\u0421\u0432\u0438\u043D\u0438\u043D\u0430 \u2013 500 \u0433
        <br>   \u2022\u041B\u0443\u043A \u2013 100 \u0433 <br>   \u2022\u041C\u043E\u0440\u043A\u043E\u0432\u044C
        \u2013 150 \u0433 <br>   \u2022\u0422\u043E\u043C\u0430\u0442 \u2013 50 \u0433
        <br>   \u2022\u041C\u0443\u043A\u0430 \u2013 2 \u0441\u0442.\u043B. <br>  
        \u2022\u0412\u043E\u0434\u0430 \u2013 1 \u043B <br>   \u2022\u0421\u043E\u043B\u044C
        \u2013 5 \u0433 <br>   \u2022\u041F\u0435\u0440\u0435\u0446 \u0447\u0435\u0440\u043D\u044B\u0439
        \u043C\u043E\u043B\u043E\u0442\u044B\u0439 \u2013 2 \u0433 <br>   \u2022\u041B\u0430\u0432\u0440\u043E\u0432\u044B\u0439
        \u043B\u0438\u0441\u0442 \u2013 3\u0448\u0442 <br>   \u2022\u0427\u0435\u0440\u043D\u044B\u0439
        \u0433\u043E\u0440\u043E\u0448\u0435\u043A \u2013 6\u0448\u0442 <br>   \u2022\u041F\u0435\u0442\u0440\u0443\u0448\u043A\u0430
        \u2013 2 \u0433 <br>   \u2022\u041B\u0443\u043A \u2013 2 \u0433 <br>   \u2022\u0423\u043A\u0440\u043E\u043F
