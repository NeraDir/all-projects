    - FoodImage: {fileID: 21300000, guid: 7e7e258ab911e2243bc3a50c712eaf69, type: 3}
      FoodLabel: "\u041A\u043E\u043D\u0432\u0435\u0440\u0442\u0438\u043A\u0438 \u0438\u0437
