    - FoodImage: {fileID: 21300000, guid: db47ea29e168da24b8164cb8692922d9, type: 3}
      FoodLabel: "\u041C\u0430\u043A\u043E\u0432\u043E\u0435 \u043C\u043E\u043B\u043E\u043A\u043E
        \u0441 \u043C\u0451\u0434\u043E\u043C \u0438 \u043A\u043E\u0440\u0438\u0446\u0435\u0439 "
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
        <br>   \u2022\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435
        \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u0435 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B.
        <br>\u041F\u043E \u0436\u0435\u043B\u0430\u043D\u0438\u044E \u043C\u0451\u0434
        \u043C\u043E\u0436\u043D\u043E \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C
        \u0441\u0430\u0445\u0430\u0440\u043E\u043C \u0438\u043B\u0438 \u043B\u044E\u0431\u044B\u043C
        \u0434\u0440\u0443\u0433\u0438\u043C \u043F\u043E\u0434\u0441\u043B\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u0435\u043C
        \u043F\u043E \u0432\u043A\u0443\u0441\u0443. \u041A\u043E\u0440\u0438\u0446\u0443
        \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u044C
        \u0438\u043B\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
        \u0432\u043C\u0435\u0441\u0442\u043E \u043D\u0435\u0451 \u043B\u044E\u0431\u044B\u0435
        \u0434\u0440\u0443\u0433\u0438\u0435 \u0441\u043F\u0435\u0446\u0438\u0438
        \u0438\u043B\u0438 \u043F\u0440\u044F\u043D\u043E\u0441\u0442\u0438 - \u0438\u043C\u0431\u0438\u0440\u044C,
        \u043A\u0430\u0440\u0434\u0430\u043C\u043E\u043D \u0438\u043B\u0438 \u0432\u0430\u043D\u0438\u043B\u044C\u043D\u044B\u0439
        \u0441\u0430\u0445\u0430\u0440. <br>   \u2022\u041C\u0430\u043A \u043F\u0435\u0440\u0435\u0441\u044B\u043F\u044C\u0442\u0435
        \u0432 \u0433\u043B\u0443\u0431\u043E\u043A\u0443\u044E \u043C\u0438\u0441\u043A\u0443.
        <br>   \u2022\u0414\u043E\u0432\u0435\u0434\u0438\u0442\u0435 \u0434\u043E
        \u043A\u0438\u043F\u0435\u043D\u0438\u044F \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
        250 \u043C\u043B \u0432\u043E\u0434\u044B. <br>\u0417\u0430\u043B\u0435\u0439\u0442\u0435
        \u043C\u0430\u043A \u043A\u0438\u043F\u044F\u0442\u043A\u043E\u043C, \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0439\u0442\u0435
        \u0438 \u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
        \u043D\u0430 1 \u0447\u0430\u0441. <br>   \u2022\u0417\u0430\u0442\u0435\u043C
        \u043E\u0442\u0431\u0440\u043E\u0441\u044C\u0442\u0435 \u043C\u0430\u043A
        \u043D\u0430 \u043C\u0435\u043B\u043A\u043E\u0435 \u0441\u0438\u0442\u043E
        \u0438\u043B\u0438 \u043C\u0430\u0440\u043B\u044E \u0438 \u0434\u0430\u0439\u0442\u0435
        \u043B\u0438\u0448\u043D\u0435\u0439 \u0432\u043E\u0434\u0435 \u0441\u0442\u0435\u0447\u044C.
        <br>   \u2022\u041F\u0435\u0440\u0435\u043B\u043E\u0436\u0438\u0442\u0435
        \u0440\u0430\u0441\u043F\u0430\u0440\u0435\u043D\u043D\u044B\u0435 \u0441\u0435\u043C\u0435\u043D\u0430
        \u043C\u0430\u043A\u0430 \u0432 \u0447\u0430\u0448\u0443 \u0431\u043B\u0435\u043D\u0434\u0435\u0440\u0430.
        <br>   \u2022\u0412\u043B\u0435\u0439\u0442\u0435 100 \u043C\u043B \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0439
        \u043A\u0438\u043F\u044F\u0447\u0451\u043D\u043E\u0439 \u0432\u043E\u0434\u044B.
        <br>   \u2022\u0412\u0437\u0431\u0438\u0432\u0430\u0439\u0442\u0435 \u043C\u0430\u043A
        \u0441 \u0432\u043E\u0434\u043E\u0439 \u043D\u0430 \u0441\u0430\u043C\u043E\u0439
        \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438
        \u0431\u043B\u0435\u043D\u0434\u0435\u0440\u0430 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
        3-5 \u043C\u0438\u043D\u0443\u0442. \u0412 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435
        \u043C\u0430\u043A\u043E\u0432\u044B\u0435 \u0437\u0451\u0440\u043D\u044B\u0448\u043A\u0438
        \u043F\u0435\u0440\u0435\u043C\u0435\u043B\u044E\u0442\u0441\u044F \u0432
        \u043A\u0430\u0448\u0438\u0446\u0443, \u0430 \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u044C
        \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0451\u0442 \u043C\u043E\u043B\u043E\u0447\u043D\u044B\u0439
        \u0446\u0432\u0435\u0442 \u0438 \u0441\u0442\u0430\u043D\u0435\u0442 \u0433\u0443\u0449\u0435.
        <br>   \u2022\u0414\u043E\u043B\u0435\u0439\u0442\u0435 \u043E\u0441\u0442\u0430\u0432\u0448\u0443\u044E\u0441\u044F
        \u0445\u043E\u043B\u043E\u0434\u043D\u0443\u044E \u043A\u0438\u043F\u044F\u0447\u0451\u043D\u0443\u044E
        \u0432\u043E\u0434\u0443 (150 \u043C\u043B) <br>   \u2022\u0414\u043E\u0431\u0430\u0432\u044C\u0442\u0435
        \u043C\u0451\u0434 \u043F\u043E \u0432\u043A\u0443\u0441\u0443 \u0438 \u043C\u043E\u043B\u043E\u0442\u0443\u044E
        \u043A\u043E\u0440\u0438\u0446\u0443. <br>   \u2022\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435
        \u0432\u0437\u0431\u0438\u0432\u0430\u0442\u044C \u043C\u0430\u043A\u043E\u0432\u043E\u0435
        \u043C\u043E\u043B\u043E\u043A\u043E \u043D\u0430 \u0432\u044B\u0441\u043E\u043A\u043E\u0439
        \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u0431\u043B\u0435\u043D\u0434\u0435\u0440\u0430
        \u0435\u0449\u0451 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E 2 \u043C\u0438\u043D\u0443\u0442\u044B.
        <br>   \u2022\u0417\u0430\u0442\u0435\u043C \u043F\u0440\u043E\u0446\u0435\u0434\u0438\u0442\u0435
        \u043C\u0430\u043A\u043E\u0432\u043E\u0435 \u043C\u043E\u043B\u043E\u043A\u043E
        \u0447\u0435\u0440\u0435\u0437 \u0441\u0430\u043C\u043E\u0435 \u043C\u0435\u043B\u043A\u043E\u0435
        \u0441\u0438\u0442\u0435\u0447\u043A\u043E, \u0430 \u0435\u0449\u0451 \u043B\u0443\u0447\u0448\u0435
        - \u0447\u0435\u0440\u0435\u0437 \u043C\u0430\u0440\u043B\u044E, \u0441\u043B\u043E\u0436\u0435\u043D\u043D\u0443\u044E
        \u0432 4-6 \u0441\u043B\u043E\u0451\u0432. <br>   \u2022\u0412 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435
        \u044D\u0442\u043E\u0439 \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u044B
        \u0443 \u0432\u0430\u0441 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F
        \u043C\u0430\u043A\u043E\u0432\u043E\u0435 \u043C\u043E\u043B\u043E\u043A\u043E
        \u0438 \u043C\u0430\u043A\u043E\u0432\u044B\u0439 \u0436\u043C\u044B\u0445,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043C\u043E\u0436\u043D\u043E
        \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
        \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043D\u0430\u0447\u0438\u043D\u043A\u0438
        \u0434\u043B\u044F \u0431\u0443\u043B\u043E\u0447\u0435\u043A \u0438 \u043F\u0438\u0440\u043E\u0433\u043E\u0432.
        <br>   \u2022\u041C\u0430\u043A\u043E\u0432\u043E\u0435 \u043C\u043E\u043B\u043E\u043A\u043E
        \u0433\u043E\u0442\u043E\u0432\u043E, \u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E
        \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0442\u044C \u0432 \u043A\u043E\u0444\u0435,
        \u0447\u0430\u0439, \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u043D\u0430
        \u0435\u0433\u043E \u043E\u0441\u043D\u043E\u0432\u0435 \u0441\u043C\u0443\u0437\u0438.
        <br>\u0425\u0440\u0430\u043D\u0438\u0442\u044C \u0442\u0430\u043A\u043E\u0435
        \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
        \u043C\u043E\u043B\u043E\u043A\u043E \u043D\u0443\u0436\u043D\u043E \u0432
        \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A\u0435
        \u0434\u043E 2 \u0441\u0443\u0442\u043E\u043A. \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E
        \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430 !!!"
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
