        \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0441\u044F
        \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A. <br>  
        \u2022\u0417\u0430\u0442\u0435\u043C \u0441\u0432\u0435\u0440\u043D\u0443\u0442\u044C
        \u043B\u0430\u0432\u0430\u0448 \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B
        \u0432 \u0438\u0442\u043E\u0433\u0435 \u0442\u0430\u043A\u0436\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0441\u044F
        \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A. \u041D\u0430\u0447\u0438\u043D\u043A\u0430
        \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C \u0437\u0430\u043A\u0440\u044B\u0442\u0430
        \u0441\u043E \u0432\u0441\u0435\u0445 \u0441\u0442\u043E\u0440\u043E\u043D.
        <br>   \u2022\u042F\u0439\u0446\u0430 \u0440\u0430\u0437\u0431\u043E\u043B\u0442\u0430\u0442\u044C
        \u0441 1 \u0449\u0435\u043F\u043E\u0442\u043A\u043E\u0439 \u0441\u043E\u043B\u0438
        \u0438 \u043C\u043E\u043B\u043E\u043A\u043E\u043C. <br>\u041E\u0431\u043C\u0430\u043A\u043D\u0443\u0442\u044C
        \u043A\u043E\u043D\u0432\u0435\u0440\u0442\u0438\u043A\u0438 \u0438\u0437
        \u043B\u0430\u0432\u0430\u0448\u0430 \u0441\u043E \u0432\u0441\u0435\u0445
        \u0441\u0442\u043E\u0440\u043E\u043D \u0432 \u043B\u044C\u0435\u0437\u043E\u043D
        (\u044F\u0439\u0446\u0430 \u0441 \u043C\u043E\u043B\u043E\u043A\u043E\u043C).
        <br>   \u2022\u0412\u044B\u043B\u043E\u0436\u0438\u0442\u044C \u043B\u0430\u0432\u0430\u0448
        \u0441 \u043D\u0430\u0447\u0438\u043D\u043A\u043E\u0439 \u043D\u0430 \u0441\u043A\u043E\u0432\u043E\u0440\u043E\u0434\u0443
        \u0441 \u0440\u0430\u0437\u043E\u0433\u0440\u0435\u0442\u044B\u043C \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
        \u043C\u0430\u0441\u043B\u043E\u043C. \u041E\u0431\u0436\u0430\u0440\u0438\u0442\u044C
        \u043A\u043E\u043D\u0432\u0435\u0440\u0442\u0438\u043A\u0438 \u0438\u0437
        \u043B\u0430\u0432\u0430\u0448\u0430 \u043D\u0430 \u0443\u043C\u0435\u0440\u0435\u043D\u043D\u043E\u043C
        \u043E\u0433\u043D\u0435 \u043F\u043E 3-4 \u043C\u0438\u043D\u0443\u0442\u044B
        \u0441 \u043A\u0430\u0436\u0434\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B,
        \u0434\u043E \u0440\u0443\u043C\u044F\u043D\u043E\u0441\u0442\u0438. \u041F\u043E
        \u0436\u0435\u043B\u0430\u043D\u0438\u044E \"\u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u0442\u044C\"
        \u0442\u043E\u0440\u0446\u044B \u043A\u043E\u043D\u0432\u0435\u0440\u0442\u0438\u043A\u043E\u0432
        \u0438\u0437 \u043B\u0430\u0432\u0430\u0448\u0430. <br>   \u2022\u041E\u0431\u0436\u0430\u0440\u0435\u043D\u043D\u044B\u0435
        \u043A\u043E\u043D\u0432\u0435\u0440\u0442\u0438\u043A\u0438 \u0438\u0437
        \u043B\u0430\u0432\u0430\u0448\u0430 \u0441 \u043A\u0443\u0440\u0438\u0446\u0435\u0439,
        \u043F\u043E\u043C\u0438\u0434\u043E\u0440\u0430\u043C\u0438, \u0441\u044B\u0440\u043E\u043C
        \u0438 \u0437\u0435\u043B\u0435\u043D\u044C\u044E \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u044C
        \u043D\u0430 \u0431\u0443\u043C\u0430\u0436\u043D\u043E\u0435 \u043F\u043E\u043B\u043E\u0442\u0435\u043D\u0446\u0435,
        \u0447\u0442\u043E\u0431\u044B \u0432\u043F\u0438\u0442\u0430\u043B\u0441\u044F
        \u043B\u0438\u0448\u043D\u0438\u0439 \u0436\u0438\u0440. <br>\u041F\u043E\u0441\u043B\u0435
        \u0447\u0435\u0433\u043E \u0437\u0430\u043A\u0443\u0441\u043A\u0443 \u0438\u0437
        \u043B\u0430\u0432\u0430\u0448\u0430 \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0434\u0430\u0432\u0430\u0442\u044C
        \u043A \u0441\u0442\u043E\u043B\u0443 \u0438\u043B\u0438 \u0434\u0430\u0432\u0430\u0442\u044C
        \u0434\u0435\u0442\u044F\u043C \u0432 \u0448\u043A\u043E\u043B\u0443, \u0431\u0440\u0430\u0442\u044C
        \u0441 \u0441\u043E\u0431\u043E\u0439 \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443
        \u0438\u043B\u0438 \u043D\u0430 \u043F\u0438\u043A\u043D\u0438\u043A. <br>\u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E
        \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430!!!"
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
        <br>   \u2022\u041B\u0430\u0432\u0430\u0448 \u0442\u043E\u043D\u043A\u0438\u0439
        \u2013 1 \u043B\u0438\u0441\u0442 <br>   \u2022\u0424\u0438\u043B\u0435 \u043A\u0443\u0440\u0438\u043D\u043E\u0435
        \u043E\u0442\u0432\u0430\u0440\u043D\u043E\u0435 \u2013 150 \u0433 <br>  
        \u2022\u041F\u043E\u043C\u0438\u0434\u043E\u0440 \u2013 1 \u0448\u0442 <br>  
        \u2022\u0421\u044B\u0440 (\u0436\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u043E
        \u0441\u0443\u043B\u0443\u0433\u0443\u043D\u0438) \u2013 100 \u0433 <br>  
        \u2022\u041B\u0443\u043A \u0437\u0435\u043B\u0435\u043D\u044B\u0439 \u2013
        1 \u043F\u0443\u0447\u043E\u043A <br>   \u2022\u0411\u0430\u0437\u0438\u043B\u0438\u043A
        \u0437\u0435\u043B\u0435\u043D\u044B\u0439 \u0441\u0432\u0435\u0436\u0438\u0439
        \u2013 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u0435\u0442\u043E\u0447\u0435\u043A
        <br>   \u2022\u042F\u0439\u0446\u0430 \u2013 2 \u0448\u0442 <br>   \u2022\u041C\u043E\u043B\u043E\u043A\u043E
        \u2013 50 \u043C\u043B <br>   \u2022\u0421\u043C\u0435\u0442\u0430\u043D\u0430
        \u2013 3 \u0441\u0442. \u043B\u043E\u0436\u043A\u0438  <br>   \u2022\u0427\u0435\u0441\u043D\u043E\u043A
        \u2013 1 \u0437\u0443\u0431\u0447\u0438\u043A <br>   \u2022\u0421\u043E\u043B\u044C
        \u2013 2 \u0449\u0435\u043F\u043E\u0442\u043A\u0438  <br>   \u2022\u041C\u0430\u0441\u043B\u043E
        \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
        \u2013 \u0434\u043B\u044F \u0436\u0430\u0440\u043A\u0438 "
    - FoodImage: {fileID: 21300000, guid: 63202441d1e58f0429a57ca090cc90fc, type: 3}
      FoodLabel: "\u0413\u0440\u0435\u043D\u043A\u0438 \u0441\u043E \u0448\u043F\u0440\u043E\u0442\u0430\u043C\u0438"
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
        <br>   \u2022\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435
        \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u0435 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B
        \u0434\u043B\u044F \u0431\u0443\u0442\u0435\u0440\u0431\u0440\u043E\u0434\u043E\u0432
        \u0441\u043E \u0448\u043F\u0440\u043E\u0442\u0430\u043C\u0438, \u044F\u0439\u0446\u0430\u043C\u0438
        \u0438 \u043F\u043E\u043C\u0438\u0434\u043E\u0440\u0430\u043C\u0438. \u042F\u0439\u0446\u0430
        \u0437\u0430\u043B\u0438\u0442\u044C \u0432 \u043A\u0430\u0441\u0442\u0440\u044E\u043B\u0435
        \u0432\u043E\u0434\u043E\u0439, \u0434\u043E\u0432\u0435\u0441\u0442\u0438
        \u0434\u043E \u043A\u0438\u043F\u0435\u043D\u0438\u044F \u0438 \u0432\u0430\u0440\u0438\u0442\u044C
        10 \u043C\u0438\u043D\u0443\u0442. \u0417\u0430\u0442\u0435\u043C \u043E\u0441\u0442\u0443\u0434\u0438\u0442\u044C
        \u0438 \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C. <br>   \u2022\u0420\u0430\u0437\u0440\u0435\u0436\u044C\u0442\u0435
        \u0431\u0443\u043B\u043E\u0447\u043A\u0438 \u043D\u0430 \u0434\u0432\u0435
        \u0447\u0430\u0441\u0442\u0438 (\u0438\u043B\u0438 \u0432\u043E\u0437\u044C\u043C\u0438\u0442\u0435
        \u043B\u044E\u0431\u043E\u0439 \u0442\u0435\u043C\u043D\u044B\u0439 \u0445\u043B\u0435\u0431)
        \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u0435 \u0438\u0445 \u043D\u0430
        \u0440\u0435\u0448\u0435\u0442\u043A\u0443 \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u044C\u0442\u0435
        \u0432 \u0434\u0443\u0445\u043E\u0432\u043A\u0443 \u043F\u043E\u0434\u0441\u0443\u0448\u0438\u0442\u044C\u0441\u044F.
        \u041D\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0439\u0442\u0435
        \u0445\u043B\u0435\u0431 \u0432 \u0441\u0443\u0445\u0430\u0440\u0438, \u043E\u043D
        \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C \u0432\u0441\u0435\u0433\u043E
        \u043B\u0438\u0448\u044C \u0441 \u0445\u0440\u0443\u0441\u0442\u044F\u0449\u0435\u0439
        \u043A\u043E\u0440\u043E\u0447\u043A\u043E\u0439. <br>   \u2022\u041D\u0430
        \u043A\u0440\u0443\u043F\u043D\u043E\u0439 \u0442\u0435\u0440\u043A\u0435
        \u043D\u0430\u0442\u0440\u0438\u0442\u0435 \u0432\u0430\u0440\u0435\u043D\u044B\u0435
        \u044F\u0439\u0446\u0430. <br>   \u2022\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435
        \u0431\u0430\u043D\u043A\u0443 \u0441\u043E \u0448\u043F\u0440\u043E\u0442\u0430\u043C\u0438,
        \u0441\u043B\u0435\u0439\u0442\u0435 \u043C\u0430\u0441\u043B\u043E. \u041D\u0430\u0440\u0435\u0436\u044C\u0442\u0435
        \u043F\u043E\u043C\u0438\u0434\u043E\u0440 \u0442\u043E\u043D\u043A\u0438\u043C\u0438
        \u043B\u043E\u043C\u0442\u0438\u043A\u0430\u043C\u0438. \u0415\u0441\u043B\u0438
        \u043E\u043D \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0432\u043E\u0434\u044F\u043D\u0438\u0441\u0442\u044B\u0439,
        \u0443\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u0435\u043C\u0435\u0447\u043A\u0438.
        <br>   \u2022\u0413\u043E\u0442\u043E\u0432\u044B\u043C \u0433\u0440\u0435\u043D\u043A\u0430\u043C
        \u043D\u0430\u0434\u043E \u0434\u0430\u0442\u044C \u043E\u0441\u0442\u044B\u0442\u044C,
        \u0437\u0430\u0442\u0435\u043C \u0441\u043B\u0435\u0433\u043A\u0430 \u043D\u0430\u0442\u0435\u0440\u0435\u0442\u044C
        \u043A\u0430\u0436\u0434\u0443\u044E \u0437\u0443\u0431\u0447\u0438\u043A\u043E\u043C
        \u0447\u0435\u0441\u043D\u043E\u043A\u0430. <br>   \u2022\u041D\u0430\u043D\u0435\u0441\u0438\u0442\u0435
        \u043D\u0430 \u0433\u0440\u0435\u043D\u043A\u0438 \u0442\u043E\u043D\u043A\u0443\u044E
        \u043C\u0430\u0439\u043E\u043D\u0435\u0437\u043D\u0443\u044E \u0441\u0435\u0442\u043E\u0447\u043A\u0443.
        <br>   \u2022\u041F\u043E\u0441\u044B\u043F\u044C\u0442\u0435 \u043D\u0430\u0442\u0435\u0440\u0442\u044B\u043C
        \u044F\u0439\u0446\u043E\u043C. <br>   \u2022\u0421\u0432\u0435\u0440\u0445\u0443
        \u043D\u0430 \u044F\u0439\u0446\u043E \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u0435
        \u043B\u043E\u043C\u0442\u0438\u043A\u0438 \u0441\u0432\u0435\u0436\u0435\u0433\u043E
        \u043F\u043E\u043C\u0438\u0434\u043E\u0440\u0430. <br>   \u2022\u041D\u0430
        \u043F\u043E\u043C\u0438\u0434\u043E\u0440 \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u0435
        \u043F\u043E \u043E\u0434\u043D\u043E\u0439 \u043A\u0440\u0443\u043F\u043D\u043E\u0439
        \u0448\u043F\u0440\u043E\u0442\u0438\u043D\u0435. <br>   \u2022\u041A\u0430\u0436\u0434\u044B\u0439
        \u0431\u0443\u0442\u0435\u0440\u0431\u0440\u043E\u0434 \u0441\u043E \u0448\u043F\u0440\u043E\u0442\u0430\u043C\u0438,
        \u044F\u0439\u0446\u043E\u043C \u0438 \u043F\u043E\u043C\u0438\u0434\u043E\u0440\u043E\u043C
        \u0443\u043A\u0440\u0430\u0441\u044C\u0442\u0435 \u043B\u0438\u0441\u0442\u0438\u043A\u043E\u043C
        \u0441\u0432\u0435\u0436\u0435\u0439 \u0437\u0435\u043B\u0435\u043D\u0438. 
        <br>\u2022\u0413\u0440\u0435\u043D\u043A\u0438 \u0441\u043E \u0448\u043F\u0440\u043E\u0442\u0430\u043C\u0438
        \u043F\u043E\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435
        \u0437\u0430\u043A\u0443\u0441\u043A\u0438"
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
        <br>   \u2022\u0411\u0443\u043B\u043E\u0447\u043A\u0438 \u0431\u0443\u0442\u0435\u0440\u0431\u0440\u043E\u0434\u043D\u044B\u0435,
        \u0440\u0436\u0430\u043D\u044B\u0435 \u2013 3, 4 \u0448\u0442 <br>   \u2022\u0428\u043F\u0440\u043E\u0442\u044B
        \u2013 240 \u0433 <br>   \u2022\u042F\u0439\u0446\u0430 \u2013 2-3 \u0448\u0442
        <br>   \u2022\u041F\u043E\u043C\u0438\u0434\u043E\u0440 \u2013 1 \u0448\u0442
        <br>   \u2022\u041C\u0430\u0439\u043E\u043D\u0435\u0437 \u2013 1-2 \u0441\u0442.
        \u043B <br>   \u2022\u0427\u0435\u0441\u043D\u043E\u043A \u2013 1 \u0437\u0443\u0431\u0447\u0438\u043A 
        <br>   \u2022\u0417\u0435\u043B\u0435\u043D\u044C \u2013 \u0434\u043B\u044F
        \u043F\u043E\u0434\u0430\u0447\u0438"
    - FoodImage: {fileID: 21300000, guid: 3a3055f732a825c4a9052a3c28b4b807, type: 3}
      FoodLabel: "\u041A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044C \u043F\u0430\u0439"
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
        <br>   \u2022\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435
        \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B. <br>   \u2022\u041E\u0447\u0438\u0441\u0442\u0438\u0442\u0435
        \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044C. ( \u041F\u041E\u041C\u041E\u0419\u0422\u0415
        \u0415\u0413\u041E) <br>   \u2022\u041D\u0430\u0442\u0440\u0438\u0442\u0435
        \u0435\u0433\u043E \u043D\u0430 \u0442\u0435\u0440\u043A\u0435 \u0434\u043B\u044F
        \u043C\u043E\u0440\u043A\u043E\u0432\u0438 \u043F\u043E-\u043A\u043E\u0440\u0435\u0439\u0441\u043A\u0438.
        <br>   \u2022\u0412\u044B\u043B\u043E\u0436\u0438\u0442\u0435 \u043D\u0430\u0442\u0435\u0440\u0442\u044B\u0439
        \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044C \u0432 \u0434\u0443\u0440\u0448\u043B\u0430\u0433
        \u0438 \u043F\u0440\u043E\u043C\u043E\u0439\u0442\u0435 \u043F\u043E\u0434
        \u043A\u0440\u0430\u043D\u043E\u043C \u043F\u0440\u043E\u0442\u043E\u0447\u043D\u043E\u0439
        \u0432\u043E\u0434\u043E\u0439. \u0414\u0430\u0439\u0442\u0435 \u0441\u0442\u0435\u0447\u044C
        \u043B\u0438\u0448\u043D\u0435\u0439 \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u0438.
        <br>   \u2022\u0417\u0430\u0442\u0435\u043C \u0445\u043E\u0440\u043E\u0448\u043E
        \u043F\u043E\u0441\u043E\u043B\u0438\u0442\u0435 \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044C.
        <br>   \u2022\u041E\u0431\u0436\u0430\u0440\u044C\u0442\u0435 \u0435\u0433\u043E,
        \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044F \u043F\u043E
        \u0447\u0443\u0442\u044C-\u0447\u0443\u0442\u044C \u0432 \u0440\u0430\u0437\u043E\u0433\u0440\u0435\u0442\u043E\u0435
        \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
        \u043C\u0430\u0441\u043B\u043E. <br>   \u2022\u041F\u043E\u0434\u0430\u0432\u0430\u0439\u0442\u0435
        \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044C \u043F\u0430\u0439
        \u0441 \u0432\u0430\u0448\u0438\u043C \u043B\u044E\u0431\u0438\u043C\u044B\u043C
        \u0441\u043E\u0443\u0441\u043E\u043C \u0438\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
        \u0442\u0430\u043A. \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E
        \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430!"
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
        <br>   \u2022\u041A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044C \u2013
        250 \u0433 <br>   \u2022\u041C\u0430\u0441\u043B\u043E \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
        \u2013 150 \u043C\u043B <br>   \u2022\u0421\u043E\u043B\u044C \xBD \u0447.\u043B"
    - FoodImage: {fileID: 21300000, guid: 214d96b02a3b2c54fb83993aabb602f5, type: 3}
      FoodLabel: "\u041E\u0441\u0442\u0440\u044B\u0435 \u0441\u044B\u0440\u043D\u044B\u0435
        \u043F\u0430\u043B\u043E\u0447\u043A\u0438 \u0438\u0437 \u0441\u043B\u043E\u0451\u043D\u043E\u0433\u043E
        \u0442\u0435\u0441\u0442\u0430"
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
        <br>   \u2022\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
        \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B \u0434\u043B\u044F
        \u0441\u044B\u0440\u043D\u044B\u0445 \u043F\u0430\u043B\u043E\u0447\u0435\u043A
        \u0438\u0437 \u0441\u043B\u043E\u0435\u043D\u043E\u0433\u043E \u0442\u0435\u0441\u0442\u0430.
        \u0421\u044B\u0440 \u043D\u0430\u0442\u0435\u0440\u0435\u0442\u044C \u043D\u0430
        \u043A\u0440\u0443\u043F\u043D\u043E\u0439 \u0442\u0435\u0440\u043A\u0435.
        <br>   \u2022\u0422\u043E\u043D\u043A\u043E \u0440\u0430\u0441\u043A\u0430\u0442\u0430\u0442\u044C
        \u0442\u0435\u0441\u0442\u043E. <br>   \u2022\u0420\u0430\u0437\u0440\u0435\u0437\u0430\u0442\u044C
        \u0435\u0433\u043E \u043F\u043E\u043F\u043E\u043B\u0430\u043C. <br>   \u2022\u0421\u043C\u0435\u0448\u0430\u0442\u044C
        \u0432\u0441\u0435 \u043F\u0440\u0438\u043F\u0440\u0430\u0432\u044B \u0438
        \u0441\u043F\u0435\u0446\u0438\u0438. \u0421\u043C\u0430\u0437\u0430\u0442\u044C
        \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u043C
        \u0441\u043E\u0443\u0441\u043E\u043C \u043E\u0434\u043D\u0443 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
        \u0442\u0435\u0441\u0442\u0430. <br>   \u2022\u0421\u0432\u0435\u0440\u0445\u0443
        \u043F\u0440\u0438\u0441\u044B\u043F\u0430\u0442\u044C \u043C\u0435\u043B\u043A\u043E
        \u043D\u0430\u0440\u0435\u0437\u0430\u043D\u043D\u043E\u0439 \u0437\u0435\u043B\u0435\u043D\u044C\u044E.
        <br>   \u2022\u041F\u043E\u0441\u044B\u043F\u0430\u0442\u044C \u0441\u044B\u0440\u043E\u043C.
        <br>   \u2022\u041D\u0430\u043A\u0440\u044B\u0442\u044C \u0441\u0432\u0435\u0440\u0445\u0443
        \u0432\u0442\u043E\u0440\u043E\u0439 \u0447\u0430\u0441\u0442\u044C\u044E
        \u0442\u0435\u0441\u0442\u0430. <br>   \u2022\u041D\u0430\u0440\u0435\u0437\u0430\u0442\u044C
        \u043F\u043E\u043B\u043E\u0441\u043A\u0430\u043C\u0438. <br>   \u2022\u041A\u0430\u0436\u0434\u0443\u044E
        \u043F\u043E\u043B\u043E\u0441\u043A\u0443 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E
        \u0441\u043A\u0440\u0443\u0442\u0438\u0442\u044C. <br>   \u2022\u0412\u044B\u043B\u043E\u0436\u0438\u0442\u044C
        \u043E\u0441\u0442\u0440\u044B\u0435 \u0441\u044B\u0440\u043D\u044B\u0435
        \u043F\u0430\u043B\u043E\u0447\u043A\u0438 \u0438\u0437 \u0441\u043B\u043E\u0435\u043D\u043E\u0433\u043E
        \u0442\u0435\u0441\u0442\u0430 \u043D\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u0435\u043D\u044C.
        \u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u043F\u0440\u043E\u0442\u0438\u0432\u0435\u043D\u044C
        \u0432 \u0440\u0430\u0437\u043E\u0433\u0440\u0435\u0442\u0443\u044E \u0434\u043E
        180 \u0433\u0440\u0430\u0434\u0443\u0441\u043E\u0432 \u0434\u0443\u0445\u043E\u0432\u043A\u0443
        \u043D\u0430 20 \u043C\u0438\u043D\u0443\u0442. <br>   \u2022\u0425\u0440\u0443\u0441\u0442\u044F\u0449\u0438\u0435
        \u0441\u044B\u0440\u043D\u044B\u0435 \u043F\u0430\u043B\u043E\u0447\u043A\u0438
        \u0438\u0437 \u0441\u043B\u043E\u0435\u043D\u043E\u0433\u043E \u0442\u0435\u0441\u0442\u0430
        \u0433\u043E\u0442\u043E\u0432\u044B. <br> \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E
        \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430! <br> \u0413\u043E\u0442\u043E\u0432\u044C\u0442\u0435
        \u0441 \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435\u043C!"
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
        <br>   \u2022\u0422\u0435\u0441\u0442\u043E \u0434\u0440\u043E\u0436\u0436\u0435\u0432\u043E\u0435
        \u0441\u043B\u043E\u0451\u043D\u043E\u0435 \u2013 1 \u043B\u0438\u0441\u0442 
        <br>   \u2022\u0421\u044B\u0440 \u0442\u0432\u0435\u0440\u0434\u044B\u0439
        \u2013 100 \u0433 <br>   \u2022\u0417\u0435\u043B\u0435\u043D\u044C \u0443\u043A\u0440\u043E\u043F\u0430
        \u2013 \u043F\u043E \u0432\u043A\u0443\u0441\u0443 <br>   \u2022\u041C\u0430\u0439\u043E\u043D\u0435\u0437
        \u2013 1 \u0441\u0442. \u043B <br>   \u2022\u0422\u043E\u043C\u0430\u0442\u043D\u0430\u044F
        \u043F\u0430\u0441\u0442\u0430 \u2013 1 \u0441\u0442. \u043B <br>   \u2022\u0413\u043E\u0440\u0447\u0438\u0446\u0430
        1 \u0447. \u041B <br>   \u2022\u041F\u0435\u0440\u0435\u0446 \u0447\u0435\u0440\u043D\u044B\u0439
        \u043C\u043E\u043B\u043E\u0442\u044B\u0439 \u2013 \u043F\u043E \u0432\u043A\u0443\u0441\u0443 
        <br>   \u2022\u041A\u043E\u0440\u0438\u0430\u043D\u0434\u0440 \u2013 \u043F\u043E
        \u0432\u043A\u0443\u0441\u0443 <br>   \u2022\u0421\u043E\u043B\u044C \u2013
        \u043F\u043E \u0432\u043A\u0443\u0441\u0443"
    drankFoods:
    - FoodImage: {fileID: 21300000, guid: 109eb9fea9f460a44aaab44c9b685995, type: 3}
      FoodLabel: "\u0421\u043C\u0443\u0437\u0438 \u0438\u0437 \u044F\u0431\u043B\u043E\u043A,
        \u043A\u043B\u0443\u0431\u043D\u0438\u043A\u0438 \u0438 \u0431\u0430\u043D\u0430\u043D\u0430"
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
        <br>   \u2022\u041E\u0442\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435
        \u0432 \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C \u0444\u0440\u0443\u043A\u0442\u044B
        \u0432\u044B\u043C\u043E\u0439\u0442\u0435 \u0438 \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u0435,
        \u0438\u0437 \u044F\u0431\u043B\u043E\u043A \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u0432\u044B\u0440\u0435\u0436\u044C\u0442\u0435 \u0441\u0435\u0440\u0434\u0446\u0435\u0432\u0438\u043D\u0443.
        \u0411\u0430\u043D\u0430\u043D\u044B \u043D\u0430\u0440\u0435\u0437\u0430\u0435\u043C
        \u043A\u0440\u0443\u0436\u043A\u0430\u043C\u0438, \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u043B\u044C\u043D\u043E\u0439,
        \u043D\u043E \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0442\u043E\u043B\u0449\u0438\u043D\u044B,
        \u044F\u0431\u043B\u043E\u043A\u0438 \u2013 \u043A\u0443\u0431\u0438\u043A\u0430\u043C\u0438,
        \u043D\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u0435\u043B\u043A\u043E.
        <br>   \u2022\u041A\u043B\u0443\u0431\u043D\u0438\u0447\u043A\u0443 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
        \u0441\u043F\u0435\u043B\u0443\u044E \u0438 \u0445\u043E\u0440\u043E\u0448\u043E,
        \u0435\u0441\u043B\u0438 \u043E\u043D\u0430 \u0443 \u0432\u0430\u0441 \u043D\u0435
        \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u043B\u0430\u0434\u043A\u0430\u044F.
        \u041F\u0435\u0440\u0435\u0431\u0435\u0440\u0438\u0442\u0435 \u044F\u0433\u043E\u0434\u043A\u0438
        \u0438 \u0432\u044B\u043C\u043E\u0439\u0442\u0435, \u0442\u043E\u043B\u044C\u043A\u043E
        \u043F\u043E\u0442\u043E\u043C \u043E\u0431\u043E\u0440\u0432\u0438\u0442\u0435
        \u0445\u0432\u043E\u0441\u0442\u0438\u043A\u0438. \u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435
        \u0432 \u043C\u0438\u0441\u043A\u0443 \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u044C\u0442\u0435
        \u043D\u0430 \u0447\u0430\u0441\u043E\u043A \u0432 \u043C\u043E\u0440\u043E\u0437\u0438\u043B\u044C\u043D\u0443\u044E
        \u043A\u0430\u043C\u0435\u0440\u0443. <br>   \u2022\u0425\u043E\u0440\u043E\u0448\u043E
        \u0434\u043B\u044F \u043A\u0440\u0430\u0441\u043E\u0442\u044B \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044F,
        \u0435\u0441\u043B\u0438 \u043B\u0451\u0434 \u0431\u0443\u0434\u0435\u0442
        \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438, \u043F\u043E\u0440\u044F\u0434\u043A\u0430
        \u043F\u043E\u043B\u0443\u0442\u043E\u0440\u0430 \u0441\u0430\u043D\u0442\u0438\u043C\u0435\u0442\u0440\u043E\u0432,
        \u043A\u0443\u0431\u0438\u043A\u0430\u043C\u0438. \u0417\u0430\u043C\u043E\u0440\u0430\u0436\u0438\u0432\u0430\u0435\u043C
        \u0435\u0433\u043E \u0437\u0430\u0433\u043E\u0434\u044F, \u043A\u0443\u0441\u043E\u0447\u043A\u0438
        \u0444\u0440\u0443\u043A\u0442\u043E\u0432 \u0442\u043E\u0436\u0435 \u043F\u043E\u0434\u043C\u043E\u0440\u043E\u0437\u044C\u0442\u0435,
        \u043D\u043E \u043D\u0435 \u0434\u043E \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F
        \u043B\u0435\u0434\u044B\u0448\u0435\u043A. <br>   \u2022\u041D\u0443 \u0438,
        \u043D\u0430\u043A\u043E\u043D\u0435\u0446, \u0431\u043E\u043A\u0430\u043B\u044B.
        \u0423\u043A\u0440\u0430\u0448\u0430\u0442\u044C \u0438\u0445 \u0438\u0437\u043B\u0438\u0448\u043D\u0435,
        \u0432 \u0440\u0430\u0441\u043F\u0438\u0441\u043D\u043E\u043C \u0441\u0442\u0435\u043A\u043B\u0435,
        \u0438 \u0431\u0435\u0437 \u0442\u043E\u0433\u043E \u044F\u0440\u043A\u0438\u0439
        \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C \u0431\u0443\u0434\u0435\u0442
        \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F \u0432\u044B\u0437\u044B\u0432\u0430\u044E\u0449\u0435.
        \u0422\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u0440\u043E\u043C\u043E\u0439\u0442\u0435
        \u0432\u044B\u0441\u043E\u043A\u0438\u0435 \u0441\u0442\u0430\u043A\u0430\u043D\u044B,
        \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E 350-\u043C\u0438\u043B\u043B\u0438\u043B\u0438\u0442\u0440\u043E\u0432\u043E\u0433\u043E
        \u043E\u0431\u044A\u0451\u043C\u0430, \u043E\u0431\u043E\u0442\u0440\u0438\u0442\u0435
        \u0438\u2026 \u0442\u043E\u0436\u0435 \u043E\u0445\u043B\u0430\u0434\u0438\u0442\u0435.
        <br>   \u2022\u0421\u043E\u0431\u0438\u0440\u0430\u0435\u043C \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C
        \u0431\u044B\u0441\u0442\u0440\u043E, \u043D\u0435 \u0434\u0430\u0432\u0430\u044F
        \u0441\u043E\u0433\u0440\u0435\u0432\u0430\u0442\u044C\u0441\u044F \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0430\u043C.
        \u042F\u0431\u043B\u043E\u043A\u0438 \u0432\u044B\u043D\u0438\u043C\u0430\u0435\u043C
        \u0438\u0437 \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A\u0430,
        \u0441\u043A\u0430\u043B\u044B\u0432\u0430\u0435\u043C \u0432 \u0431\u043B\u0435\u043D\u0434\u0435\u0440
        \u0438 \u0431\u044B\u0441\u0442\u0440\u043E \u0440\u0430\u0441\u0442\u0438\u0440\u0430\u0435\u043C.
        \u0420\u0430\u0437\u043B\u0438\u0432\u0430\u0435\u043C \u043F\u043E \u0441\u0442\u0430\u043A\u0430\u043D\u0430\u043C,
        \u043A\u043B\u0430\u0434\u0451\u043C \u043F\u043E \u043B\u043E\u0436\u0435\u0447\u043A\u0435
        \u0441\u0433\u0443\u0449\u0451\u043D\u043A\u0438 \u0438 \u043F\u0430\u0440\u0443
        \u043A\u0443\u0431\u0438\u043A\u043E\u0432 \u043B\u044C\u0434\u0430. <br>  
        \u2022\u0427\u0430\u0448\u0443 \u0431\u043B\u0435\u043D\u0434\u0435\u0440\u0430
        \u043E\u043F\u043E\u043B\u0430\u0441\u043A\u0438\u0432\u0430\u0435\u043C
        \u0438 \u0432\u044B\u0442\u0440\u044F\u0445\u0438\u0432\u0430\u0435\u043C
        \u043A\u0430\u043F\u0435\u043B\u044C\u043A\u0438 \u0432\u043E\u0434\u044B,
        \u0432\u0441\u044B\u043F\u0430\u0435\u043C \u0438 \u0440\u0430\u0441\u0442\u0438\u0440\u0430\u0435\u043C
        \u043D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u043A\u043B\u0443\u0431\u043D\u0438\u043A\u0443.
        \u041E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u043C \u044F\u0433\u043E\u0434\u043D\u044B\u0439
        \u0441\u043B\u043E\u0439 \u043A \u044F\u0431\u043B\u043E\u0447\u043D\u043E\u043C\u0443,
        \u0442\u043E\u0436\u0435 \u043F\u043E\u0434\u043B\u0438\u0432 \u0441\u0433\u0443\u0449\u0451\u043D\u043A\u0443,
        \u043D\u043E \u043B\u044C\u0434\u0430 \u043A\u043B\u0430\u0434\u0451\u043C
        \u0432\u0434\u0432\u043E\u0435 \u0431\u043E\u043B\u044C\u0448\u0435. <br>  
        \u2022\u0421 \u0431\u0430\u043D\u0430\u043D\u0430\u043C\u0438 \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u0435\u043C
        \u0430\u043D\u0430\u043B\u043E\u0433\u0438\u0447\u043D\u043E \u043A\u043B\u0443\u0431\u043D\u0438\u043A\u0435,
        \u0442\u0430\u043A \u0436\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u043C
        \u043A\u0443\u0431\u0438\u043A\u0438 \u043B\u044C\u0434\u0430 \u0438 \u0441\u0433\u0443\u0449\u0451\u043D\u043D\u043E\u0435
        \u043C\u043E\u043B\u043E\u043A\u043E. \u041A\u043E\u043A\u0442\u0435\u0439\u043B\u044C
        \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u0434\u0430\u0432\u0430\u0439\u0442\u0435,
        \u043E\u043D \u0440\u043E\u0441\u043A\u043E\u0448\u043D\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0441\u044F
        \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0440\u0430\u0437\u043D\u043E\u0446\u0432\u0435\u0442\u043D\u044B\u043C
        \u0441\u043B\u043E\u044F\u043C, \u043F\u0440\u0438\u044F\u0442\u0435\u043D
        \u0438 \u043B\u0451\u0433\u043E\u043A \u043D\u0430 \u0432\u043A\u0443\u0441. "
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
        <br>   \u2022\u0411\u043E\u043B\u044C\u0448\u043E\u0435 \u0441\u043E\u0447\u043D\u043E\u0435
        \u044F\u0431\u043B\u043E\u043A\u043E \u2013 1\u0448\u0442 <br>   \u2022\u0421\u0433\u0443\u0449\u0451\u043D\u043A\u0430
        \u2013 6 \u0447. \u041B <br>   \u2022\u041B\u0451\u0434 (\u0434\u043B\u044F
        \u043E\u0441\u0432\u0435\u0436\u0430\u044E\u0449\u0435\u0433\u043E \u044D\u0444\u0435\u043A\u0442\u0430)
        <br>   \u2022\u0411\u0430\u043D\u0430\u043D \u2013 3\u0448\u0442 <br>   \u2022\u041A\u043B\u0443\u0431\u043D\u0438\u043A\u0430
        \u2013 200 \u0433"
    - FoodImage: {fileID: 21300000, guid: 33c5668407bda344a800be83b97146b7, type: 3}
      FoodLabel: "\u0411\u0435\u0437\u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044C\u043D\u044B\u0439
        \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C \u201C\u041C\u043E\u0445\u0438\u0442\u043E\u201D"
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:
        \u2022\u0412\u044B\u043C\u044B\u0442\u044C \u043B\u0430\u0439\u043C, \u0440\u0430\u0437\u0440\u0435\u0437\u0430\u0442\u044C
        \u043F\u043E\u043F\u043E\u043B\u0430\u043C \u0432\u0434\u043E\u043B\u044C,
        \u0437\u0430\u0442\u0435\u043C \u043A\u0430\u0436\u0434\u0443\u044E \u0447\u0430\u0441\u0442\u044C
        \u0435\u0449\u0435 \u043D\u0430 \u0442\u0440\u0438 \u0434\u043E\u043B\u044C\u043A\u0438.
        \u041C\u044F\u0442\u0443 \u043F\u0440\u043E\u043C\u044B\u0432\u0430\u0435\u043C,
        \u0434\u0435\u043B\u0438\u043C \u043F\u043E\u043F\u043E\u043B\u0430\u043C.
        \u0412\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u043C \u0432
        \u043A\u0430\u0436\u0434\u044B\u0439 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
        \u0431\u043E\u043A\u0430\u043B \u043F\u043E \u0442\u0440\u0438 \u0434\u043E\u043B\u044C\u043A\u0438
        \u043B\u0430\u0439\u043C\u0430 \u0438 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435
        \u043C\u044F\u0442\u044B. \u2022\u041D\u0430\u0441\u044B\u043F\u0430\u0435\u043C
        \u043F\u043E \u0441\u0442\u043E\u043B\u043E\u0432\u043E\u0439 \u043B\u043E\u0436\u043A\u0435
        \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u043E\u0433\u043E \u0441\u0430\u0445\u0430\u0440\u0430
        \u043D\u0430 \u043F\u043E\u0440\u0446\u0438\u044E. \u0411\u0435\u0440\u0435\u043C
        \u043F\u0435\u0441\u0442\u0438\u043A \u0438 \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E
        \u0440\u0430\u0437\u043C\u0438\u043D\u0430\u0435\u043C \u043B\u0430\u0439\u043C
        \u0441 \u043C\u044F\u0442\u043E\u0439 \u0438 \u0441\u0430\u0445\u0430\u0440\u043E\u043C.
        \u041D\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u0432\u044B\u043F\u0443\u0441\u0442\u0438\u0442\u044C
        \u0430\u0440\u043E\u043C\u0430\u0442\u043D\u044B\u0435 \u044D\u0444\u0438\u0440\u044B
        \u0438 \u0432\u044B\u0434\u0430\u0432\u0438\u0442\u044C \u0441\u043E\u043A.
        \u0415\u0441\u043B\u0438 \u044D\u0442\u043E\u0433\u043E \u043D\u0435 \u0441\u0434\u0435\u043B\u0430\u0442\u044C,
        \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F \u043D\u0435 \u043E\u0447\u0435\u043D\u044C
        \u0432\u043A\u0443\u0441\u043D\u044B\u0439 \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C.
        \u2022\u0414\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u043C \u0432 \u043A\u0430\u0436\u0434\u044B\u0439
        \u0441\u0442\u0430\u043A\u0430\u043D \u0440\u0443\u0431\u043B\u0435\u043D\u044B\u0439
        \u043B\u0435\u0434, \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u0435\u043B\u0438\u043C
        \u0435\u0433\u043E \u043F\u043E\u043F\u043E\u043B\u0430\u043C. \u0421\u043B\u0435\u0434\u043E\u043C
        \u0437\u0430\u043B\u0438\u0432\u0430\u0435\u043C \u043E\u0445\u043B\u0430\u0436\u0434\u0435\u043D\u043D\u044B\u0439
        \u043B\u0438\u043C\u043E\u043D\u0430\u0434. \u041E\u0441\u0442\u0430\u0435\u0442\u0441\u044F
        \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043E\u0442\u043A\u043D\u0443\u0442\u044C
        \u0441\u0438\u043C\u043F\u0430\u0442\u0438\u0447\u043D\u0443\u044E \u0442\u0440\u0443\u0431\u043E\u0447\u043A\u0443,
        \u0442\u043E\u0447\u043D\u0435\u0435 \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E
        \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442
        \u0434\u0432\u0435 \u0448\u0442\u0443\u043A\u0438. \u0423\u043A\u0440\u0430\u0448\u0430\u044E\u0442
        \xAB\u041C\u043E\u0445\u0438\u0442\u043E\xBB \u0434\u043E\u043B\u044C\u043A\u043E\u0439
        \u043B\u0430\u0439\u043C\u0430. \u0418\u043D\u043E\u0433\u0434\u0430 \u0434\u043B\u044F
        \u0434\u0435\u043A\u043E\u0440\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442
        \u0441\u0443\u0448\u0435\u043D\u044B\u0439 \u043A\u0440\u0443\u0436\u043E\u043A
        \u0446\u0438\u0442\u0440\u0443\u0441\u0430. \u2022\u0415\u0441\u043B\u0438
        \u0432\u043C\u0435\u0441\u0442\u043E \u043B\u0430\u0439\u043C\u0430 \u0431\u0443\u0434\u0435\u0442
        \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
        \u043B\u0438\u043C\u043E\u043D, \u0442\u043E \u0435\u0433\u043E \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
        \u043C\u043E\u0436\u043D\u043E \u0441\u043E\u043A\u0440\u0430\u0442\u0438\u0442\u044C
        \u0438\u0437-\u0437\u0430 \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043A\u0438\u0441\u043B\u043E\u0442\u043D\u043E\u0441\u0442\u0438
        \u0438 \u0431\u043E\u043B\u044C\u0448\u0438\u0445 \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u0432. "
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
        <br>   \u2022\u041B\u0430\u0439\u043C \u2013 1\u0448\u0442 <br>   \u2022\u041B\u0438\u043C\u043E\u043D\u0430\u0434
        (\u0436\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0441\u043E
        \u0432\u043A\u0443\u0441\u043E\u043C \u043C\u043E\u0445\u0438\u0442\u043E
        \u0438\u043B\u0438 \u0441\u043F\u0440\u0430\u0439\u0442) \u2013 500\u043C\u043B
        <br>   \u2022\u041B\u0451\u0434 \u2013 150 \u0433 <br>   \u2022\u041A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u0439
        \u0441\u0430\u0445\u0430\u0440 \u2013 2 \u0441\u0442. \u043B (2 \u043A\u0443\u0431\u0438\u043A\u0430)
        <br>   \u2022\u041C\u044F\u0442\u0430 \u2013 25 \u0433 "
    - FoodImage: {fileID: 21300000, guid: b68cc6f97ea28ab48b85fb672ad6cf67, type: 3}
      FoodLabel: "\u0411\u0435\u0437\u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044C\u043D\u044B\u0439
        \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C \xAB\u041F\u0438\u043D\u0430
        \u043A\u043E\u043B\u0430\u0434\u0430\xBB"
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
        <br>   \u2022\u042D\u0442\u043E\u0442 \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C
        \u043C\u043E\u0436\u043D\u043E \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
        \u0432 \u0448\u0435\u0439\u043A\u0435\u0440\u0435 \u043B\u0438\u0431\u043E
        \u0432 \u0431\u043B\u0435\u043D\u0434\u0435\u0440\u0435. \u041F\u0435\u0440\u0432\u044B\u0439
        \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
        \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u044B\u043C,
        \u0438\u043C\u0435\u043D\u043D\u043E \u043F\u0440\u0438 \u043F\u043E\u043C\u043E\u0449\u0438
        \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
        \u0441\u0442\u0430\u043A\u0430\u043D\u0430 \u043F\u0440\u0438\u043D\u044F\u0442\u043E
        \u0441\u043C\u0435\u0448\u0438\u0432\u0430\u0442\u044C \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B
        \u043D\u0430\u043F\u0438\u0442\u043A\u0430. \u041D\u043E \u0431\u043B\u0435\u043D\u0434\u0435\u0440
        \u0434\u0430\u0435\u0442 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \xAB\u043F\u044B\u0448\u043D\u0443\u044E\xBB
        \u043A\u043E\u043D\u0441\u0438\u0441\u0442\u0435\u043D\u0446\u0438\u044E,
        \u0447\u0442\u043E \u0442\u0430\u043A\u0436\u0435 \u0434\u0430\u0435\u0442
        \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0439 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442.
        \u041D\u0430 \u043F\u0435\u0440\u0432\u043E\u043C \u044D\u0442\u0430\u043F\u0435
        \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u043C \u0441\u0430\u0445\u0430\u0440\u043D\u044B\u0439
        \u0441\u0438\u0440\u043E\u043F \u0441\u043E \u0441\u043B\u0438\u0432\u043A\u0430\u043C\u0438
        \u0438 \u0430\u043D\u0430\u043D\u0430\u0441\u043E\u0432\u044B\u043C \u0441\u043E\u043A\u043E\u043C.
        \u0412\u0437\u0431\u0438\u0432\u0430\u0435\u043C. <br>   \u2022\u0414\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u043C
        \u0434\u0440\u043E\u0431\u043B\u0435\u043D\u044B\u0439 \u043B\u0435\u0434.
        \u0412\u0437\u0431\u0438\u0432\u0430\u0435\u043C \u0432\u043C\u0435\u0441\u0442\u0435.
        \u0414\u043E\u0431\u0438\u0432\u0430\u0435\u043C\u0441\u044F \u043F\u043B\u043E\u0442\u043D\u043E\u0439
        \u043E\u0434\u043D\u043E\u0440\u043E\u0434\u043D\u043E\u0441\u0442\u0438
        \u0438 \u0441\u0440\u0430\u0437\u0443 \u0436\u0435 \u043F\u0435\u0440\u0435\u043B\u0438\u0432\u0430\u0435\u043C
        \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C \u0432 \u0441\u0442\u0430\u043A\u0430\u043D.
        \u0412\u0442\u044B\u043A\u0430\u0435\u043C \u0442\u0440\u0443\u0431\u043E\u0447\u043A\u0443,
        \u0434\u0435\u043A\u043E\u0440\u0438\u0440\u0443\u0435\u043C \u043A\u0443\u0441\u043E\u0447\u043A\u043E\u043C
        \u0430\u043D\u0430\u043D\u0430\u0441\u0430. \u0425\u043E\u0442\u044F, \u043B\u0438\u0441\u0442\u043E\u0447\u0435\u043A
        \u043C\u044F\u0442\u044B \u0438\u043B\u0438 \u043B\u043E\u043C\u0442\u0438\u043A
        \u043B\u0430\u0439\u043C\u0430 \u0432 \u044D\u0442\u043E\u043C \u0442\u0440\u043E\u043F\u0438\u0447\u0435\u0441\u043A\u043E\u043C
        \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u0435 \u0442\u043E\u0436\u0435
        \u0447\u0430\u0441\u0442\u044B\u0435 \u0433\u043E\u0441\u0442\u0438. <br>  
        \u2022\u041E\u0447\u0435\u043D\u044C \u0447\u0430\u0441\u0442\u043E \u0432\u043C\u0435\u0441\u0442\u043E
        \u043D\u0430\u0442\u0443\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E
        \u0441\u043E\u043A\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442
        \u0441\u0438\u0440\u043E\u043F \u043E\u0442 \u043A\u043E\u043D\u0441\u0435\u0440\u0432\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445
        \u0430\u043D\u0430\u043D\u0430\u0441\u043E\u0432. \u042D\u0442\u043E \u043C\u043E\u0436\u043D\u043E
        \u0434\u0435\u043B\u0430\u0442\u044C, \u043D\u043E \u043D\u0430\u043F\u0438\u0442\u043E\u043A
        \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C
        \u0441\u043B\u0430\u0434\u043A\u0438\u043C, \u043C\u043E\u0436\u043D\u043E
        \u0432\u0432\u0435\u0441\u0442\u0438 \u0431\u043E\u043B\u044C\u0448\u0435
        \u043B\u044C\u0434\u0430 \u043B\u0438\u0431\u043E \u0441\u043E\u043A\u0440\u0430\u0442\u0438\u0442\u044C
        \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0440\u0435\u0446\u0435\u043F\u0442\u0443\u0440\u043D\u043E\u0433\u043E
        \u0441\u0430\u0445\u0430\u0440\u043D\u043E\u0433\u043E \u0441\u0438\u0440\u043E\u043F\u0430. "
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
        <br>   \u2022\u041A\u043E\u043A\u043E\u0441\u043E\u0432\u044B\u0435 \u0441\u043B\u0438\u0432\u043A\u0438
        \u2013 50\u043C\u043B <br>   \u2022\u0414\u0440\u043E\u0431\u043B\u0451\u043D\u044B\u0439
        \u043B\u0451\u0434 \u2013 70 \u0433 <br>   \u2022\u0421\u0430\u0445\u0430\u0440\u043D\u044B\u0439
        \u0441\u0438\u0440\u043E\u043F \u2013 20 \u043C\u043B <br>   \u2022\u0410\u043D\u0430\u043D\u0430\u0441\u043E\u0432\u044B\u0439
        \u0441\u043E\u043A \u2013 100 \u043C\u043B"
    - FoodImage: {fileID: 21300000, guid: 01b94acf407292b4081c11d4412dac00, type: 3}
      FoodLabel: "\u0411\u0430\u043D\u0430\u043D\u043E\u0432\u043E\u0433\u043E \u043C\u043E\u043B\u043E\u0447\u043D\u044B\u0439
        \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C "
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
        <br>   \u2022\u0421\u043D\u0438\u043C\u0438\u0442\u0435 \u043A\u043E\u0436\u0443\u0440\u0443
        \u0441 \u0431\u0430\u043D\u0430\u043D\u0430. \u041D\u0430\u0440\u0435\u0436\u044C\u0442\u0435
        \u0435\u0433\u043E \u043A\u0440\u0443\u0436\u043E\u0447\u043A\u0430\u043C\u0438,
        \u0441\u043B\u043E\u0436\u0438\u0442\u0435 \u0432 \u0447\u0430\u0448\u0443
        \u0431\u043B\u0435\u043D\u0434\u0435\u0440\u0430. \u0414\u043B\u044F \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F
        \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044F \u043C\u043E\u0436\u043D\u043E
        \u0431\u0440\u0430\u0442\u044C \u0434\u0430\u0436\u0435 \u043F\u0435\u0440\u0435\u0441\u043F\u0435\u0432\u0448\u0438\u0435
        \u0444\u0440\u0443\u043A\u0442\u044B. \u041C\u044F\u0433\u043A\u0438\u0435
        \u0431\u0430\u043D\u0430\u043D\u044B \u043F\u0440\u0438\u0434\u0430\u0434\u0443\u0442
        \u043D\u0430\u043F\u0438\u0442\u043A\u0443 \u043E\u0441\u043E\u0431\u0443\u044E
        \u043A\u043E\u043D\u0441\u0438\u0441\u0442\u0435\u043D\u0446\u0438\u044E
        \u0438 \u043D\u0435\u0436\u043D\u044B\u0439 \u0432\u043A\u0443\u0441. <br>  
        \u2022\u041F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u0435 \u0431\u0430\u043D\u0430\u043D\u043E\u0432\u0443\u044E
        \u043C\u044F\u043A\u043E\u0442\u044C \u0432 \u043F\u044E\u0440\u0435. \u041C\u043E\u0440\u043E\u0436\u0435\u043D\u043E\u0435
        \u043D\u0430\u0440\u0435\u0436\u044C\u0442\u0435 \u043A\u0443\u0441\u043E\u0447\u043A\u0430\u043C\u0438,
        \u0434\u043E\u0431\u0430\u0432\u044C\u0442\u0435 \u0435\u0433\u043E \u0432
        \u0447\u0430\u0448\u0443 \u0431\u043B\u0435\u043D\u0434\u0435\u0440\u0430.
        \u0412\u0437\u0431\u0435\u0439\u0442\u0435 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B
        \u0434\u043E \u043E\u0434\u043D\u043E\u0440\u043E\u0434\u043D\u043E\u0433\u043E
        \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F. <br>   \u2022\u0417\u0430\u043B\u0435\u0439\u0442\u0435
        \u0431\u0430\u043D\u0430\u043D\u044B \u0438 \u043C\u043E\u0440\u043E\u0436\u0435\u043D\u043E\u0435
        \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u043C \u043C\u043E\u043B\u043E\u043A\u043E\u043C.
        \u0421\u043D\u043E\u0432\u0430 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u0439\u0442\u0435
        \u0441\u043C\u0435\u0441\u044C \u0431\u043B\u0435\u043D\u0434\u0435\u0440\u043E\u043C.
        \u041D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u043D\u0443\u0436\u043D\u043E
        \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E
        \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
        \u0447\u0442\u043E\u0431\u044B \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C
        \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0441\u044F \u043E\u0434\u043D\u043E\u0440\u043E\u0434\u043D\u044B\u043C
        \u043F\u043E \u043A\u043E\u043D\u0441\u0438\u0441\u0442\u0435\u043D\u0446\u0438\u0438.
        <br>   \u2022\u0420\u0430\u0437\u043B\u0435\u0439\u0442\u0435 \u043D\u0430\u043F\u0438\u0442\u043E\u043A
        \u043F\u043E \u0441\u0442\u0435\u043A\u043B\u044F\u043D\u043D\u044B\u043C
        \u0431\u043E\u043A\u0430\u043B\u0430\u043C, \u0443\u043A\u0440\u0430\u0441\u044C\u0442\u0435
        \u043A\u0440\u0443\u0436\u043E\u0447\u043A\u043E\u043C \u0431\u0430\u043D\u0430\u043D\u0430
        \u043A\u0430\u0436\u0434\u0443\u044E \u043F\u043E\u0440\u0446\u0438\u044E.
        \u041C\u043E\u0436\u043D\u043E \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u043F\u043E\u0441\u044B\u043F\u0430\u0442\u044C \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C
        \u0442\u0435\u0440\u0442\u044B\u043C \u0448\u043E\u043A\u043E\u043B\u0430\u0434\u043E\u043C,
        \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0449\u0435\u043F\u043E\u0442\u043A\u0443
        \u043A\u043E\u0440\u0438\u0446\u044B. "
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
        <br>   \u2022\u0411\u0430\u043D\u0430\u043D \u2013 1 \u0448\u0442 <br>  
        \u2022\u041C\u043E\u043B\u043E\u043A\u043E \u2013 400 \u043C\u043B <br>  
        \u2022\u041C\u043E\u0440\u043E\u0436\u0435\u043D\u043E\u0435 \u2013 200 \u0433"
    - FoodImage: {fileID: 21300000, guid: ad3294f2575316b49844985bbc7dd0ec, type: 3}
      FoodLabel: "\u0411\u0435\u0437\u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044C\u043D\u044B\u0439
        \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C \u0441 \u043C\u043E\u0440\u043E\u0436\u0435\u043D\u044B\u043C
        \u0438 \u043A\u043B\u0443\u0431\u043D\u0438\u043A\u043E\u0439"
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
        <br>   \u2022\u0412\u044B\u043C\u044B\u0442\u044C \u043A\u043B\u0443\u0431\u043D\u0438\u043A\u0443,
        \u0432\u044B\u0441\u044B\u043F\u0430\u0442\u044C \u0432 \u0431\u043B\u0435\u043D\u0434\u0435\u0440.
        \u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u043C\u043E\u0440\u043E\u0436\u0435\u043D\u043E\u0435.
        \u041C\u043E\u0436\u043D\u043E \u0432\u0437\u044F\u0442\u044C \u043F\u043B\u043E\u043C\u0431\u0438\u0440
        \u0432 \u0431\u0440\u0438\u043A\u0435\u0442\u0430\u0445 \u0438\u043B\u0438
        \u0441\u0442\u0430\u043A\u0430\u043D\u0447\u0438\u043A\u0438, \u043F\u043E\u0434\u043E\u0439\u0434\u0435\u0442
        \u043C\u043E\u0440\u043E\u0436\u0435\u043D\u043E\u0435 \u0438 \u0441 \u0432\u043A\u0443\u0441\u043E\u0432\u044B\u043C\u0438
        \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044F\u043C\u0438,
        \u043D\u043E \u0431\u0435\u0437 \u043E\u0440\u0435\u0445\u043E\u0432 \u0438
        \u0433\u043B\u0430\u0437\u0443\u0440\u0438, \u0442\u0430\u043A\u0438\u0435
        \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B \u043F\u043B\u043E\u0445\u043E
        \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u044E\u0442\u0441\u044F, \u043D\u0435
        \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044F\u044E\u0442\u0441\u044F,
        \u043D\u0430 \u0434\u043D\u0435 \u0441\u0442\u0430\u043A\u0430\u043D\u043E\u0432
        \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442\u0441\u044F \u043E\u0441\u0430\u0434\u043E\u043A.
        \u041D\u0435 \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u043C
        \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A, \u0430 \u0440\u0435\u0436\u0435\u043C
        \u043D\u0430 \u043A\u0443\u0441\u043E\u0447\u043A\u0438. \u0412\u0432\u043E\u0434\u0438\u043C
        \u0441\u0430\u0445\u0430\u0440 \u0438 \u043C\u043E\u043B\u043E\u043A\u043E.
        <br>   \u2022\u041F\u043E\u0433\u0440\u0443\u0436\u0430\u0435\u043C \u0431\u043B\u0435\u043D\u0434\u0435\u0440,
        \u0432\u0437\u0431\u0438\u0432\u0430\u0435\u043C \u0432\u0441\u0435 \u0440\u0435\u0446\u0435\u043F\u0442\u0443\u0440\u043D\u044B\u0435
        \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B \u0440\u043E\u0432\u043D\u043E
        \u043C\u0438\u043D\u0443\u0442\u0443. \u0411\u043E\u043B\u044C\u0448\u0435
        \u0438\u0437\u043C\u0435\u043B\u044C\u0447\u0430\u0442\u044C \u043D\u0435\u0436\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
        \u0442\u0430\u043A \u043A\u0430\u043A \u0441\u043C\u0435\u0441\u044C \u043D\u0430\u0433\u0440\u0435\u0432\u0430\u0435\u0442\u0441\u044F,
        \u043C\u043E\u0440\u043E\u0436\u0435\u043D\u043E\u0435 \u043D\u0430\u0447\u043D\u0435\u0442
        \u0431\u044B\u0441\u0442\u0440\u043E \u0442\u0430\u044F\u0442\u044C. \u041F\u0435\u0440\u0435\u043B\u0438\u0432\u0430\u0435\u043C
        \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u044B\u0439 \u043D\u0430\u043F\u0438\u0442\u043E\u043A
        \u0432 \u0441\u0442\u0430\u043A\u0430\u043D, \u0432\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u043C
        \u0442\u0440\u0443\u0431\u043E\u0447\u043A\u0443 \u0438 \u0441\u0440\u0430\u0437\u0443
        \u0436\u0435 \u043F\u0440\u043E\u0431\u0443\u0435\u043C. <br>   \u2022\u042D\u0442\u043E
        \u0431\u0430\u0437\u043E\u0432\u044B\u0439 \u0440\u0435\u0446\u0435\u043F\u0442
        \u043D\u0430\u043F\u0438\u0442\u043A\u0430. \u041F\u043E \u0436\u0435\u043B\u0430\u043D\u0438\u044E
        \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u043C \u0432 \u043D\u0435\u0433\u043E
        \u0432\u0430\u043D\u0438\u043B\u0438\u043D, \u043C\u043E\u0436\u043D\u043E
        \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C \u043A\u043B\u0443\u0431\u043D\u0438\u043A\u0443
        \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u043C\u044F\u0433\u043A\u0438\u043C\u0438
        \u044F\u0433\u043E\u0434\u0430\u043C\u0438 \u0438\u043B\u0438 \u0432\u043C\u0435\u0441\u0442\u043E
        \u043C\u043E\u043B\u043E\u043A\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
        \u043B\u044E\u0431\u043E\u0439 \u0441\u043E\u043A. \u0415\u0441\u043B\u0438
        \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F
        \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0433\u0443\u0441\u0442\u043E\u0439
        \u0438\u043B\u0438 \u0441\u043B\u0430\u0434\u043A\u0438\u0439, \u0442\u043E
        \u0432 \u043D\u0435\u0433\u043E \u0432\u0441\u0435\u0433\u0434\u0430 \u043C\u043E\u0436\u043D\u043E
        \u043A\u0438\u043D\u0443\u0442\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u043A\u0443\u0431\u0438\u043A\u043E\u0432 \u043B\u044C\u0434\u0430. "
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
        <br>   \u2022\u041C\u043E\u0440\u043E\u0436\u0435\u043D\u043E\u0435 \u2013
        70 \u0433 <br>   \u2022\u041C\u043E\u043B\u043E\u043A\u043E \u2013 150 \u043C\u043B
        <br>   \u2022\u041A\u043B\u0443\u0431\u043D\u0438\u043A\u0430 \u2013 100
        \u0433 <br>   \u2022\u0421\u0430\u0445\u0430\u0440 \u2013 1 \u0441\u0442.
        \u043B"
