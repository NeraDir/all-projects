--- !u!114 &1518172324
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1518172323}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 850d0cee71c25f74982dfb18160cec82, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  GoodFoods:
    Name: "\u041F\u041E\u041B\u0415\u0417\u041D\u041E\u0415"
    mainFoods:
    - FoodImage: {fileID: 21300000, guid: f6e472fcded31de4582c5031a38ecc53, type: 3}
      FoodLabel: "\u0424\u043E\u0440\u0435\u043B\u044C (\u0441\u0451\u043C\u0433\u0430)
        \u0437\u0430\u043F\u0435\u0447\u0435\u043D\u0430\u044F "
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>  
        1.\u041F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0444\u043E\u0440\u0435\u043B\u044C,
        \u043F\u043E\u043C\u044B\u0442\u044C, \u043F\u043E\u0441\u043E\u043B\u0438\u0442\u044C.<br>  
        2. \u0421\u043C\u0435\u0448\u0430\u0442\u044C \u043A\u0435\u0444\u0438\u0440
        \u0441 \u043F\u0440\u0438\u043F\u0440\u0430\u0432\u0430\u043C\u0438. \u041A\u0443\u0441\u043E\u0447\u043A\u0438
        \u0440\u044B\u0431\u044B \u043F\u0435\u0440\u0435\u043B\u043E\u0436\u0438\u0442\u044C
        \u043B\u0430\u0432\u0440\u043E\u0432\u044B\u043C \u043B\u0438\u0441\u0442\u043E\u043C
        \u0438 \u0437\u0430\u043B\u0438\u0442\u044C \u043A\u0435\u0444\u0438\u0440\u043E\u043C
        \u0441 \u043F\u0440\u0438\u043F\u0440\u0430\u0432\u0430\u043C\u0438. \u041F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
        \u0432 \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A
        \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u043E\u0432
        \u0438\u043B\u0438 \u043D\u0430 \u043D\u043E\u0447\u044C.<br>   3. \u041F\u043E\u0440\u0435\u0437\u0430\u0442\u044C
        \u043B\u0443\u043A \u0441\u043E\u043B\u043E\u043C\u043A\u043E\u0439 \u0438
        \u0432\u044B\u0441\u044B\u043F\u0430\u0442\u044C \u043D\u0430 \u0441\u043C\u0430\u0437\u0430\u043D\u043D\u0443\u044E
        \u043C\u0430\u0441\u043B\u043E\u043C \u0444\u043E\u0440\u043C\u0443. \u041F\u0440\u0438\u0441\u044B\u043F\u0430\u0442\u044C
        \u0447\u0435\u0440\u043D\u044B\u043C \u043F\u0435\u0440\u0446\u043E\u043C.<br>  
        4. \u0421\u0432\u0435\u0440\u0445\u0443 \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u043C
        \u0444\u043E\u0440\u0435\u043B\u044C. \u042F \u0440\u044F\u0434\u044B\u0448\u043A\u043E\u043C
        \u0443\u043B\u043E\u0436\u0438\u043B\u0438 \u043A\u0430\u0440\u0442\u043E\u0448\u043A\u0443,
        \u043D\u043E \u044D\u0442\u043E \u043F\u043E \u0436\u0435\u043B\u0430\u043D\u0438\u044E.
        \u0418 \u0437\u0430\u043B\u0438\u0442\u044C \u0432\u0441\u0435 \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u043C\u0441\u044F
        \u043C\u0430\u0440\u0438\u043D\u0430\u0434\u043E\u043C.<br>   5. \u041F\u0440\u0438\u043A\u0440\u044B\u0442\u044C
        \u0444\u043E\u0440\u043C\u0443 \u0444\u043E\u043B\u044C\u0433\u043E\u0439
        \u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432 \u0440\u0430\u0437\u043E\u0433\u0440\u0435\u0442\u0443\u044E
        \u0434\u0443\u0445\u043E\u0432\u043A\u0443. \u0417\u0430\u043F\u0435\u043A\u0430\u0442\u044C
        \u043C\u0438\u043D\u0443\u0442 40 \u043F\u0440\u0438 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0435
        180-200 \u0433\u0440\u0430\u0434\u0443\u0441\u043E\u0432.<br>   6. \u0417\u0430\u0442\u0435\u043C
        \u0441\u043D\u044F\u0442\u044C \u0444\u043E\u043B\u044C\u0433\u0443 \u0438
        \u0434\u0430\u0442\u044C \u043F\u043E\u0434\u0440\u0443\u043C\u044F\u043D\u0438\u0442\u044C\u0441\u044F.<br>  
        7. \u0424\u043E\u0440\u0435\u043B\u044C \u0437\u0430\u043F\u0435\u0447\u0435\u043D\u043D\u0430\u044F
        \u0433\u043E\u0442\u043E\u0432\u0430. \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E
        \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430!!! "
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>  
        \u2022\u0441\u0442\u0435\u0439\u043A\u0438 \u0444\u043E\u0440\u0435\u043B\u0438
        (\u0441\u0451\u043C\u0433\u0438)<br>   \u20221 \u0431\u043E\u043B\u044C\u0448\u0430\u044F
        \u043B\u0443\u043A\u043E\u0432\u0438\u0446\u0430<br>   \u2022\u0421\u043E\u043B\u044C<br>  
        \u2022\u0427\u0435\u0440\u043D\u044B\u0439 \u043F\u0435\u0440\u0435\u0446<br><br>\u041C\u0430\u0440\u0438\u043D\u0430\u0434:<br>  
        \u2022500 \u043C\u043B \u043A\u0435\u0444\u0438\u0440\u0430<br>   \u2022\u041F\u0440\u0438\u043F\u0440\u0430\u0432\u044B
        (\u043C\u043E\u0436\u043D\u043E \u043A\u0443\u043F\u0438\u0442\u044C \u0433\u043E\u0442\u043E\u0432\u044B\u0435,
        \u043C\u043E\u0436\u043D\u043E \u0432\u0437\u044F\u0442\u044C \u0441\u0432\u043E\u0438
        \u043B\u044E\u0431\u0438\u043C\u044B\u0435) "
    - FoodImage: {fileID: 21300000, guid: f6287fde176d49148acc53ec6b160771, type: 3}
      FoodLabel: "\u041D\u0435\u0436\u043D\u044B\u0435 \u043C\u0430\u0444\u0444\u0438\u043D\u044B
        \u0438\u0437 \u043A\u0443\u0440\u0438\u043D\u043E\u0439 \u0433\u0440\u0443\u0434\u043A\u0438."
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
        <br>   1. \u041A\u0443\u0440\u0438\u043D\u043E\u0435 \u0444\u0438\u043B\u0435
        \u043F\u0435\u0440\u0435\u043C\u043E\u043B\u043E\u0442\u044C \u0441 \u043B\u0443\u043A\u043E\u043C
        \u0432 \u043C\u044F\u0441\u043E\u0440\u0443\u0431\u043A\u0435 \u0438\u043B\u0438
        \u0432 \u0431\u043B\u0435\u043D\u0434\u0435\u0440\u0435. <br>   2. \u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C
        \u0441\u043E\u043B\u044C, \u043F\u0435\u0440\u0435\u0446, \u044F\u0439\u0446\u043E
        \u0438 \u0441\u0443\u0445\u043E\u0439 \u0447\u0435\u0441\u043D\u043E\u043A.
        <br>   3. \u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u043D\u0430\u0442\u0451\u0440\u0442\u044B\u0439
        \u043D\u0430 \u0441\u0440\u0435\u0434\u043D\u0435\u0439 \u0442\u0451\u0440\u043A\u0435
        \u0441\u044B\u0440. \u041F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0442\u044C.
        <br>   4. \u0412 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0439 \u043C\u0438\u0441\u043A\u0435
        \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C \u0442\u0432\u043E\u0440\u043E\u0433
        \u0438 \u043D\u0430\u0442\u0451\u0440\u0442\u044B\u0439 \u043D\u0430 \u0442\u0451\u0440\u043A\u0435
        \u043F\u043B\u0430\u0432\u043B\u0435\u043D\u044B\u0439 \u0441\u044B\u0440.
        \u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0441\u043E\u043B\u044C
        \u0438 \u043F\u0435\u0440\u0435\u0446 \u043F\u043E \u0432\u043A\u0443\u0441\u0443.
        <br>   5. \u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u043F\u043E\u0440\u0446\u0438\u0438
        \u0444\u0430\u0440\u0448\u0430 \u0432\u043B\u043E\u0436\u0438\u0442\u044C
        \u0432 \u0444\u043E\u0440\u043C\u044B \u0434\u043B\u044F \u043A\u0435\u043A\u0441\u043E\u0432
        \u0438 \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
        \u0435\u0433\u043E \u043F\u043E \u0434\u043D\u0443 \u0438 \u0431\u043E\u043A\u0430\u043C
        \u0444\u043E\u0440\u043C\u043E\u0447\u043A\u0438. <br>   6. \u041D\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u044C
        \u043A\u0435\u043A\u0441\u044B \u0441\u044B\u0440\u043D\u043E-\u0442\u0432\u043E\u0440\u043E\u0436\u043D\u043E\u0439
        \u043D\u0430\u0447\u0438\u043D\u043A\u043E\u0439. <br>   7. \u0415\u0441\u043B\u0438
        \u0444\u043E\u0440\u043C\u043E\u0447\u0435\u043A \u0443 \u0432\u0430\u0441
        \u043D\u0435\u0442, \u0442\u043E \u043C\u043E\u0436\u043D\u043E \u0441\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u0442\u044C
        \u0444\u0430\u0440\u0448 \u0432 \u0432\u0438\u0434\u0435 \u0432\u0430\u0442\u0440\u0443\u0448\u0435\u043A
        \u0438\u043B\u0438 \u043A\u043E\u0442\u043B\u0435\u0442 \u0441 \u0441\u044B\u0440\u043D\u043E-\u0442\u0432\u043E\u0440\u043E\u0436\u043D\u043E\u0439
        \u043D\u0430\u0447\u0438\u043D\u043A\u043E\u0439. <br>   8. \u0412\u044B\u043F\u0435\u043A\u0430\u0442\u044C
        \u0432 \u0437\u0430\u0440\u0430\u043D\u0435\u0435 \u0440\u0430\u0437\u043E\u0433\u0440\u0435\u0442\u043E\u0439
        \u0434\u0443\u0445\u043E\u0432\u043A\u0435 \u043F\u0440\u0438 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0435
        180 \u0433\u0440\u0430\u0434\u0443\u0441\u043E\u0432 30-35 \u043C\u0438\u043D\u0443\u0442.
        <br>   9. \u041F\u043E\u0434\u0430\u0432\u0430\u0442\u044C \u0441 \u0433\u0430\u0440\u043D\u0438\u0440\u043E\u043C
        \u0438\u043B\u0438 \u043E\u0432\u043E\u0449\u0430\u043C\u0438. \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E
        \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430!"
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
        <br>   \u2022500 \u0433 \u043A\u0443\u0440\u0438\u043D\u043E\u0433\u043E
        \u0444\u0438\u043B\u0435 (\u0438\u043B\u0438 \u0444\u0430\u0440\u0448\u0430)
        <br>   \u20221 \u043B\u0443\u043A\u043E\u0432\u0438\u0446\u0430 <br>   \u20221
        \u044F\u0439\u0446\u043E <br>   \u2022\u0441\u043E\u043B\u044C, \u043F\u0435\u0440\u0435\u0446
        \u043F\u043E \u0432\u043A\u0443\u0441\u0443 <br>   \u2022\u0441\u0443\u0445\u043E\u0439
        \u0447\u0435\u0441\u043D\u043E\u043A \u043F\u043E \u0432\u043A\u0443\u0441\u0443
        <br>   \u2022100 \u0433. \u0442\u0432\u0451\u0440\u0434\u043E\u0433\u043E
        \u0441\u044B\u0440\u0430  <br>   \u2022\u0414\u043B\u044F \u043D\u0430\u0447\u0438\u043D\u043A\u0438:
        <br>   \u2022150 \u0433. \u0442\u0432\u043E\u0440\u043E\u0433\u0430 <br>  
        \u2022100 \u0433. \u043F\u043B\u0430\u0432\u043B\u0435\u043D\u043E\u0433\u043E
        \u0441\u044B\u0440\u0430 <br>   \u2022\u0441\u043E\u043B\u044C, \u043F\u0435\u0440\u0435\u0446
        \u043F\u043E \u0432\u043A\u0443\u0441\u0443 <br>   \u2022\u0410 \u0442\u0430\u043A\u0436\u0435:
        \u0437\u0435\u043B\u0435\u043D\u044C \u0434\u043B\u044F \u043F\u043E\u0434\u0430\u0447\u0438"
    - FoodImage: {fileID: 21300000, guid: de03b3676f4d8834b9fd6beedc4f1ea3, type: 3}
      FoodLabel: "\u0421\u043E\u0441\u0438\u0441\u043A\u0438 \u043A\u0443\u0440\u0438\u043D\u044B\u0435
        (\u043E\u0447\u0435\u043D\u044C \u043D\u0435\u0436\u043D\u044B\u0435)"
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
        <br>   1.\u041A\u0443\u0440\u0438\u043D\u043E\u0435 \u0444\u0438\u043B\u0435
        \u043D\u0430\u0440\u0435\u0437\u0430\u0442\u044C \u043A\u0443\u0431\u0438\u043A\u043E\u043C.
        <br>   2.\u0421\u043C\u0435\u0448\u0430\u0442\u044C \u0441 \u043C\u043E\u043B\u043E\u043A\u043E\u043C
        \u0438 \u043F\u0435\u0440\u0435\u0431\u0438\u0442\u044C \u0432 \u0431\u043B\u0435\u043D\u0434\u0435\u0440\u0435.
        <br>   3.\u0412\u0430\u0440\u0435\u043D\u0443\u044E \u0441\u0432\u0435\u043A\u043B\u0443
        \u043F\u0435\u0440\u0435\u0431\u0438\u0442\u044C \u0441 \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
        \u043C\u0430\u0441\u043B\u043E\u043C. <br>   4.\u0412\u0441\u0435 \u0441\u043C\u0435\u0448\u0430\u0442\u044C
        \u0438 \u0437\u0430\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0444\u0430\u0440\u0448.
        <br>   5.\u0417\u0430\u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0432 \u043F\u0438\u0449\u0435\u0432\u0443\u044E
        \u043F\u043B\u0435\u043D\u043A\u0443, \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u044F
        \u0444\u043E\u0440\u043C\u0443 \u0441\u043E\u0441\u0438\u0441\u043E\u043A. 
        <br>\u041E\u0442\u0432\u0430\u0440\u0438\u0442\u044C \u0432 \u043A\u0438\u043F\u044F\u0449\u0435\u0439
        \u0432\u043E\u0434\u0435.  <br>\u041F\u043E\u0434\u0430\u0432\u0430\u0442\u044C
        \u043A \u0441\u0442\u043E\u043B\u0443. \u0412\u0441\u0435 \u043E\u0447\u0435\u043D\u044C
        \u043F\u0440\u043E\u0441\u0442\u043E!"
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br> 
        <br>   \u2022\u041A\u0443\u0440\u0438\u043D\u043E\u0435 \u0444\u0438\u043B\u0435
        - 2 \u0448\u0442. <br>   \u2022\u041C\u043E\u043B\u043E\u043A\u043E - 250
        \u043C\u043B <br>   \u2022\u0421\u0432\u0435\u043A\u043B\u0430 (\u0432\u0430\u0440\u0435\u043D\u0430\u044F)
        - 30 \u0433. <br>   \u2022\u0420\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
        \u043C\u0430\u0441\u043B\u043E - 20 \u043C\u043B <br>   \u2022\u0421\u043E\u043B\u044C,
        \u0441\u043C\u0435\u0441\u044C \u043F\u0435\u0440\u0446\u0435\u0432 - \u043F\u043E
        \u0432\u043A\u0443\u0441\u0443"
    - FoodImage: {fileID: 21300000, guid: 1bef2bf2175fd1d44b6040880eea4029, type: 3}
      FoodLabel: "\u0415\u0436\u0438\u043A\u0438 \u0438\u0437 \u0444\u0430\u0440\u0448\u0430
        \u0438 \u0440\u0438\u0441\u0430"
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
        <br>   \u2022\u041F\u0435\u0440\u0435\u043B\u043E\u0436\u0438\u0442\u0435
        \u0444\u0430\u0440\u0448 \u0432 \u0433\u043B\u0443\u0431\u043E\u043A\u0443\u044E
        \u043C\u0438\u0441\u043A\u0443.  <br>   \u2022\u041A\u0430\u0431\u0430\u0447\u043E\u043A
        \u043D\u0430\u0442\u0440\u0438\u0442\u0435 \u043D\u0430 \u043C\u0435\u043B\u043A\u043E\u0439
        \u0442\u0435\u0440\u043A\u0435, \u043E\u0442\u043E\u0436\u043C\u0438\u0442\u0435
        \u0432\u044B\u0434\u0435\u043B\u0438\u0432\u0448\u0438\u0439\u0441\u044F
        \u0441\u043E\u043A \u0438 \u0434\u043E\u0431\u0430\u0432\u044C\u0442\u0435
        \u043A \u0444\u0430\u0440\u0448\u0443. \u041B\u0443\u043A \u0438\u0437\u043C\u0435\u043B\u044C\u0447\u0438\u0442\u0435
        \u0438\u043B\u0438 \u043D\u0430\u0442\u0440\u0438\u0442\u0435 \u043D\u0435
        \u0442\u0435\u0440\u043A\u0435 \u0441 \u043A\u0440\u0443\u043F\u043D\u044B\u043C\u0438
        \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044F\u043C\u0438 \u0438
        \u0434\u043E\u0431\u0430\u0432\u044C\u0442\u0435 \u043A \u0444\u0430\u0440\u0448\u0443
        \u0441 \u043A\u0430\u0431\u0430\u0447\u043A\u043E\u043C.  <br>   \u2022\u0412
        \u0432\u043E\u0434\u0435 \u0440\u0430\u0437\u0432\u0435\u0434\u0438\u0442\u0435
        \u043A\u0440\u0430\u0445\u043C\u0430\u043B \u0438 \u0432\u043B\u0435\u0439\u0442\u0435
        \u043A \u0444\u0430\u0440\u0448\u0443. \u0414\u043E\u0431\u0430\u0432\u044C\u0442\u0435
        \u043F\u0440\u043E\u043C\u044B\u0442\u044B\u0439 \u0440\u0438\u0441, \u043B\u044E\u0431\u0443\u044E
        \u0441\u0432\u0435\u0436\u0443\u044E \u0438\u0437\u043C\u0435\u043B\u044C\u0447\u0435\u043D\u043D\u0443\u044E
        \u0437\u0435\u043B\u0435\u043D\u044C, \u043C\u0430\u0441\u043B\u043E, \u0441\u043E\u043B\u044C
        \u0438 \u0441\u043F\u0435\u0446\u0438\u0438 \u043F\u043E \u0432\u043A\u0443\u0441\u0443. 
        <br>   \u2022\u0425\u043E\u0440\u043E\u0448\u043E \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0439\u0442\u0435
        \u0444\u0430\u0440\u0448 \u0434\u043E \u043E\u0434\u043D\u043E\u0440\u043E\u0434\u043D\u043E\u0441\u0442\u0438. 
        <br>   \u2022\u0421\u0444\u043E\u0440\u043C\u0438\u0440\u0443\u0439\u0442\u0435
        \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u0448\u0430\u0440\u0438\u043A\u0438
        (\u0440\u0430\u0437\u043C\u0435\u0440 \u0432\u044B\u0431\u0438\u0440\u0430\u0439\u0442\u0435
        \u043D\u0430 \u0432\u0430\u0448\u0435 \u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u0438\u0435)
        \u0438 \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u0435 \u0438\u0445 \u0432
        \u0441\u043C\u0430\u0437\u0430\u043D\u043D\u044B\u0439 \u043C\u0430\u0441\u043B\u043E\u043C
        \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440 \u0434\u043B\u044F
        \u0432\u0430\u0440\u043A\u0438 \u043D\u0430 \u043F\u0430\u0440\u0443. \u0413\u043E\u0442\u043E\u0432\u044C\u0442\u0435
        \u043D\u0430 \u043F\u0430\u0440\u0443 \u043E\u043A\u043E\u043B\u043E 50 \u043C\u0438\u043D\u0443\u0442.
        \u042F \u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0430 \u0432 \u043C\u0443\u043B\u044C\u0442\u0438\u0432\u0430\u0440\u043A\u0435,
        \u043D\u043E \u043F\u043E\u0434\u043E\u0439\u0434\u0435\u0442 \u043B\u044E\u0431\u0430\u044F
        \u043F\u0430\u0440\u043E\u0432\u0430\u0440\u043A\u0430.  <br>   \u2022\u0415\u0436\u0438\u043A\u0438
        \u0438\u0437 \u0444\u0430\u0440\u0448\u0430 \u0438 \u0440\u0438\u0441\u0430
        \u0433\u043E\u0442\u043E\u0432\u044B. \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E
        \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430!!!"
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
        <br>   \u2022\u0424\u0430\u0440\u0448  \u2014 500 \u0413\u0440\u0430\u043C\u043C 
        <br>   \u2022\u0420\u0438\u0441  \u2014 120 \u0413\u0440\u0430\u043C\u043C
        (\u0434\u043B\u0438\u043D\u043D\u043E\u0437\u0435\u0440\u043D\u044B\u0439) 
        <br>   \u2022\u041A\u0430\u0431\u0430\u0447\u043E\u043A  \u2014 400 \u0413\u0440\u0430\u043C\u043C 
        <br>   \u2022\u041B\u0443\u043A  \u2014 1 \u0428\u0442\u0443\u043A\u0430 
        <br>   \u2022\u0420\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
        \u043C\u0430\u0441\u043B\u043E  \u2014 1 \u0421\u0442. \u043B\u043E\u0436\u043A\u0430 
        <br>   \u2022\u041A\u0440\u0430\u0445\u043C\u0430\u043B  \u2014 2 \u0421\u0442.
        \u043B\u043E\u0436\u043A\u0438  <br>   \u2022\u0412\u043E\u0434\u0430  \u2014
        50 \u041C\u0438\u043B\u043B\u0438\u043B\u0438\u0442\u0440\u043E\u0432  <br>  
        \u2022\u0417\u0435\u043B\u0435\u043D\u044C  \u2014 \u041F\u043E \u0432\u043A\u0443\u0441\u0443 
        <br>   \u2022\u0421\u043E\u043B\u044C  \u2014 \u041F\u043E \u0432\u043A\u0443\u0441\u0443 
        <br>   \u2022\u0421\u043F\u0435\u0446\u0438\u0438  \u2014 \u041F\u043E \u0432\u043A\u0443\u0441\u0443"
    - FoodImage: {fileID: 21300000, guid: ae9492c2d8c8dbb4f9aefa5853cbd6c0, type: 3}
      FoodLabel: "\u0417\u0430\u043F\u0435\u0447\u0435\u043D\u043D\u044B\u0435 \u043E\u0432\u043E\u0449\u0438
        \u0432 \u0434\u0443\u0445\u043E\u0432\u043A\u0435."
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
        <br>   \u2022\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435
        \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u0435 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B.
        \u041E\u0432\u043E\u0449\u0438 \u0438 \u0433\u0440\u0438\u0431\u044B \u0432\u044B\u043C\u043E\u0439\u0442\u0435,
        \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u0435. \u0423 \u0448\u0430\u043C\u043F\u0438\u043D\u044C\u043E\u043D\u043E\u0432
        \u0443\u0434\u0430\u043B\u0438\u0442\u0435 \u043D\u043E\u0436\u043A\u0438. 
        <br>   \u2022\u041B\u0443\u043A \u043D\u0430\u0440\u0435\u0436\u044C\u0442\u0435
        \u043A\u043E\u043B\u044C\u0446\u0430\u043C\u0438, \u043C\u043E\u0440\u043A\u043E\u0432\u044C
        - \u043A\u0440\u0443\u0436\u043A\u0430\u043C\u0438, \u043F\u0435\u0440\u0435\u0446
        - \u043F\u043E\u043B\u043E\u0441\u043A\u0430\u043C\u0438. \u0420\u0430\u0437\u043B\u043E\u0436\u0438\u0442\u0435
        \u043E\u0432\u043E\u0449\u0438 \u0438 \u0433\u0440\u0438\u0431\u044B \u043D\u0430
        \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0435, \u043F\u043E\u0441\u043E\u043B\u0438\u0442\u0435
        \u0438 \u043F\u043E\u043F\u0435\u0440\u0447\u0438\u0442\u0435 \u043F\u043E
        \u0432\u043A\u0443\u0441\u0443, \u043F\u043E\u043B\u0435\u0439\u0442\u0435
        \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
        \u043C\u0430\u0441\u043B\u043E\u043C.  <br>   \u2022\u041F\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435
        \u0437\u0430\u043F\u0435\u043A\u0430\u0442\u044C\u0441\u044F \u0432 \u0440\u0430\u0437\u043E\u0433\u0440\u0435\u0442\u0443\u044E
        \u0434\u043E 220\xBA\u0421 (425 \xBAF) \u0434\u0443\u0445\u043E\u0432\u043A\u0443
        \u043D\u0430 20-25 \u043C\u0438\u043D\u0443\u0442.  <br>   \u2022\u041F\u043E\u0434\u0430\u0432\u0430\u0439\u0442\u0435
        \u0437\u0430\u043F\u0435\u0447\u0435\u043D\u043D\u044B\u0435 \u043E\u0432\u043E\u0449\u0438
        \u0438 \u0433\u0440\u0438\u0431\u044B \u0441 \u0433\u0440\u0435\u0447\u0435\u0441\u043A\u0438\u043C
        \u0439\u043E\u0433\u0443\u0440\u0442\u043E\u043C. \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E
        \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430!  "
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
        <br>   \u2022\u041A\u0430\u043F\u0443\u0441\u0442\u0430 \u0446\u0432\u0435\u0442\u0430\u043D\u044F 
        \u2014 1/2 \u0428\u0442\u0443\u043A\u0438 <br>   \u2022\u041B\u0443\u043A 
        \u2014 1 \u0428\u0442\u0443\u043A\u0430  <br>   \u2022\u041F\u0435\u0440\u0435\u0446
        \u0431\u043E\u043B\u0433\u0430\u0440\u0441\u043A\u0438\u0439  \u2014 1 \u0428\u0442\u0443\u043A\u0430 
        <br>   \u2022\u0428\u0430\u043C\u043F\u0438\u043D\u044C\u043E\u043D\u044B 
        \u2014 2-3 \u0428\u0442\u0443\u043A  <br>   \u2022\u041C\u043E\u0440\u043A\u043E\u0432\u044C 
        \u2014 1 \u0428\u0442\u0443\u043A\u0430  <br>   \u2022\u041F\u0435\u0440\u0435\u0446
        \u0447\u0435\u0440\u043D\u044B\u0439 \u043C\u043E\u043B\u043E\u0442\u044B\u0439 
        \u2014 \u041F\u043E \u0432\u043A\u0443\u0441\u0443  <br>   \u2022\u041F\u0435\u0440\u0435\u0446
        \u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0436\u0433\u0443\u0447\u0438\u0439 
        \u2014 \u041F\u043E \u0432\u043A\u0443\u0441\u0443  <br>   \u2022\u0421\u043E\u043B\u044C 
        \u2014 \u041F\u043E \u0432\u043A\u0443\u0441\u0443 (\u043A\u0440\u0443\u043F\u043D\u0430\u044F) 
        <br>   \u2022\u041C\u0430\u0441\u043B\u043E \u043E\u043B\u0438\u0432\u043A\u043E\u0432\u043E\u0435 
        \u2014 2 \u0421\u0442. \u043B\u043E\u0436\u043A\u0438  <br>   \u2022\u0419\u043E\u0433\u0443\u0440\u0442
        (\u0433\u0440\u0435\u0447\u0435\u0441\u043A\u0438\u0439)  \u2014 100 \u0413\u0440\u0430\u043C\u043C
        (\u0434\u043B\u044F \u043F\u043E\u0434\u0430\u0447\u0438)"
    secondFoods:
    - FoodImage: {fileID: 21300000, guid: b28435c48e46b8948a6040d219340b1a, type: 3}
      FoodLabel: "\u0421\u0430\u043B\u0430\u0442 \u0438\u0437 \u0441\u0432\u0435\u0436\u0435\u0439
        \u043A\u0430\u043F\u0443\u0441\u0442\u044B"
      FoodHowToCake: " \u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
        <br>   \u2022300 \u0433\u0440\u0430\u043C\u043C \u0431\u0435\u043B\u043E\u043A\u043E\u0447\u0430\u043D\u043D\u043E\u0439
        \u043A\u0430\u043F\u0443\u0441\u0442\u044B \u043F\u0440\u043E\u043C\u044B\u0432\u0430\u0435\u043C
        \u043F\u043E\u0434 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0439 \u0432\u043E\u0434\u043E\u0439,
        \u0447\u0438\u0441\u0442\u0438\u043C \u043B\u0443\u043A \u0438 \u043C\u043E\u0440\u043A\u043E\u0432\u044C. 
        <br>   \u2022\u041A\u0430\u043F\u0443\u0441\u0442\u0443 \u043D\u0430\u0440\u0435\u0437\u0430\u0435\u043C
        \u0442\u043E\u043D\u043A\u043E\u0439 \u0441\u043E\u043B\u043E\u043C\u043A\u043E\u0439
        <br>   \u2022\u041C\u043E\u0440\u043A\u043E\u0432\u044C \u043D\u0430\u0442\u0438\u0440\u0430\u0435\u043C
        \u043D\u0430 \u043A\u0440\u0443\u043F\u043D\u043E\u0439 \u0442\u0435\u0440\u043A\u0435,
        \u043B\u0443\u043A \u043D\u0430\u0440\u0435\u0437\u0430\u0435\u043C \u043A\u0443\u0431\u0438\u043A\u0430\u043C\u0438,
        \u0447\u0435\u0441\u043D\u043E\u043A \u043B\u0438\u0431\u043E \u043C\u0435\u043B\u043A\u043E-\u043C\u0435\u043B\u043A\u043E
        \u043D\u0430\u0440\u0435\u0437\u0430\u0435\u043C, \u043B\u0438\u0431\u043E
        \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0435\u043C \u0447\u0435\u0440\u0435\u0437
        \u0447\u0435\u0441\u043D\u043E\u0447\u043D\u0438\u0446\u0443. <br>   \u2022\u041F\u043E\u043B\u0438\u0432\u0430\u0435\u043C
        \u0441\u0430\u043B\u0430\u0442 \u043F\u043E\u0434\u0441\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u043C
        \u043C\u0430\u0441\u043B\u043E\u043C \u0438 \u0443\u043A\u0441\u0443\u0441\u043E\u043C,
        \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u043C \u043D\u0435\u043C\u043D\u043E\u0436\u043A\u043E
        \u0441\u0430\u0445\u0430\u0440\u0430 \u0438 \u0441\u043E\u043B\u0438. \u0425\u043E\u0440\u043E\u0448\u0435\u043D\u044C\u043A\u043E
        \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0438\u0432\u0430\u0435\u043C
        - \u0438 \u0441\u0430\u043B\u0430\u0442 \u0438\u0437 \u0441\u0432\u0435\u0436\u0435\u0439
        \u043A\u0430\u043F\u0443\u0441\u0442\u044B \u0433\u043E\u0442\u043E\u0432!  "
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
        <br>   \u2022\u0411\u0435\u043B\u043E\u043A\u043E\u0447\u0430\u043D\u043D\u0430\u044F
        \u043A\u0430\u043F\u0443\u0441\u0442\u0430  \u2014 300 \u0413\u0440\u0430\u043C\u043C 
        <br>   \u2022\u041C\u043E\u0440\u043A\u043E\u0432\u044C  \u2014 1 \u0428\u0442\u0443\u043A\u0430 
        <br>   \u2022\u041B\u0443\u043A\u043E\u0432\u0438\u0446\u0430  \u2014 1 \u0428\u0442\u0443\u043A\u0430 
        <br>   \u2022\u0427\u0435\u0441\u043D\u043E\u043A  \u2014 3 \u0417\u0443\u0431\u0447\u0438\u043A\u0430 
        <br>   \u2022\u041F\u043E\u0434\u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0435
        \u043C\u0430\u0441\u043B\u043E  \u2014 3-4 \u0421\u0442. \u043B\u043E\u0436\u0435\u043A 
        <br>   \u2022\u0423\u043A\u0441\u0443\u0441  \u2014 1 \u0427\u0430\u0439\u043D\u0430\u044F
        \u043B\u043E\u0436\u043A\u0430  <br>   \u2022\u0421\u0430\u0445\u0430\u0440 
        \u2014 2 \u0427\u0430\u0439\u043D\u044B\u0445 \u043B\u043E\u0436\u043A\u0438 
        <br>   \u2022\u0421\u043E\u043B\u044C  \u2014 - \u041F\u043E \u0432\u043A\u0443\u0441\u0443 "
    - FoodImage: {fileID: 21300000, guid: 4a5c02952fd9e0a49908c711dc73ab00, type: 3}
      FoodLabel: "\u0411\u044B\u0441\u0442\u0440\u044B\u0435 \u043E\u043B\u0430\u0434\u044C\u0438
        \u0438\u0437 \u043A\u0430\u0431\u0430\u0447\u043A\u043E\u0432"
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
        <br>   \u2022\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435
        \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B, \u0432\u044B\u043C\u043E\u0439\u0442\u0435
        \u043A\u0430\u0431\u0430\u0447\u043A\u0438, \u0441\u0440\u0435\u0436\u044C\u0442\u0435
        \u043A\u043E\u043D\u0447\u0438\u043A\u0438. \u041E\u0447\u0438\u0441\u0442\u0438\u0442\u0435
        \u043B\u0443\u043A\u043E\u0432\u0438\u0446\u0443. \u041F\u0440\u0438\u0441\u0442\u0443\u043F\u0438\u043C! 
        <br>   \u2022\u041A\u0430\u0431\u0430\u0447\u043A\u0438 \u043D\u0430\u0442\u0440\u0438\u0442\u0435
        \u043D\u0430 \u043A\u0440\u0443\u043F\u043D\u043E\u0439 \u0442\u0435\u0440\u043A\u0435
        \u0438 \u043E\u0442\u043E\u0436\u043C\u0438\u0442\u0435 \u0441\u043E\u043A.
        \u0414\u043E\u0431\u0430\u0432\u044C\u0442\u0435 \u043A \u043D\u0438\u043C
        \u0442\u0435\u0440\u0442\u0443\u044E \u043B\u0443\u043A\u043E\u0432\u0438\u0446\u0443,
        \u0435\u0435 \u044F \u0442\u043E\u0436\u0435 \u043E\u0431\u044B\u0447\u043D\u043E
        \u0442\u0440\u0443 \u043D\u0430 \u043A\u0440\u0443\u043F\u043D\u043E\u0439
        \u0442\u0435\u0440\u043A\u0435. \u041F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0439\u0442\u0435. 
        <br>   \u2022\u0414\u043E\u0431\u0430\u0432\u044C\u0442\u0435 \u0441\u044B\u0440\u043E\u0435
        \u044F\u0439\u0446\u043E, \u0441\u043E\u043B\u044C \u0438 \u043F\u0430\u0440\u0443
        \u0449\u0435\u043F\u043E\u0442\u043E\u043A \u0447\u0435\u0440\u043D\u043E\u0433\u043E
        \u043C\u043E\u043B\u043E\u0442\u043E\u0433\u043E \u043F\u0435\u0440\u0446\u0430.
        \u041F\u043E \u0436\u0435\u043B\u0430\u043D\u0438\u044E \u043B\u044E\u0431\u044B\u0435
        \u0434\u0440\u0443\u0433\u0438\u0435 \u0441\u043F\u0435\u0446\u0438\u0438
        \u0438 \u0430\u0440\u043E\u043C\u0430\u0442\u043D\u044B\u0435 \u0442\u0440\u0430\u0432\u044B.
        \u041F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0439\u0442\u0435.  <br>  
        \u2022\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0447\u0430\u0441\u0442\u044F\u043C\u0438
        \u043C\u0443\u043A\u0443, \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0439\u0442\u0435,
        \u0441\u043B\u0435\u0434\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
        \u043D\u0435 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043B\u0438\u0441\u044C
        \u043C\u0443\u0447\u043D\u044B\u0435 \u043A\u043E\u043C\u043E\u0447\u043A\u0438. 
        <br>   \u2022\u0422\u0435\u0441\u0442\u043E \u0434\u043B\u044F \u043E\u043B\u0430\u0434\u044C\u0435\u0432
        \u0433\u043E\u0442\u043E\u0432\u043E. \u041E\u043D\u043E \u0432 \u043C\u0435\u0440\u0443
        \u0433\u0443\u0441\u0442\u043E\u0435, \u043E\u0442\u043B\u0438\u0447\u043D\u043E
        \u043D\u0430\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u0441\u0442\u043E\u043B\u043E\u0432\u043E\u0439
        \u043B\u043E\u0436\u043A\u043E\u0439.  <br>   \u2022\u0420\u0430\u0437\u043E\u0433\u0440\u0435\u0439\u0442\u0435
        \u0441\u043A\u043E\u0432\u043E\u0440\u043E\u0434\u0443 \u0441 \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
        \u043C\u0430\u0441\u043B\u043E\u043C. \u041E\u0433\u043E\u043D\u044C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439.
        \u0421\u0442\u043E\u043B\u043E\u0432\u043E\u0439 \u043B\u043E\u0436\u043A\u043E\u0439
        \u043D\u0430\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u0442\u0435\u0441\u0442\u043E
        \u0438 \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u0439\u0442\u0435 \u043A\u0440\u0443\u0433\u043B\u044B\u0435
        \u043E\u043B\u0430\u0434\u0443\u0448\u043A\u0438. \u0416\u0430\u0440\u044C\u0442\u0435
        \u0434\u043E \u0437\u043E\u043B\u043E\u0442\u0438\u0441\u0442\u043E\u0439
        \u043A\u043E\u0440\u043E\u0447\u043A\u0438.  <br>   \u2022\u041F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0438\u0442\u0435
        \u043B\u043E\u043F\u0430\u0442\u043A\u043E\u0439 \u043D\u0430 \u0434\u0440\u0443\u0433\u0443\u044E
        \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0434\u043E\u0432\u0435\u0434\u0438\u0442\u0435
        \u043E\u043B\u0430\u0434\u044C\u0438 \u0434\u043E \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u0438.
        \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E!  "
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
        <br>   \u2022\u041A\u0430\u0431\u0430\u0447\u043E\u043A  \u2014 500 \u0413\u0440\u0430\u043C\u043C 
        <br>   \u2022\u041B\u0443\u043A  \u2014 1 \u0428\u0442\u0443\u043A\u0430 
        <br>   \u2022\u042F\u0439\u0446\u043E  \u2014 1 \u0428\u0442\u0443\u043A\u0430 
        <br>   \u2022\u041C\u0443\u043A\u0430  \u2014 3 \u0421\u0442. \u043B\u043E\u0436\u043A\u0438 
        <br>   \u2022\u0421\u043E\u043B\u044C  \u2014 \u041F\u043E \u0432\u043A\u0443\u0441\u0443 
        <br>   \u2022\u041F\u0435\u0440\u0435\u0446 \u0447\u0435\u0440\u043D\u044B\u0439
        \u043C\u043E\u043B\u043E\u0442\u044B\u0439  \u2014 \u041F\u043E \u0432\u043A\u0443\u0441\u0443 
        <br>   \u2022\u0420\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
        \u043C\u0430\u0441\u043B\u043E  \u2014 3-4 \u0421\u0442. \u043B\u043E\u0436\u0435\u043A
        (\u0434\u043B\u044F \u0436\u0430\u0440\u043A\u0438 "
    - FoodImage: {fileID: 21300000, guid: d17cf0a661279af4486b869147b13351, type: 3}
      FoodLabel: "\u041F\u0438\u0440\u043E\u0433 \u0438\u0437 \u0441\u0432\u0435\u0436\u0435\u0439
        \u043A\u0430\u043F\u0443\u0441\u0442\u044B"
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
        <br>   \u2022\u041D\u0430\u0440\u0435\u0436\u044C\u0442\u0435 \u043A\u0430\u043F\u0443\u0441\u0442\u0443
        \u0441\u043E\u043B\u043E\u043C\u043A\u043E\u0439. \u041B\u0443\u043A \u043D\u0430\u0440\u0435\u0436\u044C\u0442\u0435
        \u043A\u0443\u0431\u0438\u043A\u0430\u043C\u0438. \u041E\u0431\u0436\u0430\u0440\u044C\u0442\u0435
        \u043A\u0430\u043F\u0443\u0441\u0442\u0443 \u0441 \u043B\u0443\u043A\u043E\u043C
        \u043D\u0430 \u0441\u043A\u043E\u0432\u043E\u0440\u043E\u0434\u0435 \u0434\u043E
        \u0436\u0435\u043B\u0430\u0435\u043C\u043E\u0439 \u0441\u0442\u0435\u043F\u0435\u043D\u0438
        \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u0438. \u0412 \u043A\u043E\u043D\u0446\u0435
        \u0434\u043E\u0431\u0430\u0432\u044C\u0442\u0435 \u0441\u043E\u043B\u044C
        \u0438 \u043F\u0435\u0440\u0435\u0446 \u043F\u043E \u0432\u043A\u0443\u0441\u0443.
        \u0414\u0430\u0439\u0442\u0435 \u043D\u0430\u0447\u0438\u043D\u043A\u0435
        \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043E\u0441\u0442\u044B\u0442\u044C. 
        <br>   \u2022\u0412 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u043C\u0438\u0441\u043A\u0435
        \u0432\u0437\u0431\u0435\u0439\u0442\u0435 \u044F\u0439\u0446\u043E \u0441
        \u0441\u043E\u043B\u044C\u044E.  <br>   \u2022\u0414\u043E\u0431\u0430\u0432\u044C\u0442\u0435
        \u043A\u0435\u0444\u0438\u0440 \u043A\u043E\u043C\u043D\u0430\u0442\u043D\u043E\u0439
        \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u044B \u0438
        \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0439\u0442\u0435.  <br>  
        \u2022\u0414\u043E\u0431\u0430\u0432\u044C\u0442\u0435 \u043C\u0443\u043A\u0443
        \u0438 \u0441\u043E\u0434\u0443.  <br>   \u2022\u041F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0439\u0442\u0435
        \u0432\u0441\u0435 \u0435\u0449\u0435 \u0440\u0430\u0437 \u0434\u043E \u043E\u0434\u043D\u043E\u0440\u043E\u0434\u043D\u043E\u0433\u043E
        \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F.  <br>   \u2022\u0424\u043E\u0440\u043C\u0443
        \u0434\u043B\u044F \u0432\u044B\u043F\u0435\u0447\u043A\u0438 \u0441\u043C\u0430\u0436\u044C\u0442\u0435
        \u043C\u0430\u0441\u043B\u043E\u043C. \u0415\u0441\u043B\u0438 \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u0435\u0442\u0435\u0441\u044C
        \u0432 \u0441\u0432\u043E\u0435\u0439 \u0444\u043E\u0440\u043C\u0435, \u043C\u043E\u0436\u043D\u043E
        \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u0434\u043D\u043E \u0438 \u0431\u043E\u043A\u0430 \u043F\u043E\u0441\u044B\u043F\u0430\u0442\u044C
        \u043C\u0430\u043D\u043A\u043E\u0439. \u0412\u044B\u043B\u0435\u0439\u0442\u0435
        \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u0442\u0435\u0441\u0442\u0430
        <br>   \u2022\u0421\u0432\u0435\u0440\u0445\u0443 \u0440\u0430\u0432\u043D\u043E\u043C\u0435\u0440\u043D\u043E
        \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u0435
        \u043D\u0430\u0447\u0438\u043D\u043A\u0443.  <br>   \u2022\u0417\u0430\u043B\u0435\u0439\u0442\u0435
        \u043D\u0430\u0447\u0438\u043D\u043A\u0443 \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u043C\u0441\u044F
        \u0442\u0435\u0441\u0442\u043E\u043C. \u041F\u043E\u0441\u044B\u043F\u044C\u0442\u0435
        \u0432\u0435\u0440\u0445, \u043F\u043E \u0436\u0435\u043B\u0430\u043D\u0438\u044E,
        \u043A\u0443\u043D\u0436\u0443\u0442\u043E\u043C. \u0412\u044B\u043F\u0435\u043A\u0430\u0439\u0442\u0435
        \u043F\u0440\u0438 180 \u0433\u0440\u0430\u0434\u0443\u0441\u0430\u0445 \u043E\u043A\u043E\u043B\u043E
        30 \u043C\u0438\u043D\u0443\u0442.  <br>   \u2022\u041F\u041F \u043F\u0438\u0440\u043E\u0433
        \u0441 \u043A\u0430\u043F\u0443\u0441\u0442\u043E\u0439 \u0433\u043E\u0442\u043E\u0432.
        \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430!!! "
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
        <br>   \u2022\u041A\u0430\u043F\u0443\u0441\u0442\u0430 \u0431\u0435\u043B\u043E\u043A\u0430\u0447\u0430\u043D\u043D\u0430\u044F 
        \u2014 300 \u0413\u0440\u0430\u043C\u043C  <br>   \u2022\u041B\u0443\u043A 
        \u2014 1 \u0428\u0442\u0443\u043A\u0430  <br>   \u2022\u041A\u0435\u0444\u0438\u0440 
        \u2014 0,5 \u0421\u0442\u0430\u043A\u0430\u043D\u0430 (\u043E\u0431\u0435\u0437\u0436\u0438\u0440\u0435\u043D\u043D\u044B\u0439) 
        <br>   \u2022\u042F\u0439\u0446\u043E  \u2014 1 \u0428\u0442\u0443\u043A\u0430 
        <br>   \u2022\u041C\u0443\u043A\u0430  \u2014 6 \u0421\u0442. \u043B\u043E\u0436\u0435\u043A
        (\u0441 \u0433\u043E\u0440\u043A\u043E\u0439)  <br>   \u2022\u0421\u043E\u0434\u0430 
        \u2014 1/3 \u0427\u0430\u0439\u043D\u044B\u0445 \u043B\u043E\u0436\u043A\u0438 
        <br>   \u2022\u0421\u043E\u043B\u044C  \u2014 0,5 \u0427\u0430\u0439\u043D\u044B\u0445
        \u043B\u043E\u0436\u043A\u0438  <br>   \u2022\u0420\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
        \u043C\u0430\u0441\u043B\u043E  \u2014 3 \u0421\u0442. \u043B\u043E\u0436\u043A\u0438 
        <br>   \u2022\u041A\u0443\u043D\u0436\u0443\u0442  \u2014 \u041F\u043E \u0432\u043A\u0443\u0441\u0443  "
    - FoodImage: {fileID: 21300000, guid: 2858518b8cf8bcc42be9643e45c874f6, type: 3}
      FoodLabel: "\u0417\u0430\u043A\u0443\u0441\u043E\u0447\u043D\u044B\u0435 \u0440\u0443\u043B\u0435\u0442\u0438\u043A\u0438
        \u0441 \u0441\u044B\u0440\u043E\u043C"
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
        <br>   \u2022\u041F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435
        \u0432\u0441\u0435 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B. 
        <br>   \u2022\u0420\u0438\u043A\u043E\u0442\u0442\u0443 \u0440\u0430\u0437\u043E\u043C\u043D\u0438\u0442\u0435
        \u0432\u0438\u043B\u043A\u043E\u0439 \u0441 \u0431\u0440\u044B\u043D\u0437\u043E\u0439. 
        <br>   \u2022\u0414\u043E\u0431\u0430\u0432\u044C\u0442\u0435 \u0440\u0443\u0431\u043B\u0435\u043D\u043D\u0443\u044E
        \u0437\u0435\u043B\u0435\u043D\u044C \u0438 \u043D\u0430\u0440\u0435\u0437\u0430\u043D\u043D\u0443\u044E
        \u043A\u0443\u0441\u043E\u0447\u043A\u0430\u043C\u0438 \u0432\u044F\u043B\u0435\u043D\u0443\u044E
        \u043A\u043B\u044E\u043A\u0432\u0443. \u041C\u0430\u0441\u0441\u0443 \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E
        \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0439\u0442\u0435.  <br>  
        \u2022\u041D\u0430 \u043B\u0430\u0432\u0430\u0448 \u0440\u043E\u0432\u043D\u044B\u043C
        \u0441\u043B\u043E\u0435\u043C \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u0435
        \u0441\u044B\u0440\u043D\u0443\u044E \u043C\u0430\u0441\u0441\u0443.  <br>  
        \u2022\u0421\u0432\u0435\u0440\u043D\u0438\u0442\u0435 \u0432 \u0440\u0443\u043B\u0435\u0442.
        \u041B\u0438\u0448\u043D\u0438\u0439 \u043B\u0430\u0432\u0430\u0448 \u043E\u0442\u0440\u0435\u0436\u044C\u0442\u0435. 
        <br>   \u2022\u041D\u0430\u0440\u0435\u0436\u044C\u0442\u0435 \u0440\u0443\u043B\u0435\u0442
        \u043F\u043E\u0440\u0446\u0438\u043E\u043D\u043D\u044B\u043C\u0438 \u043A\u0443\u0441\u043E\u0447\u043A\u0430\u043C\u0438
        1-1,5 \u0441\u043C. \u0412\u044B\u043B\u043E\u0436\u0438\u0442\u0435 \u0437\u0430\u043A\u0443\u0441\u043A\u0443
        \u0432 \u0432\u0438\u0434\u0435 \u0435\u043B\u043E\u0447\u043A\u0438, \u0443\u043A\u0440\u0430\u0441\u044C\u0442\u0435
        \u0437\u0435\u0440\u043D\u0430\u043C\u0438 \u0433\u0440\u0430\u043D\u0430\u0442\u0430
        \u0438 \u0432\u0435\u0442\u043E\u0447\u043A\u0430\u043C\u0438 \u0443\u043A\u0440\u043E\u043F\u0430,
        \u0438 \u043F\u043E\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u043A \u0441\u0442\u043E\u043B\u0443.
        \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430!!! "
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
        <br>   \u2022\u0420\u0438\u043A\u043E\u0442\u0442\u0430  \u2014 150 \u0413\u0440\u0430\u043C\u043C 
        <br>   \u2022\u0411\u0440\u044B\u043D\u0437\u0430  \u2014 100 \u0413\u0440\u0430\u043C\u043C 
        <br>   \u2022\u041A\u043B\u044E\u043A\u0432\u0430 \u0432\u044F\u043B\u0435\u043D\u0430\u044F 
        \u2014 3 \u0421\u0442. \u043B\u043E\u0436\u043A\u0438  <br>   \u2022\u041F\u0435\u0442\u0440\u0443\u0448\u043A\u0430
        \u0441\u0432\u0435\u0436\u0430\u044F  \u2014 \u041F\u0443\u0447\u043E\u043A
        (\u043D\u0435\u043C\u043D\u043E\u0433\u043E)  <br>   \u2022\u041B\u0430\u0432\u0430\u0448
        \u0442\u043E\u043D\u043A\u0438\u0439  \u2014 1 \u0428\u0442\u0443\u043A\u0430  "
    - FoodImage: {fileID: 21300000, guid: 958323d2cf7b6b142801bdc667ac07c8, type: 3}
      FoodLabel: "\u041F\u043E\u043B\u0435\u0437\u043D\u044B\u0439 \u0448\u043E\u043A\u043E\u043B\u0430\u0434\u043D\u044B\u0439
        \u043F\u0430\u043D\u043A\u0435\u0439\u043A"
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
        <br>   \u2022\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435
        \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B. \u041F\u0440\u0438\u0441\u0442\u0443\u043F\u0438\u043C! 
        <br>   \u2022\u0412 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u043C\u0438\u0441\u043A\u0435
        \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435 \u0446\u0435\u043B\u044C\u043D\u043E\u0437\u0435\u0440\u043D\u043E\u0432\u0443\u044E
        \u043C\u0443\u043A\u0443 \u0441 \u0440\u0430\u0437\u0440\u044B\u0445\u043B\u0438\u0442\u0435\u043B\u0435\u043C,
        \u043A\u0430\u043A\u0430\u043E \u0438 \u0441\u0442\u0435\u0432\u0438\u0435\u0439
        (\u0435\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
        \u043F\u043E \u0432\u043A\u0443\u0441\u0443). \u041F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0439\u0442\u0435. 
        <br>   \u2022\u042F\u0439\u0446\u0430 \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u0435
        \u043D\u0430 \u0431\u0435\u043B\u043A\u0438 \u0438 \u0436\u0435\u043B\u0442\u043A\u0438.
        \u041C\u043E\u043B\u043E\u043A\u043E \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435
        \u0432 \u0436\u0435\u043B\u0442\u043A\u0430\u043C\u0438, \u0440\u0430\u0437\u043C\u0435\u0448\u0430\u0439\u0442\u0435. 
        <br>   \u2022\u0411\u0435\u043B\u043A\u0438 \u044F\u0438\u0446 \u0432\u0437\u0431\u0435\u0439\u0442\u0435
        \u0434\u043E \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u0445
        \u043F\u0438\u043A\u043E\u0432.  <br>   \u2022\u0421\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435
        \u0432\u0441\u0435 \u0442\u0440\u0438 \u043C\u0430\u0441\u0441\u044B: \u0441\u043D\u0430\u0447\u0430\u043B\u0430
        \u0432 \u043C\u043E\u043B\u043E\u0447\u043D\u0443\u044E \u0434\u043E\u0431\u0430\u0432\u044C\u0442\u0435
        \u043C\u0443\u0447\u043D\u0443\u044E, \u0445\u043E\u0440\u043E\u0448\u043E
        \u0432\u0435\u043D\u0447\u0438\u043A\u043E\u043C \u0438\u043B\u0438 \u043C\u0438\u043A\u0441\u0435\u0440\u043E\u043C
        \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0439\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
        \u043A\u043E\u043C\u043E\u0447\u043A\u043E\u0432 \u043D\u0435 \u0431\u044B\u043B\u043E,
        \u0430 \u043F\u043E\u0442\u043E\u043C \u0432\u0432\u0435\u0434\u0438\u0442\u0435
        \u0431\u0435\u043B\u043A\u043E\u0432\u0443\u044E.  <br>   \u2022\u0412 \u0441\u0430\u043C\u043E\u043C
        \u043A\u043E\u043D\u0446\u0435 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435
        \u043B\u043E\u0436\u0435\u0447\u043A\u0443 \u043C\u0430\u0441\u043B\u0430.
        \u0422\u0435\u0441\u0442\u043E \u0433\u043E\u0442\u043E\u0432\u043E.  <br>  
        \u2022\u0420\u0430\u0437\u043E\u0433\u0440\u0435\u0439\u0442\u0435 \u0441\u043A\u043E\u0432\u043E\u0440\u043E\u0434\u0443.
        \u041F\u0430\u043D\u043A\u0435\u0439\u043A\u0438 \u0436\u0430\u0440\u044F\u0442
        \u043D\u0430 \u0441\u0443\u0445\u043E\u0439 \u0433\u043E\u0440\u044F\u0447\u0435\u0439
        \u0441\u043A\u043E\u0432\u043E\u0440\u043E\u0434\u0435. \u0421\u0442\u043E\u043B\u043E\u0432\u043E\u0439
        \u043B\u043E\u0436\u043A\u043E\u0439 \u0438\u043B\u0438 \u043F\u043E\u043B\u043E\u0432\u043D\u0438\u043A\u043E\u043C
        \u043D\u0430\u043B\u0435\u0439\u0442\u0435 \u0432 \u0446\u0435\u043D\u0442\u0440
        \u0442\u0435\u0441\u0442\u043E, \u0434\u043E\u0436\u0434\u0438\u0442\u0435\u0441\u044C
        \u043F\u043E\u043A\u0430 \u043E\u043D\u043E \u0441\u0442\u0430\u043D\u0435\u0442
        \u043F\u0443\u0437\u044B\u0440\u0447\u0430\u0442\u044B\u043C. \u041B\u043E\u043F\u0430\u0442\u043A\u043E\u0439
        \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0438\u0442\u0435 \u043D\u0430
        \u0434\u0440\u0443\u0433\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443,
        30 \u0441\u0435\u043A\u0443\u043D\u0434 \u0438 \u0433\u043E\u0442\u043E\u0432\u043E! 
        <br>   \u2022\u0413\u043E\u0442\u043E\u0432\u044B\u0435 \u043F\u0430\u043D\u043A\u0435\u0439\u043A\u0438
        \u043F\u043E\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0441 \u043B\u044E\u0431\u0438\u043C\u044B\u043C\u0438
        \u0434\u0436\u0435\u043C\u0430\u043C\u0438, \u0441\u043E\u0443\u0441\u0430\u043C\u0438
        \u0438\u043B\u0438 \u0441\u0433\u0443\u0449\u0435\u043D\u043D\u044B\u043C
        \u043C\u043E\u043B\u043E\u043A\u043E\u043C! \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E
        \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430!!! "
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>
        <br>   \u2022\u041C\u0443\u043A\u0430 \u0446\u0435\u043B\u044C\u043D\u043E\u0437\u0435\u0440\u043D\u043E\u0432\u0430\u044F 
        \u2014 140 \u0413\u0440\u0430\u043C\u043C  <br>   \u2022\u042F\u0439\u0446\u043E 
        \u2014 2 \u0428\u0442\u0443\u043A\u0438  <br>   \u2022\u041A\u0430\u043A\u0430\u043E
        (\u043F\u043E\u0440\u043E\u0448\u043E\u043A)  \u2014 15 \u0413\u0440\u0430\u043C\u043C 
        <br>   \u2022\u041C\u043E\u043B\u043E\u043A\u043E  \u2014 200 \u041C\u0438\u043B\u043B\u0438\u043B\u0438\u0442\u0440\u043E\u0432 
        <br>   \u2022\u0420\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
        \u043C\u0430\u0441\u043B\u043E  \u2014 1 \u0427\u0430\u0439\u043D\u0430\u044F
        \u043B\u043E\u0436\u043A\u0430  <br>   \u2022\u0420\u0430\u0437\u0440\u044B\u0445\u043B\u0438\u0442\u0435\u043B\u044C
        \u0442\u0435\u0441\u0442\u0430  \u2014 1 \u0427\u0430\u0439\u043D\u0430\u044F
