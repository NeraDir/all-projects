    - FoodImage: {fileID: 21300000, guid: dd3486c9c5f026d419032cf56f998d15, type: 3}
      FoodLabel: "\u041F\u043E\u0434\u0436\u0430\u0440\u0435\u043D\u043D\u0430\u044F
        \u043A\u0430\u0440\u0442\u043E\u0448\u043A\u0430 \u0441 \u043A\u043E\u043F\u0447\u0451\u043D\u044B\u043C
        \u0441\u0430\u043B\u043E\u043C \u0438 \u043F\u0435\u0440\u0446\u0435\u043C
        \u0447\u0438\u043B\u0438"
      FoodHowToCake: " \u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>   
        <br>   \u2022\u041E\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044C,
        \u043F\u043E\u0440\u0435\u0437\u0430\u0442\u044C \u043B\u043E\u043C\u0442\u0438\u043A\u0430\u043C\u0438,
        \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u044C \u043D\u0430 \u0441\u043A\u043E\u0432\u043E\u0440\u043E\u0434\u043A\u0443
        \u043F\u043E\u0434\u043E\u0433\u0440\u0435\u0442\u0443\u044E \u0432 \u043C\u0430\u0441\u043B\u0435.
        <br>   \u2022\u041E\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u043B\u0443\u043A
        \u0440\u0435\u043F\u0447\u0430\u0442\u044B\u0439, \u043F\u043E\u0440\u0435\u0437\u0430\u0442\u044C
        \u043B\u043E\u043C\u0442\u0438\u043A\u0430\u043C\u0438, \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C
        \u0432 \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044C. <br>   \u2022\u041A\u043E\u043F\u0447\u0451\u043D\u043E\u0435
        \u0441\u0430\u043B\u043E \u043F\u043E\u0440\u0435\u0437\u0430\u0442\u044C
        \u043A\u0443\u0441\u043E\u0447\u043A\u0430\u043C\u0438, \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u044C
        \u0432 \u043F\u043E\u0434\u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0435
        \u043C\u0430\u0441\u043B\u043E \u0438 \u0436\u0430\u0440\u0438\u0442\u044C
        \u043C\u0438\u043D 10. <br>   \u2022\u0412\u044B\u043B\u043E\u0436\u0438\u0442\u044C
        \u043F\u043E\u0434\u0436\u0430\u0440\u0435\u043D\u043D\u043E\u0435 \u0441\u0430\u043B\u043E
        \u0432 \u0441\u043A\u043E\u0432\u043E\u0440\u043E\u0434\u043A\u0443 \u0441
        \u043F\u043E\u0434\u0436\u0430\u0440\u0435\u043D\u043D\u044B\u043C \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u0435\u043C,
        \u0438 \u0436\u0430\u0440\u0438\u0442\u044C \u0434\u043E \u0433\u043E\u0442\u043E\u0432\u043A\u0438,
        \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E \u0430\u043F\u043F\u0435\u0442\u0438\u0442\u0430,
        \u043F\u043E \u0432\u043A\u0443\u0441\u0443 \u0441 \u0440\u0430\u0441\u0441\u043E\u043B\u043E\u043C
        \u0438 \u0441\u043E\u043B\u0451\u043D\u044B\u043C\u0438 \u043E\u0433\u0443\u0440\u0446\u0430\u043C\u0438."
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>   
        <br>   \u2022\u041A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044C \u2013
        10-20\u0448\u0442 <br>   \u2022\u0421\u0430\u043B\u043E \u043A\u043E\u043F\u0447\u0435\u043D\u043D\u043E\u0435
        \u2013 50-80 \u0433 <br>   \u2022\u0421\u043E\u043B\u044C \u2013 1 \u0441\u0442.\u043B
        <br>   \u2022\u041B\u0443\u043A \u2013 1 \u0448\u0442 <br>   \u2022\u041C\u0430\u0441\u043B\u043E
        \u043F\u043E\u0434\u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0435
        \u2013 2 \u0441\u0442.\u043B  <br>   \u2022\u0427\u0438\u043B\u0438 \u2013
        \xBD \u0441\u0442.\u043B "
    - FoodImage: {fileID: 21300000, guid: e62a9429c37e31c44ba4f8973348aed8, type: 3}
      FoodLabel: "\u0421\u0432\u0438\u043D\u0438\u043D\u0430 \u0432 \u0438\u043C\u0431\u0438\u0440\u043D\u043E
        \u2013 \u043C\u0435\u0434\u043E\u0432\u043E\u043C \u043C\u0430\u0440\u0438\u043D\u0430\u0434\u0435,
        \u0437\u0430\u043F\u0435\u0447\u0451\u043D\u043D\u0430\u044F \u0441 \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u0435\u043C"
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>   
        <br>   \u2022\u041A\u0443\u0441\u043E\u043A \u043C\u044F\u0441\u0430 \u043F\u043E\u043C\u044B\u0442\u044C,
        \u043E\u0431\u0441\u0443\u0448\u0438\u0442\u044C, \u0441\u0434\u0435\u043B\u0430\u0442\u044C
        \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0434\u0440\u0435\u0437\u043E\u0432,
        \u043F\u043E\u0441\u044B\u043F\u0430\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E
        \u0441\u043E\u043B\u044C\u044E \u0438 \u043F\u0435\u0440\u0446\u0435\u043C.
        \u0427\u0435\u0441\u043D\u043E\u043A \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C
        \u0447\u0435\u0440\u0435\u0437 \u043F\u0440\u0435\u0441\u0441, \u043A\u0443\u0441\u043E\u0447\u0435\u043A
        \u0438\u043C\u0431\u0438\u0440\u044F \u043D\u0430\u0442\u0435\u0440\u0435\u0442\u044C
        \u043D\u0430 \u0442\u0451\u0440\u043A\u0435, \u0432\u044B\u0436\u0430\u0442\u044C
        \u0441\u043E\u043A \u043B\u0438\u043C\u043E\u043D\u0430. \u041F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0442\u044C
        \u0432\u0441\u0435 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B
        \u0434\u043B\u044F \u043C\u0430\u0440\u0438\u043D\u0430\u0434\u0430. \u041D\u0430\u0442\u0435\u0440\u0435\u0442\u044C
        \u043C\u044F\u0441\u043E \u0438 \u043C\u0430\u0440\u0438\u043D\u043E\u0432\u0430\u0442\u044C
        30 \u043C\u0438\u043D\u0443\u0442. <br>   \u2022\u041E\u0447\u0438\u0441\u0442\u0438\u0442\u044C
        \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044C, \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C
        \u043F\u043E\u043F\u043E\u043B\u0430\u043C, \u043F\u043E\u0441\u043E\u043B\u0438\u0442\u044C,
        \u043F\u043E\u043F\u0435\u0440\u0447\u0438\u0442\u044C, \u043F\u043E\u043B\u0438\u0442\u044C
        \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
        \u043C\u0430\u0441\u043B\u043E\u043C, \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0442\u044C.
        \u041A\u0440\u0443\u043F\u043D\u043E \u043D\u0430\u0440\u0435\u0437\u0430\u0442\u044C
        \u043B\u0443\u043A, \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u043A
        \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044E. <br>   \u2022\u041A\u043E\u0433\u0434\u0430
        \u043C\u044F\u0441\u043E \u0437\u0430\u043C\u0430\u0440\u0438\u043D\u0443\u0435\u0442\u0441\u044F,
        \u043C\u0435\u0436\u0434\u0443 \u043D\u0430\u0434\u0440\u0435\u0437\u0430\u043C\u0438
        \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C \u043A\u0443\u0441\u043E\u0447\u043A\u0438
        \u0441\u043B\u0438\u0432\u043E\u0447\u043D\u043E\u0433\u043E \u043C\u0430\u0441\u043B\u0430.
        \u0412 \u0440\u0443\u043A\u0430\u0432 \u043F\u043E\u043C\u0435\u0441\u0442\u0438\u0442\u044C
        \u043C\u044F\u0441\u043E, \u0432\u043E\u043A\u0440\u0443\u0433 \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044C,
        \u0437\u0430\u0432\u044F\u0437\u0430\u0442\u044C \u0440\u0443\u043A\u0430\u0432
        \u0441 \u043E\u0431\u0435\u0438\u0445 \u0441\u0442\u043E\u0440\u043E\u043D.
        \u041F\u0440\u043E\u043A\u043E\u043B\u043E\u0442\u044C \u0440\u0443\u043A\u0430\u0432
        \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445 \u043C\u0435\u0441\u0442\u0430\u0445,
        \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0445\u043E\u0434\u0438\u043B
        \u043F\u0430\u0440. <br>   \u2022\u0412\u044B\u043F\u0435\u043A\u0430\u0442\u044C
        \u0432 \u0434\u0443\u0445\u043E\u0432\u043A\u0435 \u043F\u0440\u0438 200\xB0
        1, 1 \u0447\u0430\u0441\u0430. \u0417\u0430\u0442\u0435\u043C \u0440\u0443\u043A\u0430\u0432
        \u0440\u0430\u0437\u0440\u0435\u0437\u0430\u0442\u044C, \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044C
        \u043F\u043E\u0441\u044B\u043F\u0430\u0442\u044C \u0442\u0451\u0440\u0442\u044B\u043C
        \u0441\u044B\u0440\u043E\u043C \u0438 \u0432\u044B\u043F\u0435\u043A\u0430\u0442\u044C
        \u0435\u0449\u0451 15 \u043C\u0438\u043D\u0443\u0442. \u0413\u043E\u0442\u043E\u0432\u043E\u0435
        \u043C\u044F\u0441\u043E \u0441 \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u0435\u043C
        \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u044C \u043D\u0430 \u0431\u043B\u044E\u0434\u043E,
        \u043F\u043E\u0441\u044B\u043F\u0430\u0442\u044C \u0437\u0435\u043B\u0435\u043D\u044C\u044E. "
      FoodIngredients: "\u041D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F:<br>   
        <br>   \u2022\u0421\u0432\u0438\u043D\u0438\u043D\u0430 \u2013 500 \u0433
        <br>   \u2022\u041A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044C \u2013
        500 \u0433 <br>   \u2022\u041B\u0443\u043A \u2013 1 \u0448\u0442 <br>   \u2022\u0421\u044B\u0440
        \u2013 100 \u0433 <br>   \u2022\u041C\u0430\u0441\u043B\u043E \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
        \u2013 2 \u0441\u0442.\u043B <br>   \u2022\u0421\u043B\u0438\u0432\u043E\u0447\u043D\u043E\u0435
        \u043C\u0430\u0441\u043B\u043E \u2013 25 \u0433 <br>   \u2022\u0421\u043E\u043B\u044C
        \u2013 \u043F\u043E \u0432\u043A\u0443\u0441\u0443  <br>   \u2022\u041F\u0435\u0440\u0435\u0446
        \u2013 \u043F\u043E \u0432\u043A\u0443\u0441\u0443 <br>\u0414\u043B\u044F
        \u043C\u0430\u0440\u0438\u043D\u0430\u0434\u0430  :<br>    <br>   \u2022\u0427\u0435\u0441\u043D\u043E\u043A
        \u2013 2-3 \u0437\u0443\u0431\u0430 <br>   \u2022\u0421\u0432\u0435\u0436\u0438\u0439
        \u0438\u043C\u0431\u0438\u0440\u044C \u2013 20 \u0433 <br>   \u2022\u041C\u0451\u0434
        \u2013 1 \u0447.\u043B <br>   \u2022\u0421\u043E\u0435\u0432\u044B\u0439
        \u0441\u043E\u0443\u0441 \u2013 2 \u0441\u0442.\u043B <br>   \u2022\u041B\u0438\u043C\u043E\u043D\u043D\u044B\u0439
        \u0441\u043E\u043A \u2013 2 \u0441\u0442.\u043B"
    secondFoods:
    - FoodImage: {fileID: 21300000, guid: 668c0199a697ae442b032e6b3afc319e, type: 3}
      FoodLabel: "\u0421\u043B\u043E\u0451\u043D\u043D\u044B\u0435 \u0440\u0443\u043B\u0435\u0442\u0438\u043A\u0438
        \u0441 \u0432\u0435\u0442\u0447\u0438\u043D\u043E\u0439, \u0441\u044B\u0440\u043E\u043C
        \u0438 \u0447\u0435\u0441\u043D\u043E\u043A\u043E\u043C "
      FoodHowToCake: "\u0421\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F:<br>
        <br>   \u2022\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435
        \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B. <br>\u0421\u043B\u043E\u0451\u043D\u043E\u0435
        \u0442\u0435\u0441\u0442\u043E \u0440\u0430\u0437\u043C\u043E\u0440\u043E\u0437\u044C\u0442\u0435
        \u0437\u0430\u0440\u0430\u043D\u0435\u0435 (\u044F \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E
        \u0435\u0433\u043E \u043D\u0430 \u043D\u043E\u0447\u044C \u0432 \u0432\u0435\u0440\u0445\u043D\u0435\u0439
        \u043A\u0430\u043C\u0435\u0440\u0435 \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A\u0430).
        <br>\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0434\u0443\u0445\u043E\u0432\u043A\u0443,
        \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u0430 \u0440\u0430\u0437\u043E\u0433\u0440\u0435\u0432\u0430\u043B\u0430\u0441\u044C
        \u0434\u043E 180 \u0433\u0440\u0430\u0434\u0443\u0441\u043E\u0432. <br>  
        \u2022\u0421\u044B\u0440 \u043D\u0430\u0442\u0440\u0438\u0442\u0435 \u043D\u0430
        \u043A\u0440\u0443\u043F\u043D\u043E\u0439 \u0442\u0451\u0440\u043A\u0435.
        \u0412\u0435\u0442\u0447\u0438\u043D\u0443 \u043C\u0435\u043B\u043A\u043E
        \u043D\u0430\u0440\u0435\u0436\u044C\u0442\u0435. <br>   \u2022\u0420\u0430\u0441\u0442\u043E\u043F\u0438\u0442\u0435
        \u0441\u043B\u0438\u0432\u043E\u0447\u043D\u043E\u0435 \u043C\u0430\u0441\u043B\u043E.
        <br>\u041C\u0435\u043B\u043A\u043E \u043D\u0430\u0440\u0435\u0436\u044C\u0442\u0435
        \u0437\u0435\u043B\u0435\u043D\u044C \u043F\u0435\u0442\u0440\u0443\u0448\u043A\u0438.
        <br>\u041E\u0447\u0438\u0441\u0442\u0438\u0442\u0435 \u0438 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435
        \u0447\u0435\u0440\u0435\u0437 \u043F\u0440\u0435\u0441\u0441 \u0447\u0435\u0441\u043D\u043E\u043A.
        <br>   \u2022\u0412 \u0440\u0430\u0441\u0442\u043E\u043F\u043B\u0435\u043D\u043D\u043E\u0435
        \u043C\u0430\u0441\u043B\u043E \u0434\u043E\u0431\u0430\u0432\u044C\u0442\u0435
        \u043F\u0435\u0442\u0440\u0443\u0448\u043A\u0443, \u0447\u0435\u0441\u043D\u043E\u043A
        \u0438 \u0441\u043E\u043B\u044C. \u0422\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E
        \u0432\u0441\u0451 \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0439\u0442\u0435.
        <br>   \u2022\u041E\u0442\u0440\u0435\u0436\u044C\u0442\u0435 \u043B\u0438\u0441\u0442
        \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0430 \u043F\u043E
        \u0440\u0430\u0437\u043C\u0435\u0440\u0443 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u044F
        - 35\u044530 \u0441\u043C. \u041D\u0430 \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442
        \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u0435 \u0440\u0430\u0437\u043C\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u043E\u0435
        \u0442\u0435\u0441\u0442\u043E \u0438 \u0440\u0430\u0441\u043A\u0430\u0442\u0430\u0439\u0442\u0435
        \u0435\u0433\u043E \u0432 \u043F\u043B\u0430\u0441\u0442 \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C
        \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E 22\u044527 \u0441\u043C,
        \u0434\u043E \u0442\u043E\u043B\u0449\u0438\u043D\u044B \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
        3 \u043C\u043C. <br>   \u2022\u0421\u043C\u0430\u0436\u044C\u0442\u0435 \u0432\u0441\u0451
        \u0442\u0435\u0441\u0442\u043E \u0447\u0435\u0441\u043D\u043E\u0447\u043D\u044B\u043C
        \u043C\u0430\u0441\u043B\u043E\u043C \u0441 \u0437\u0435\u043B\u0435\u043D\u044C\u044E,
        \u043E\u0441\u0442\u0430\u0432\u0438\u0432 \u0441 \u043E\u0434\u043D\u043E\u0439
        \u0438\u0437 \u0434\u043B\u0438\u043D\u043D\u044B\u0445 \u0441\u0442\u043E\u0440\u043E\u043D
        \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0439 \u043A\u0440\u0430\u0439
        (1-2 \u0441\u043C). <br>   \u2022\u041F\u043E\u0432\u0435\u0440\u0445 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u0435
        \u043D\u0430\u0440\u0435\u0437\u0430\u043D\u043D\u0443\u044E \u0432\u0435\u0442\u0447\u0438\u043D\u0443.
        <br>   \u2022\u0420\u0430\u0432\u043D\u043E\u043C\u0435\u0440\u043D\u043E
        \u043F\u043E\u0441\u044B\u043F\u044C\u0442\u0435 \u043D\u0430\u0442\u0451\u0440\u0442\u044B\u043C
        \u0441\u044B\u0440\u043E\u043C. <br>\u041B\u0430\u0434\u043E\u043D\u044F\u043C\u0438
        \u043F\u0440\u0438\u0436\u043C\u0438\u0442\u0435 \u043D\u0430\u0447\u0438\u043D\u043A\u0443
        \u043A \u0442\u0435\u0441\u0442\u0443. <br>   \u2022\u0421\u0432\u0435\u0440\u043D\u0438\u0442\u0435
        \u043F\u043B\u043E\u0442\u043D\u044B\u0439 \u0440\u0443\u043B\u0435\u0442
        \u0432 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438
        \u043A \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u043C\u0443 \u043A\u0440\u0430\u044E
        \u0442\u0435\u0441\u0442\u0430. <br>   \u2022\u0420\u0430\u0437\u0440\u0435\u0436\u044C\u0442\u0435
        \u0440\u0443\u043B\u0435\u0442 \u043D\u0430 \u0448\u0430\u0439\u0431\u043E\u0447\u043A\u0438
        \u0448\u0438\u0440\u0438\u043D\u043E\u0439 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
        2-3 \u0441\u043C. <br>   \u2022\u0420\u0443\u043B\u0435\u0442\u0438\u043A\u0438
        \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u043E\u043C
        \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0438\u0442\u0435 \u043D\u0430
        \u043F\u0440\u043E\u0442\u0438\u0432\u0435\u043D\u044C \u0438 \u0440\u0430\u0437\u043B\u043E\u0436\u0438\u0442\u0435
        \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438
        \u0434\u0440\u0443\u0433 \u043E\u0442 \u0434\u0440\u0443\u0433\u0430. <br>  
        \u2022\u0421\u043C\u0430\u0436\u044C\u0442\u0435 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C
        \u0442\u0435\u0441\u0442\u0430 \u0436\u0435\u043B\u0442\u043A\u043E\u043C,
        \u0441\u0442\u0430\u0440\u0430\u044F\u0441\u044C \u043D\u0435 \u0437\u0430\u0434\u0435\u0442\u044C
        \u043D\u0430\u0447\u0438\u043D\u043A\u0443. <br>   \u2022\u0415\u0441\u043B\u0438
        \u0443 \u0432\u0430\u0441 \u0440\u0443\u043B\u0435\u0442\u0438\u043A\u0438
        \u0442\u043E\u043D\u043A\u0438\u0435 \u0438 \u043D\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
        \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E \u0441\u0442\u043E\u044F\u0442
        \u043D\u0430 \u0431\u043E\u043A\u0443, \u043B\u0443\u0447\u0448\u0435 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C
        \u0438\u0445 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F\u043C\u0438
        \u0432\u043D\u0438\u0437 (\u043A\u0430\u043A \u0441\u0434\u0435\u043B\u0430\u043B\u0430
        \u044F). <br>\u041F\u043E\u043C\u0435\u0441\u0442\u0438\u0442\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u0435\u043D\u044C
        \u0432 \u0440\u0430\u0437\u043E\u0433\u0440\u0435\u0442\u0443\u044E \u0434\u043E
        180 \u0433\u0440\u0430\u0434\u0443\u0441\u043E\u0432 \u0434\u0443\u0445\u043E\u0432\u043A\u0443
        \u0438 \u0432\u044B\u043F\u0435\u043A\u0430\u0439\u0442\u0435 \u0440\u0443\u043B\u0435\u0442\u0438\u043A\u0438
        25-30 \u043C\u0438\u043D\u0443\u0442, \u0434\u043E \u0437\u043E\u043B\u043E\u0442\u0438\u0441\u0442\u043E\u0433\u043E
        \u0446\u0432\u0435\u0442\u0430. <br>   \u2022\u0413\u043E\u0442\u043E\u0432\u044B\u0435
