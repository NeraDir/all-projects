  m_text: "\u0414\u0415\u0419\u0421\u0422\u0412\u0418\u042F:\n1. - \u041E\u0422\u041A\u0420\u042B\u0422\u042C
    \u041A\u041D\u0418\u0413\u0423 \u0418 \u041F\u0420\u041E\u041C\u042B\u0422\u042C
    \u0420\u042B\u0411\u0423\n2. - \u041F\u041E\u0421\u0422\u0410\u0412\u0418\u0422\u042C
